+  }
+
+  // ═════════ RV5-D · stress on the deployed function with a sampler ═════════
+  {
+    let stop = false;
+    let backwards = 0;
+    let samples = 0;
+    let prev = 0;
+    let prevEpoch = -1;
+    let epoch = 0;
+    let resetting = false;
+    const sampler = (async () => {
+      while (!stop) {
+        const e0 = epoch;
+        const busy0 = resetting;
+        const v = await seqNext();
+        if (!busy0 && !resetting && e0 === epoch) {
