+    chk("RV5-CLEAN", fnLeft === 0 && seqLeft === 0 && d.length === 1 && d[0].prosrc === bodyOf(V2),
+      `copies left ${fnLeft} · journal sequences left ${seqLeft} · deployed account_alloc_journal_no still == 000003 file: ${d.length === 1 && d[0].prosrc === bodyOf(V2)}`);
+  });
+}
