+        ? [cashier(H, 0, 300), cashier("account_alloc_journal_no", 200, 1500)]
+        : [cashier(H, 0, 300), cashier("account_alloc_journal_no", 150, 300), cashier("account_alloc_journal_no", 300, 1500)];
