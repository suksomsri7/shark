+  }
+  return s;
+}
+
+/** handcrafted vectors + n fuzz inputs from `seed` */
+export function vectorsAndFuzz(n: number, seed = 0x5a11c0de): string[] {
+  const r = mulberry32(seed);
+  const out = vectors();
+  for (let i = 0; i < n; i++) out.push(fuzzInput(r));
+  return out;
+}
