+// @ts-nocheck
+// exploitable.mts — "would this stored string execute script when rendered via innerHTML?" (finer than the allowlist judge)
+import { tokenize, browserScheme } from "./judge.mts";
+/** exploitable under innerHTML (not merely "not allowlisted"): on* handler on any element · script-capable/foreign/document-level element · srcdoc · javascript:/vbscript:/data: in a URL attribute */
+const BAD_EL = new Set(["script","iframe","frame","object","embed","svg","math","base","meta","link","template","form","button","input","isindex","applet","style"]);
+// real event-handler content attributes (HTML GlobalEventHandlers + WindowEventHandlers + common vendor) — "on\uFFFDload"/"onloaa" are NOT handlers
+const HANDLERS = new Set(("abort auxclick beforeinput beforematch beforetoggle blur cancel canplay canplaythrough change click close contextlost contextmenu contextrestored copy cuechange cut dblclick drag dragend dragenter dragleave dragover dragstart drop durationchange emptied ended error focus focusin focusout formdata input invalid keydown keypress keyup load loadeddata loadedmetadata loadstart mousedown mouseenter mouseleave mousemove mouseout mouseover mouseup paste pause play playing progress ratechange reset resize scroll scrollend securitypolicyviolation seeked seeking select slotchange stalled submit suspend timeupdate toggle volumechange waiting wheel animationstart animationend animationiteration transitionstart transitionend transitionrun transitioncancel pointerdown pointerup pointermove pointerover pointerout pointerenter pointerleave pointercancel gotpointercapture lostpointercapture touchstart touchend touchmove touchcancel afterprint beforeprint beforeunload hashchange languagechange message messageerror offline online pagehide pageshow popstate rejectionhandled storage unhandledrejection unload webkitanimationstart webkitanimationend webkittransitionend selectstart selectionchange contentvisibilityautostatechange search show").split(" ").map((x) => "on" + x));
+const URL_EXEC: Record<string, string[]> = { href: ["a", "area"], src: ["iframe", "frame", "embed", "script"], data: ["object"], action: ["form"], formaction: ["button", "input"] };
+export function exploitable(stored: string): string | null {
+  const { toks, switched } = tokenize(stored);
+  for (const t of toks) {
+    if (t.t !== "start") continue;
+    if (BAD_EL.has(t.name)) return `<${t.name}>`;
+    for (const a of t.attrs) {
+      if (HANDLERS.has(a.name) && a.value.trim()) return `<${t.name} ${a.name}=…>`;
+      const els = URL_EXEC[a.name];
+      if (els && els.includes(t.name)) { const sc = browserScheme(a.value); if (sc === "javascript" || sc === "vbscript" || sc === "data") return `<${t.name} ${a.name}=${sc}:…>`; }
+    }
+  }
+  // RAWTEXT/RCDATA switches (noscript/xmp/title/textarea/noembed/noframes/plaintext) only hide content — not exploitable alone
+  return switched && ["script", "style", "iframe", "svg", "math"].includes(switched) ? `<${switched}>` : null;
+}
