+for (const [s, re] of [[" ", "[\\s]"], ["\t", "[\\s]"], ["s", "^[^\\s]$"], [" ", "^[^\\s]$"], ["\\", "^[^\\s]$"], ["<img x", "<img[\\s/>]"], ["<img\tx", "<img[\\s/>]"], ["<img x", "<img[[:space:]/>]"], ["<a href=\"blob:https://x/1\">", "<[a-z][^\\s>/]*/"], ["x onload=1", "\\son[a-z]+\\s*="], ["<img src=\"java\tscript:x\">", "<(svg|img)[\\s/>]"]] as const) {
