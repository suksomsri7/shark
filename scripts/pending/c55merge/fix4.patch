+    "2 rows", JSON.stringify(a.map((r: Any) => [r.before?.promptpayId, r.after?.promptpayId])));
+  let threw = false;
+  try { await svc.savePaymentProfile({ tenantId: tid, actorUserId: owner }, { promptpayId: "12", displayName: "x" }); } catch { threw = true; }
