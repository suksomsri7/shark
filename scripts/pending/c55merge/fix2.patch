+  let depth = 0;
+  let out = "";
+  for (let i = s + 1; i < e; i++) {
+    const c = code[i];
+    if (!inStr[i] && (c === "{" || c === "[" || c === "(")) { if (depth === 0) out += "{}"; depth++; continue; }
+    if (!inStr[i] && (c === "}" || c === "]" || c === ")")) { depth--; continue; }
