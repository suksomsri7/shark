+function enclosingObject(code, inStr, at) {
+  let depth = 0;
+  let start = -1;
+  for (let i = at; i >= 0; i--) {
+    if (inStr[i]) continue;
+    const c = code[i];
+    if (c === "}") depth++;
+    else if (c === "{") {
+      if (depth === 0) { start = i; break; }
+      depth--;
+    }
+  }
+  if (start < 0) return null;
+  depth = 0;
+  for (let i = start; i < code.length; i++) {
+    if (inStr[i]) continue;
+    const c = code[i];
+    if (c === "{") depth++;
+    else if (c === "}") {
+      depth--;
+      if (depth === 0) return [start, i];
+    }
+  }
+  return null;
