+  const svc = "src/lib/modules/account/service.ts";
+  const newSite = evalTree({ file: svc, src: `${readFileSync(svc, "utf8")}\nexport async function __probe(name: string) { return { where: { name: { equals: name, mode: "insensitive" } } }; }\n` });
