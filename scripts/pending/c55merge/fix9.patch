+  const people = [...ids];
+  const scopeW = { tenantId: c.tenantId, systemId: c.systemId, contactId: { in: people } };
+  const actsAll = await prisma.crmActivity.count({ where: scopeW });
+  const actsSeen = await prisma.crmActivity.count({ where: v.actW });
