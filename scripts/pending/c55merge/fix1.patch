+      const a1 = await withIdempotency(actor, mkReq(k), op, "{}", "req-a1", {}, runA);
+      const e1 = await errOf(a1);
+      const a2 = await withIdempotency(actor, mkReq(k), op, "{}", "req-a2", {}, runA);
+      const e2 = await errOf(a2);
