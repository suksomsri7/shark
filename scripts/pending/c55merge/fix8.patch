+  const g = await ingest(V.email, `Re: grp V`, { dmarc: true, replyTo: pvT });
+  const other = await tReply("E");
+  chk("E.1", stored === 100 && (await bucket(K.msg(pvT))) === 120 && g.handled === true && other.handled === true,
