+  const a = await classOf(() => ingest(`"Buyer" <BUYER@${cDom.toUpperCase()}>`, "Re", { extra: reply(pv) }));
+  const b = await classOf(() => ingest(`buyer+x@${cDom}`, "Re", { extra: reply(pv) }));
