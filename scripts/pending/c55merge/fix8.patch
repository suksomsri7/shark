+    if (!good) posBad += 1;
+    pos.push(`${b || "(none→kanban-read)"}:${good ? `ok(${sc.length})` : errText(r)}`);
+  }
+  chk("K3.2", posBad === 0, `positive: ${pos.join(" · ")}`);
+});
