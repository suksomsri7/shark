+  await clear();
+  let s = 0;
+  const fl = `flood@spam-${rand}.test`;
+  for (let i = 0; i < 102; i += 1) if ((await ingest(i % 2 ? `Flood+${i}@SPAM-${rand}.test` : fl, `u ${i}`, {})).handled) s += 1;
