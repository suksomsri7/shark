+  chk("K1.2", def.v?.ok === true && tick.v?.ok === true && full.v?.ok === true && (fullRow?.scopesJson as string[] | undefined)?.length === (SC.ACCOUNT_SCOPE_KEYS as string[]).length && bOut.every((x) => x.endsWith(":ok")),
