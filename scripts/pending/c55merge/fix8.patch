+  chk("C.1", stored === 300 && (await bucket(K.dom(eDom))) === 320, `4 mailboxes × 80 on one DMARC domain → ${stored}/320 stored (want 300) · domain bucket ${await bucket(K.dom(eDom))}`);
+  await setBucket(K.dom("gmail.com"), 5000);
