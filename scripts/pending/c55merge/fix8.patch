+});
+
+await sub("R3B T system bucket — attacker with 10 provable pairs, P14 unset", async () => {
+  await clear();
+  const att: string[] = [];
+  for (let k = 0; k < 10; k += 1) att.push(`lead${k}-${rand}@anything${k}.test`);
