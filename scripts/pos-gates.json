{
  "$schema": "pos-gates/1",
  "$note": "P2 gate set = the acceptance of 'qc:all เขียว' for POS (brief P2.14 §10 ruling 5). Data only; the runner scripts/pos-gates-all.sh reads this file. Whole-repo qc:all stays one CONTROLLER-RUN on a private Neon branch before deploy (O27).",
  "$owner": "POS RUN controller (oracle P2.14 writes this list; later cards append their qc-pos-* file — G1 of qc-pos-p2.14 fails when a qc-pos-*/qc-hf-* file is missing here)",
  "$modes": "forced = the suite has a SKIP gate (QC_FORCE) and runs with QC_FORCE=1 so a missing piece is red, not skipped · unforced = the suite has no SKIP gate (QC_FORCE has no effect)",
  "$runner": {
    "suite": "forced: bash scripts/iso.sh env QC_FORCE=1 bash scripts/qc4.sh env GATE_LOCK_FILE=/tmp/shark-gate-pos.lock bash scripts/with-gate-lock.sh pnpm exec tsx scripts/<suite>.mts · unforced: the same without env QC_FORCE=1",
    "command": "bash -c <run> from the tree root",
    "out": "/root/pos-runs/p214-close-<tree>-<UTC stamp>/ : HEAD.txt (line 1 = tree=<path> head=<short sha> dirty=<n> <UTC time>) · <name>.log (line 1 = HEAD.txt, last line = EXIT <code>) · SUMMARY.txt (one line '<name> <exit code>' per entry in manifest order, last line DONE)",
    "dry": "--dry prints one line 'PLAN <name> <forced|unforced|command>' per entry in manifest order and runs nothing",
    "rules": "never export CI (with-gate-lock.sh skips flock when CI is set) · unset CI VERCEL at the top · QC4 only via qc4.sh · POS lock /tmp/shark-gate-pos.lock · typecheck on /tmp/pos-gate.lock · absolute paths (systemd-run does not inherit cwd)"
  },
