  "commands": [
    {
      "name": "fitness-noenv",
      "run": "pnpm exec tsx scripts/fitness.mts",
      "why": "X12: fitness without .env"
    },
    {
      "name": "fitness-qc4",
      "run": "bash scripts/iso.sh bash scripts/qc4.sh env GATE_LOCK_FILE=/tmp/shark-gate-pos.lock bash scripts/with-gate-lock.sh pnpm exec tsx scripts/fitness.mts",
      "why": "fitness with the QC4 env"
    },
    {
      "name": "fitness-pos",
      "run": "pnpm exec tsx scripts/fitness-pos.mts",
      "why": "F15.x POS fitness (not a qc-* file, so qc:all never runs it)"
    },
    {
      "name": "gen-check",
      "run": "pnpm exec tsx scripts/gen-pos-api-docs.mts --check",
      "why": "docs/api/POS-API.md + skill endpoints in sync with the registry"
    },
    {
      "name": "typecheck",
      "run": "env NODE_OPTIONS=--max-old-space-size=8192 ISO_MEM=10500M bash scripts/iso.sh flock -w 3600 /tmp/pos-gate.lock pnpm typecheck",
      "why": "heap 8192 / ISO_MEM 10500M since P2.7 (3584 default and 5632 OOM)"
    },
    {
      "name": "visual-list",
      "run": "pnpm exec tsx scripts/visual-pos.mts --list",
      "why": "state ids of the visual harness (no DB, no server)"
    },
    {
      "name": "visual-dry-th",
      "run": "pnpm exec tsx scripts/visual-pos.mts all --states --dry --user owner",
      "why": "shot plan th (no DB, no server, no chromium)"
    },
    {
      "name": "visual-dry-en",
      "run": "env LOCALE=en pnpm exec tsx scripts/visual-pos.mts all --states --dry --user owner",
      "why": "shot plan en (LOCALE inside the command, never before iso.sh)"
    }
  ]
