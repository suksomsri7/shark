// ─────────────────────────────────────────────────────────────
// เลขา AI (SECRETARY RUN · S1.1 migration `secretary_a`)
// สัญญา: ledger/secretary-briefs/sec-brief-S1.1.md + sec-brief-RESOLUTIONS.md (R-K1 R-K2 R-K5 R-K9/K10 R-K11 R-K12 R-K20 §B.1 §B.4 §B.8)
// additive ล้วน · core.prisma FROZEN (ไม่มี User.phone → ตาราง UserPhone)
//
// 🔴 FK ที่เขียนมือใน migration.sql (ไม่มี relation ใน Prisma เพราะ User อยู่ใน core.prisma FROZEN):
//    AiSecretary.userId → User (Cascade) · UserPhone.userId → User (Cascade)
//    ⇒ `prisma migrate diff` (DB → schema) จะเสนอ DROP CONSTRAINT 2 ตัวนี้เสมอ — migration ถัดไปต้องตัดทิ้ง ห้ามลบ FK
//    (ChatConversationHelper.conversationId → ChatConversation เป็น relation ปกติแล้ว · back-relation `helpers` 1 บรรทัดใน chat.prisma)
//
// แกน scope (src/lib/core/scope.ts · §B.1): global = AiSecretary UserPhone PhoneOtp AiNotifyPref · ที่เหลือ tenant
// ─────────────────────────────────────────────────────────────

// ── แกน tenant ──

// ห้องเลขา 1 ห้อง = AiConversation 1 ห้อง (รหัสห้องยังเป็นแหล่งความจริงของ "ผู้สร้าง" · R-K1)
model AiRoom {
  id             String         @id @default(cuid())
  conversationId String         @unique
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId       String
  startedById    String // denormalize = conversationCreatorOf(conversationId).id (ข้อสอบ S1.4 ตรวจ)
  title          String
  closedAt       DateTime?
  systems        String[]       @default([]) // ระบบที่ห้องนี้แตะ (chip ในรายการห้อง)
  contextJson    Json? // { chatConversationId, contactId } สำหรับห้องที่เปิดจากแชทลูกค้า (S1.22)
  jobsCounted    Int            @default(1) // นับงานที่ startRoom (R-K6) — สั่งเพิ่มในห้องเดิมไม่นับ
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members AiRoomMember[]
  jobs    AiRoomJob[]

  @@index([tenantId, startedById, updatedAt])
  @@index([tenantId, closedAt])
}

// สมาชิกห้อง (นอกจากผู้สร้าง) · seeHistory=false ⇒ ไม่เห็นข้อความก่อน addedAt (บังคับใน listMessages)
model AiRoomMember {
  id         String   @id @default(cuid())
  tenantId   String
  roomId     String
  room       AiRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  addedById  String
  addedAt    DateTime @default(now())
  seeHistory Boolean  @default(false)

  @@unique([roomId, userId])
  @@index([userId])
}

// งานของห้อง 1 แถวต่อข้อความสั่งงาน (R-K8: รันใน request + after() · runRoomJobs เก็บตกเมื่อ lease หมด)
model AiRoomJob {
  id           String    @id @default(cuid())
  tenantId     String
  roomId       String
  room         AiRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messageId    String    @unique // AiMessage.id ของข้อความสั่งงาน
  authorUserId String?
  status       String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  leaseUntil   DateTime?
  attempts     Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, leaseUntil])
  @@index([roomId, createdAt])
}

// ระดับสิทธิ์ของเลขาต่อระบบของร้าน (ไม่มี AUTO ในรุ่นนี้ · มติ 5)
model AiSystemAccess {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  level     String   @default("DRAFT") // OFF | READ | DRAFT
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, module])
}

// กฎอนุมัติที่ตั้งค่าได้ 3 ตัว (R-K3) — ALWAYS_APPROVE เป็นค่าคงที่ในโค้ด ไม่อยู่ในตารางนี้
model AiApprovalRule {
  id          String   @id @default(cuid())
  tenantId    String
  key         String // chat.send | money.limit | pii.export
  enabled     Boolean  @default(true)
  limitSatang Int? // ใช้กับ money.limit
  setById     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
}

// บันทึกสิ่งที่เลขาทำจริง (ลิงก์ของจริง + ย้อนกลับ) · payload = id ล้วน ห้าม PII
model AiActionLog {
  id            String    @id @default(cuid())
  tenantId      String
  roomId        String?
  userId        String
  approverId    String?
  module        String
  kind          String
  summary       String
  payload       Json
  proposalId    String?
  entityType    String?
  entityId      String?
  undoableUntil DateTime?
  undoneAt      DateTime?
  undoneById    String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([roomId])
  @@index([proposalId])
}

// ตัวนับงานรายเดือน (เดือนตามเวลาไทย "YYYY-MM" จาก monthKeyBangkok) · เพิ่มด้วยคำสั่งเดียว
model AiJobCounter {
  id        String   @id @default(cuid())
  tenantId  String
  month     String
  jobs      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month])
}

// บทเรียนจากผลที่ยืนยันแล้ว (design §8) · ใส่ใน prompt เฉพาะ CONFIRMED · ห้ามเก็บชื่อ/เบอร์/ที่อยู่ลูกค้า
model AiLesson {
  id            String   @id @default(cuid())
  tenantId      String
  kind          String
  pattern       String
  example       String
  status        String   @default("PENDING") // PENDING | CONFIRMED | REJECTED
  occurrences   Int      @default(1)
  sourceRoomId  String?
  sourceUserId  String
  confirmedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, kind, status])
}

// คำเชิญพนักงาน (R-K11) — ยังไม่สร้าง Membership จนกว่าจะรับ
model StaffInvite {
  id             String    @id @default(cuid())
  tenantId       String
  phone          String // E.164
  name           String
  role           String // MANAGER | STAFF
  unitAccess     Json      @default("[]")
  permissions    Json      @default("{}")
  codeHash       String    @unique
  expiresAt      DateTime // 7 วัน
  acceptedAt     DateTime?
  acceptedUserId String?
  invitedById    String
  createdAt      DateTime  @default(now())

  @@index([tenantId, phone])
  @@index([tenantId, acceptedAt])
}

// กติกาแจกแชทลูกค้า (S1.24)
model ChatRoutingRule {
  id        String   @id @default(cuid())
  tenantId  String
  systemId  String
  channel   String?
  mode      String // ROUND_ROBIN | LAST_ASSIGNEE | OWNER
  enabled   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, systemId, enabled, order])
}

// กะของพนักงานตอบแชท (offDutyAt = null ⇒ อยู่ในกะ)
model ChatShift {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  onDutyAt  DateTime
  offDutyAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, offDutyAt])
}

// ผู้ช่วย/ส่งต่อห้องแชทลูกค้า (R-K14) · FK → ChatConversation (Cascade)
model ChatConversationHelper {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  calledById     String
  note           String?
  createdAt      DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// ── แกน global (ผูก user ไม่ผูกร้าน · แบบ PushDevice) ──

// บุคลิกเลขาของแต่ละคน · FK → User (Cascade) เขียนมือใน migration (core.prisma FROZEN)
model AiSecretary {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("Shark")
  suffix    String   @default("ครับ")
  tone      String   @default("polite")
  languages String[] @default(["th"])
  prefs     Json     @default("{}") // ค่าปรับแต่งล้วน ห้าม PII
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// เบอร์โทรของ user (R-K9/K10 · แทน User.phone) · FK → User (Cascade) เขียนมือใน migration
model UserPhone {
  id         String    @id @default(cuid())
  userId     String    @unique
  phone      String    @unique // E.164
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// OTP ทาง SMS (R-K9) — สร้างก่อนรู้ user/tenant · เก็บแค่ hash
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// การตั้งค่าแจ้งเตือนต่อคน (R-K20) · tenantId = null ⇒ ค่าทุกร้าน
model AiNotifyPref {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  kind      String // inbox | approval | room | help
  mode      String // ALL | ASSIGNED | OFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId, kind])
}
