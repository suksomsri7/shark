// Kanban (บอร์ดงานภายในองค์กร คล้าย Trello) — scope = feature: ทุกตารางมี tenantId + systemId
// ระบบ Kanban 1 ชุด (AppSystem type KANBAN) มีได้หลายบอร์ด → คอลัมน์ → การ์ด
// P1 minimal: board/column/card + assignee (User ใน tenant) + labels + dueAt + ย้ายคอลัมน์
// Defer (P2): real-time SSE, drag-drop, checklist/comment ในการ์ด, WIP limit, members/roles

enum KanbanEntityStatus {
  ACTIVE
  ARCHIVED
}

// ระดับการมองเห็นบอร์ด (D2) — PRIVATE = เฉพาะสมาชิกบอร์ด · TENANT = ทุกคนในร้านที่มีสิทธิ์โมดูล
// 🔴 default = PRIVATE (บอร์ดใหม่ปิดก่อน) · บอร์ดที่มีอยู่ก่อน K1.1 ถูก backfill เป็น TENANT
//    เพื่อไม่ให้คนที่เคยเห็นอยู่หลุดสิทธิ์กะทันหันตอน deploy
enum KanbanBoardVisibility {
  PRIVATE
  TENANT
}

// บทบาทของคนในบอร์ด (ชั้นที่ 2 ของสิทธิ์ · K1.3 · D2) — ชั้นที่ 1 คือ RBAC ของ SHARK (core/rbac.ts)
// เรียงจากอำนาจน้อยไปมาก: VIEWER (อ่าน) < EDITOR (การ์ด/เช็คลิสต์/ความเห็น) < ADMIN (ตั้งค่าบอร์ด+สมาชิก)
enum KanbanBoardRole {
  VIEWER
  EDITOR
  ADMIN
}

// สีป้าย/บอร์ด 6 สี ตรงกับโทเคน `--color-tag-*` ของดีไซน์ (D9)
enum KanbanLabelColor {
  SLATE
  BLUE
  GREEN
  AMBER
  RED
  PURPLE
}

// ที่มาของการ์ด — MANUAL = คนสร้างเอง · ที่เหลือมาจากเทมเพลต/แชท/ฟอร์ม/อีเมล/กฎอัตโนมัติ/AI (P2–P3)
enum KanbanCardSourceType {
  MANUAL
  TEMPLATE
  CHAT
  FORM
  EMAIL
  AUTOMATION
  AI
}

// ───────────────────────── Board ─────────────────────────
model KanbanBoard {
  id          String             @id @default(cuid())
  tenantId    String
  systemId    String // ระบบ Kanban ไหน (AppSystem.id)
  name        String
  description String?
  sortOrder   Int                @default(0)
  status      KanbanEntityStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // ── K1.1 (เพิ่มอย่างเดียว · nullable หรือมี default ทุกตัว) ──
  unitId       String? // BusinessUnit.id — ผูกสาขา (metadata · ใช้คิดสิทธิ์ MANAGER ใน K1.3)
  color        KanbanLabelColor      @default(SLATE)
  visibility   KanbanBoardVisibility @default(PRIVATE)
  cardNoSeq    Int                   @default(0) // เลขการ์ดวิ่งต่อบอร์ด "#128" (UPDATE…RETURNING ใน tx — D14)
  createdById  String? // User.id ผู้สร้าง
  templateOfId String? // สร้างมาจากเทมเพลตไหน (K1.12)

  columns KanbanColumn[]
  cards   KanbanCard[]
  labels  KanbanLabel[] // ป้ายของบอร์ด (K1.2)
  members KanbanBoardMember[] // คนที่ถูกเชิญเข้าบอร์ด (K1.3)
  stars   KanbanBoardStar[] // ดาวรายคน (K1.3)

  @@index([tenantId, systemId, status])
  @@index([tenantId, systemId, unitId])
}

// ───────────────────────── Column ─────────────────────────
model KanbanColumn {
  id         String             @id @default(cuid())
  tenantId   String
  systemId   String
  boardId    String
  board      KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int                @default(0)
  status     KanbanEntityStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // ── K1.1 ──
  // position = fractional index (base62) ตาม docs/modules/13-kanban.md §11.1
  // nullable ระหว่างเปลี่ยนผ่าน: แถวเก่ายังไม่มีค่าจนกว่า backfill จะรัน → โค้ดอ่าน `position ?? sortOrder` (D10)
  position     String?
  isDoneColumn Boolean           @default(false)
  wipLimit     Int? // null = ไม่จำกัด
  color        KanbanLabelColor?

  cards KanbanCard[]

  @@index([tenantId, systemId, boardId])
  @@index([boardId, status, sortOrder])
}

// ───────────────────────── Card ─────────────────────────
model KanbanCard {
  id             String             @id @default(cuid())
  tenantId       String
  systemId       String
  boardId        String
  board          KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId       String
  column         KanbanColumn       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeUserId String? // User.id (ต้องเป็น Membership ของ tenant — ตรวจใน service)
  labels         Json               @default("[]") // string[] เช่น ["ด่วน","ลูกค้า"]
  dueAt          DateTime? // UTC
  sortOrder      Int                @default(0)
  status         KanbanEntityStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // ── K1.1 ──
  cardNo                Int? // เลขการ์ดในบอร์ด "#42" — nullable จนกว่า backfill เสร็จ · @@unique([boardId,cardNo]) เพิ่มใน K1.4
  position              String? // fractional index ภายในคอลัมน์ (§11.1)
  startAt               DateTime?
  completedAt           DateTime? // ตั้งเมื่อย้ายเข้า done column (K1.4)
  reminderMinutesBefore Int? // null = ไม่เตือน
  reminderSentAt        DateTime?
  coverFileId           String? // FileAsset.id (K1.9)
  sourceType            KanbanCardSourceType @default(MANUAL)
  sourceId              String?
  createdById           String?
  archivedById          String?

  // ── K1.2 ──
  cardLabels KanbanCardLabel[]
  assignees  KanbanCardAssignee[]

  @@index([tenantId, systemId, boardId, status])
  @@index([columnId, status, sortOrder])
  @@index([tenantId, systemId, assigneeUserId])
  @@index([tenantId, systemId, status, dueAt]) // cron เตือนกำหนดส่ง + รายงานเลยกำหนด
  // 🔴 K1.4: เลขการ์ดห้ามซ้ำในบอร์ดเดียวกัน — ด่านสุดท้ายของ D14 (`cardNoSeq` UPDATE…RETURNING)
  //    ถ้าวันหน้ามีใครเขียน "อ่านเลขล่าสุดแล้ว +1" กลับเข้ามา DB จะปฏิเสธให้เห็นทันที ไม่ใช่เงียบ ๆ แล้วเลขซ้ำ
  //    (NULL ซ้ำได้ตามมาตรฐาน Postgres ⇒ การ์ดเก่าที่ยังไม่ backfill ไม่ติดด่านนี้)
  @@unique([boardId, cardNo])
  @@index([boardId, cardNo]) // ค้นด้วยเลขการ์ด (คงไว้จาก K1.1 — unique ข้างบนเพิ่มใน K1.4 ไม่ทับของเดิม)
}

// ───────────────────────── ป้ายกำกับ (K1.2) ─────────────────────────
// ป้ายเป็น "ของบอร์ด" (ไม่ใช่ของร้าน) — ชื่อซ้ำในบอร์ดเดียวกันไม่ได้ แต่คนละบอร์ดตั้งชื่อเหมือนกันได้
// ช่วงเปลี่ยนผ่าน P1: `KanbanCard.labels` (Json ชื่อป้าย) ยังถูกเขียนคู่กันไว้อ่านอย่างเดียว (§4.6 ข้อ 4)
model KanbanLabel {
  id        String           @id @default(cuid())
  tenantId  String
  systemId  String
  boardId   String
  board     KanbanBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String // ≤ 40 ตัวอักษร (ตรวจใน service)
  color     KanbanLabelColor
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  cards KanbanCardLabel[]

  @@unique([boardId, name])
  @@index([tenantId, systemId, boardId])
}

// join การ์ด × ป้าย — hard delete ได้ (ตาราง join · §11 "ไม่มี soft delete ยกเว้น…")
// tenantId เก็บซ้ำเพื่อกวาด/ตรวจข้ามร้านได้โดยไม่ต้อง join กลับการ์ด
model KanbanCardLabel {
  cardId   String
  card     KanbanCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId  String
  label    KanbanLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  tenantId String

  @@id([cardId, labelId])
  @@index([labelId])
}

// ผู้รับผิดชอบหลายคนต่อการ์ด — `KanbanCard.assigneeUserId` = คนแรกของลิสต์ (เขียนคู่กันตลอด P1 · §4.6 ข้อ 5)
// index [tenantId, userId] = เส้นทางของหน้า "งานของฉัน" (ยังไม่ต้องมี systemId ในตาราง — กรอง systemId ที่การ์ด)
model KanbanCardAssignee {
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId       String // ต้องเป็น Membership ที่ accepted ของ tenant — ตรวจใน service (ไม่ทำ FK ไป User)
  tenantId     String
  assignedById String? // ใครเป็นคนมอบหมาย
  assignedAt   DateTime   @default(now())

  @@id([cardId, userId])
  @@index([tenantId, userId])
}

// ───────────────────────── สมาชิกบอร์ด + ดาว (K1.3) ─────────────────────────
// สมาชิกบอร์ด = "คำเชิญที่ประกาศไว้ชัด" — คนละเรื่องกับสิทธิ์โดยนัย (OWNER ทุกบอร์ด · MANAGER สาขาตัวเอง
// · บอร์ด TENANT ทุกคนอ่านได้) ที่คิดในโค้ด `access.ts` ไม่เก็บเป็นแถว ⇒ เปลี่ยนบทบาทในร้าน/ย้ายสาขา
// แล้วสิทธิ์บอร์ดตามทันทีโดยไม่ต้อง backfill
//
// ไม่มี `systemId`: บอร์ดรู้ระบบของตัวเองอยู่แล้ว (กรอง systemId ที่บอร์ดต้นทาง) — แกนใน scope.ts
// จึงเป็น tenant ให้ตรงกับคอลัมน์จริง (บทเรียนเดียวกับ KanbanCardLabel/KanbanCardAssignee ใน K1.2)
model KanbanBoardMember {
  id          String          @id @default(cuid())
  tenantId    String
  boardId     String
  board       KanbanBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId      String // ต้องเป็น Membership ที่ accepted ของ tenant — ตรวจใน service (ไม่ทำ FK ไป User)
  role        KanbanBoardRole @default(EDITOR)
  invitedById String? // User.id ของคนที่เชิญ
  createdAt   DateTime        @default(now())

  @@unique([boardId, userId])
  @@index([tenantId, userId])
}

// ติดดาว = ของส่วนตัวรายคน (บอร์ดที่ปักไว้บนสุดของหน้ารวมบอร์ด) — ไม่ให้สิทธิ์อะไรทั้งสิ้น
// คีย์รวม [boardId,userId] ⇒ ติดดาวซ้ำเป็น no-op โดยธรรมชาติ (upsert)
model KanbanBoardStar {
  boardId   String
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  tenantId  String
  createdAt DateTime    @default(now())

  @@id([boardId, userId])
  @@index([tenantId, userId])
}
