// Kanban (บอร์ดงานภายในองค์กร คล้าย Trello) — scope = feature: ทุกตารางมี tenantId + systemId
// ระบบ Kanban 1 ชุด (AppSystem type KANBAN) มีได้หลายบอร์ด → คอลัมน์ → การ์ด
// P1 minimal: board/column/card + assignee (User ใน tenant) + labels + dueAt + ย้ายคอลัมน์
// Defer (P2): real-time SSE, drag-drop, checklist/comment ในการ์ด, WIP limit, members/roles

enum KanbanEntityStatus {
  ACTIVE
  ARCHIVED
}

// ระดับการมองเห็นบอร์ด (D2) — PRIVATE = เฉพาะสมาชิกบอร์ด · TENANT = ทุกคนในร้านที่มีสิทธิ์โมดูล
// 🔴 default = PRIVATE (บอร์ดใหม่ปิดก่อน) · บอร์ดที่มีอยู่ก่อน K1.1 ถูก backfill เป็น TENANT
//    เพื่อไม่ให้คนที่เคยเห็นอยู่หลุดสิทธิ์กะทันหันตอน deploy
enum KanbanBoardVisibility {
  PRIVATE
  TENANT
}

// บทบาทของคนในบอร์ด (ชั้นที่ 2 ของสิทธิ์ · K1.3 · D2) — ชั้นที่ 1 คือ RBAC ของ SHARK (core/rbac.ts)
// เรียงจากอำนาจน้อยไปมาก: VIEWER (อ่าน) < EDITOR (การ์ด/เช็คลิสต์/ความเห็น) < ADMIN (ตั้งค่าบอร์ด+สมาชิก)
enum KanbanBoardRole {
  VIEWER
  EDITOR
  ADMIN
}

// สีป้าย/บอร์ด 6 สี ตรงกับโทเคน `--color-tag-*` ของดีไซน์ (D9)
enum KanbanLabelColor {
  SLATE
  BLUE
  GREEN
  AMBER
  RED
  PURPLE
}

// ที่มาของการ์ด — MANUAL = คนสร้างเอง · ที่เหลือมาจากเทมเพลต/แชท/ฟอร์ม/อีเมล/กฎอัตโนมัติ/AI (P2–P3)
enum KanbanCardSourceType {
  MANUAL
  TEMPLATE
  CHAT
  FORM
  EMAIL
  AUTOMATION
  AI
}

// ───────────────────────── Board ─────────────────────────
model KanbanBoard {
  id          String             @id @default(cuid())
  tenantId    String
  systemId    String // ระบบ Kanban ไหน (AppSystem.id)
  name        String
  description String?
  sortOrder   Int                @default(0)
  status      KanbanEntityStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // ── K1.1 (เพิ่มอย่างเดียว · nullable หรือมี default ทุกตัว) ──
  unitId       String? // BusinessUnit.id — ผูกสาขา (metadata · ใช้คิดสิทธิ์ MANAGER ใน K1.3)
  color        KanbanLabelColor      @default(SLATE)
  visibility   KanbanBoardVisibility @default(PRIVATE)
  cardNoSeq    Int                   @default(0) // เลขการ์ดวิ่งต่อบอร์ด "#128" (UPDATE…RETURNING ใน tx — D14)
  createdById  String? // User.id ผู้สร้าง
  templateOfId String? // สร้างมาจากเทมเพลตไหน (K1.12)

  columns KanbanColumn[]
  cards   KanbanCard[]
  labels  KanbanLabel[] // ป้ายของบอร์ด (K1.2)
  members KanbanBoardMember[] // คนที่ถูกเชิญเข้าบอร์ด (K1.3)
  stars   KanbanBoardStar[] // ดาวรายคน (K1.3)
  activities KanbanActivity[] // ประวัติกิจกรรม (K1.10)

  @@index([tenantId, systemId, status])
  @@index([tenantId, systemId, unitId])
}

// ───────────────────────── Column ─────────────────────────
model KanbanColumn {
  id         String             @id @default(cuid())
  tenantId   String
  systemId   String
  boardId    String
  board      KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int                @default(0)
  status     KanbanEntityStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // ── K1.1 ──
  // position = fractional index (base62) ตาม docs/modules/13-kanban.md §11.1
  // nullable ระหว่างเปลี่ยนผ่าน: แถวเก่ายังไม่มีค่าจนกว่า backfill จะรัน → โค้ดอ่าน `position ?? sortOrder` (D10)
  position     String?
  isDoneColumn Boolean           @default(false)
  wipLimit     Int? // null = ไม่จำกัด
  color        KanbanLabelColor?

  cards KanbanCard[]

  @@index([tenantId, systemId, boardId])
  @@index([boardId, status, sortOrder])
}

// ───────────────────────── Card ─────────────────────────
model KanbanCard {
  id             String             @id @default(cuid())
  tenantId       String
  systemId       String
  boardId        String
  board          KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId       String
  column         KanbanColumn       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeUserId String? // User.id (ต้องเป็น Membership ของ tenant — ตรวจใน service)
  labels         Json               @default("[]") // string[] เช่น ["ด่วน","ลูกค้า"]
  dueAt          DateTime? // UTC
  sortOrder      Int                @default(0)
  status         KanbanEntityStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // ── K1.1 ──
  cardNo                Int? // เลขการ์ดในบอร์ด "#42" — nullable จนกว่า backfill เสร็จ · @@unique([boardId,cardNo]) เพิ่มใน K1.4
  position              String? // fractional index ภายในคอลัมน์ (§11.1)
  startAt               DateTime?
  completedAt           DateTime? // ตั้งเมื่อย้ายเข้า done column (K1.4)
  reminderMinutesBefore Int? // null = ไม่เตือน
  reminderSentAt        DateTime?
  coverFileId           String? // FileAsset.id (K1.9)
  sourceType            KanbanCardSourceType @default(MANUAL)
  sourceId              String?
  createdById           String?
  archivedById          String?

  // ── K1.2 ──
  cardLabels KanbanCardLabel[]
  assignees  KanbanCardAssignee[]

  // ── K1.7 ──
  checklists KanbanChecklist[]

  // ── K1.8 ──
  comments KanbanComment[]

  // ── K1.9 ──
  attachments KanbanAttachment[]

  // ── K1.10 ──
  activities KanbanActivity[]

  @@index([tenantId, systemId, boardId, status])
  @@index([columnId, status, sortOrder])
  @@index([tenantId, systemId, assigneeUserId])
  @@index([tenantId, systemId, status, dueAt]) // cron เตือนกำหนดส่ง + รายงานเลยกำหนด
  // 🔴 K1.4: เลขการ์ดห้ามซ้ำในบอร์ดเดียวกัน — ด่านสุดท้ายของ D14 (`cardNoSeq` UPDATE…RETURNING)
  //    ถ้าวันหน้ามีใครเขียน "อ่านเลขล่าสุดแล้ว +1" กลับเข้ามา DB จะปฏิเสธให้เห็นทันที ไม่ใช่เงียบ ๆ แล้วเลขซ้ำ
  //    (NULL ซ้ำได้ตามมาตรฐาน Postgres ⇒ การ์ดเก่าที่ยังไม่ backfill ไม่ติดด่านนี้)
  @@unique([boardId, cardNo])
  @@index([boardId, cardNo]) // ค้นด้วยเลขการ์ด (คงไว้จาก K1.1 — unique ข้างบนเพิ่มใน K1.4 ไม่ทับของเดิม)
}

// ───────────────────────── ป้ายกำกับ (K1.2) ─────────────────────────
// ป้ายเป็น "ของบอร์ด" (ไม่ใช่ของร้าน) — ชื่อซ้ำในบอร์ดเดียวกันไม่ได้ แต่คนละบอร์ดตั้งชื่อเหมือนกันได้
// ช่วงเปลี่ยนผ่าน P1: `KanbanCard.labels` (Json ชื่อป้าย) ยังถูกเขียนคู่กันไว้อ่านอย่างเดียว (§4.6 ข้อ 4)
model KanbanLabel {
  id        String           @id @default(cuid())
  tenantId  String
  systemId  String
  boardId   String
  board     KanbanBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String // ≤ 40 ตัวอักษร (ตรวจใน service)
  color     KanbanLabelColor
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  cards KanbanCardLabel[]

  @@unique([boardId, name])
  @@index([tenantId, systemId, boardId])
}

// join การ์ด × ป้าย — hard delete ได้ (ตาราง join · §11 "ไม่มี soft delete ยกเว้น…")
// tenantId เก็บซ้ำเพื่อกวาด/ตรวจข้ามร้านได้โดยไม่ต้อง join กลับการ์ด
model KanbanCardLabel {
  cardId   String
  card     KanbanCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId  String
  label    KanbanLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  tenantId String

  @@id([cardId, labelId])
  @@index([labelId])
}

// ผู้รับผิดชอบหลายคนต่อการ์ด — `KanbanCard.assigneeUserId` = คนแรกของลิสต์ (เขียนคู่กันตลอด P1 · §4.6 ข้อ 5)
// index [tenantId, userId] = เส้นทางของหน้า "งานของฉัน" (ยังไม่ต้องมี systemId ในตาราง — กรอง systemId ที่การ์ด)
model KanbanCardAssignee {
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId       String // ต้องเป็น Membership ที่ accepted ของ tenant — ตรวจใน service (ไม่ทำ FK ไป User)
  tenantId     String
  assignedById String? // ใครเป็นคนมอบหมาย
  assignedAt   DateTime   @default(now())

  @@id([cardId, userId])
  @@index([tenantId, userId])
}

// ───────────────────────── สมาชิกบอร์ด + ดาว (K1.3) ─────────────────────────
// สมาชิกบอร์ด = "คำเชิญที่ประกาศไว้ชัด" — คนละเรื่องกับสิทธิ์โดยนัย (OWNER ทุกบอร์ด · MANAGER สาขาตัวเอง
// · บอร์ด TENANT ทุกคนอ่านได้) ที่คิดในโค้ด `access.ts` ไม่เก็บเป็นแถว ⇒ เปลี่ยนบทบาทในร้าน/ย้ายสาขา
// แล้วสิทธิ์บอร์ดตามทันทีโดยไม่ต้อง backfill
//
// ไม่มี `systemId`: บอร์ดรู้ระบบของตัวเองอยู่แล้ว (กรอง systemId ที่บอร์ดต้นทาง) — แกนใน scope.ts
// จึงเป็น tenant ให้ตรงกับคอลัมน์จริง (บทเรียนเดียวกับ KanbanCardLabel/KanbanCardAssignee ใน K1.2)
model KanbanBoardMember {
  id          String          @id @default(cuid())
  tenantId    String
  boardId     String
  board       KanbanBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId      String // ต้องเป็น Membership ที่ accepted ของ tenant — ตรวจใน service (ไม่ทำ FK ไป User)
  role        KanbanBoardRole @default(EDITOR)
  invitedById String? // User.id ของคนที่เชิญ
  createdAt   DateTime        @default(now())

  @@unique([boardId, userId])
  @@index([tenantId, userId])
}

// ติดดาว = ของส่วนตัวรายคน (บอร์ดที่ปักไว้บนสุดของหน้ารวมบอร์ด) — ไม่ให้สิทธิ์อะไรทั้งสิ้น
// คีย์รวม [boardId,userId] ⇒ ติดดาวซ้ำเป็น no-op โดยธรรมชาติ (upsert)
model KanbanBoardStar {
  boardId   String
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  tenantId  String
  createdAt DateTime    @default(now())

  @@id([boardId, userId])
  @@index([tenantId, userId])
}

// ───────────────────────── เช็คลิสต์ (K1.7 · KANBAN-RUN §K1.7) ─────────────────────────
// หลายชุดต่อการ์ด (KanbanChecklist) · แต่ละชุดมีหลายรายการ มอบหมาย/กำหนดส่งได้รายรายการ (KanbanChecklistItem)
// ไม่มี `systemId`: การ์ดต้นทางรู้ระบบของตัวเองอยู่แล้ว (เหตุผลเดียวกับ KanbanCardLabel/KanbanBoardMember ใน K1.2/K1.3)
// position = fractional index — ตารางใหม่จึงไม่ต้อง nullable แบบ K1.1 (ไม่มีข้อมูลเก่าให้เปลี่ยนผ่าน)
model KanbanChecklist {
  id        String     @id @default(cuid())
  tenantId  String
  cardId    String
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  position  String
  createdAt DateTime   @default(now())

  items KanbanChecklistItem[]

  @@index([cardId])
}

// รายการในเช็คลิสต์ — มอบหมาย/กำหนดวันได้รายตัว (ต่างจากการ์ดที่มีผู้รับผิดชอบ/กำหนดส่งระดับใบเดียว)
// assigneeUserId ไม่ทำ FK ไป User (เหมือน KanbanCardAssignee) — ตรวจ Membership accepted ใน service
model KanbanChecklistItem {
  id             String          @id @default(cuid())
  tenantId       String
  checklistId    String
  checklist      KanbanChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text           String
  done           Boolean         @default(false)
  position       String
  assigneeUserId String?
  dueAt          DateTime?
  doneAt         DateTime?
  doneById       String?
  createdAt      DateTime        @default(now())

  // เส้นทางของ "งานของฉัน" (listMyChecklistItems) — เฉพาะ done=false ต่อคนต่อร้าน
  @@index([checklistId])
  @@index([tenantId, assigneeUserId, done])
}

// ───────────────────────── ความเห็นในการ์ด (K1.8 · KANBAN-RUN §K1.8) ─────────────────────────
// เนื้อความเก็บ markup ของ mention ไว้ตรง ๆ: `@[ชื่อ](userId)` — ชื่อที่โชว์เป็นค่า ณ เวลาที่พิมพ์
// (คนเปลี่ยนชื่อทีหลัง ข้อความเก่ายังอ่านรู้เรื่อง) ส่วน `mentions` = userId ที่ถอดจาก markup แล้ว
// กรองเหลือเฉพาะพนักงานจริงของร้าน — ใช้เป็นรายชื่อผู้รับแจ้งเตือน/ค้นหาในอนาคต ไม่ต้อง parse ซ้ำ
//
// ไม่มี `systemId`: การ์ดต้นทางรู้ระบบของตัวเองอยู่แล้ว (เหตุผลเดียวกับ KanbanChecklist ใน K1.7)
// ลบแบบ soft (`deletedAt`) เสมอ — ประวัติกิจกรรม (K1.10) ต้องยังอ้างถึงความเห็นที่ถูกลบได้
model KanbanComment {
  id           String     @id @default(cuid())
  tenantId     String
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorUserId String // User.id — ไม่ทำ FK (เหมือน KanbanCardAssignee) ตรวจ Membership ใน service
  body         String
  mentions     Json       @default("[]") // string[] ของ User.id ที่ถูกพูดถึง (กรองแล้วว่าเป็นคนในร้าน)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())

  // เส้นอ่านหลัก = ความเห็นของการ์ดใบเดียว เรียงเก่า→ใหม่
  @@index([cardId, createdAt])
  @@index([tenantId])
}

// ───────────────────────── ไฟล์แนบ + ปกการ์ด (K1.9 · KANBAN-RUN §K1.9) ─────────────────────────
// ไฟล์จริงอยู่บน storage กลาง (`FileAsset` · src/lib/storage/service.ts) — ตารางนี้แค่ผูกไฟล์เข้ากับการ์ด
// `fileId` → FileAsset.id (ไม่ทำ FK ข้ามโมดูล — FileAsset อยู่คนละ schema file/domain) · `name/contentType/bytes`
// copy มาจาก FileAsset ตอนอัปโหลด (แสดงรายการไม่ต้อง join ทุกครั้ง) · `KanbanCard.coverFileId` (K1.1)
// ชี้กลับมาที่ `fileId` ของแถวนี้เมื่อถูกตั้งเป็นปก (ไม่ใช่ FK ไปตารางนี้ตรง ๆ — ปกอ้าง FileAsset เดียวกับ
// ที่ทุกที่อื่นในระบบใช้ display)
//
// ไม่มี `systemId`: การ์ดต้นทางรู้ระบบของตัวเองอยู่แล้ว (เหตุผลเดียวกับ KanbanComment/KanbanChecklist)
// ลบแบบ soft (`deletedAt`) เสมอ — ลบไฟล์ที่เป็นปกอยู่ ต้องเคลียร์ `KanbanCard.coverFileId` คู่กันเสมอ (service ตรวจ)
model KanbanAttachment {
  id           String     @id @default(cuid())
  tenantId     String
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileId       String // → FileAsset.id
  name         String // ชื่อไฟล์ตอนอัป (ไม่ใช่ path จริงบน storage — ผู้ใช้เห็นชื่อนี้ในรายการ)
  contentType  String // ชนิดที่ผ่านด่านตรวจไบต์จริงแล้ว (ไม่ใช่ที่เบราว์เซอร์ประกาศดิบ ๆ)
  bytes        Int
  uploadedById String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([cardId])
  @@index([tenantId])
}

// ───────────────────────── ประวัติกิจกรรม (K1.10 · KANBAN-RUN §K1.10) ─────────────────────────
// "ใครทำอะไรกับบอร์ด/การ์ดใบนี้เมื่อไหร่" — append-only: เขียนอย่างเดียว ไม่มี update/delete ใน service
// (ลบได้ทางเดียวคือการ์ด/บอร์ดถูกลบจริง ซึ่ง cascade ตามไป — ปกติของระบบคือ "เก็บเข้าคลัง" ไม่ใช่ลบ)
//
// 🔴 ทุกแถวถูกเขียน **ในทรานแซกชันเดียวกับงานจริง** (`logActivity(tx, …)`) — งานสำเร็จแต่ประวัติหาย
//    (หรือกลับกัน) แปลว่าประวัติเชื่อไม่ได้ ซึ่งแย่กว่าไม่มีประวัติเลย
// 🔴 ไม่ใช่ของแทน `AuditLog` กลาง (§6.5): เรื่องสิทธิ์/ความปลอดภัยยังเขียน AuditLog เหมือนเดิม
//    ตารางนี้คือ "สายกิจกรรมที่ทีมอ่าน" ในหลังการ์ด/หน้าบอร์ด (Trello activity feed)
// 🔴 ไม่มี `systemId`: บอร์ดต้นทางรู้ระบบของตัวเองอยู่แล้ว (เหตุผลเดียวกับ KanbanComment/Checklist/Attachment)
// `data` = รายละเอียดต่อชนิด (MOVED {fromColumnId,toColumnId} · DUE_SET {dueAt} · ASSIGNED/UNASSIGNED
// {userIds} · LABELED/UNLABELED {labelIds} · UPDATED {fields}) — เก็บ **id** ไม่ใช่ชื่อ แล้ว resolve
// ชื่อสด ๆ ตอนอ่าน (คนเปลี่ยนชื่อ/ป้ายเปลี่ยนชื่อ ประวัติต้องไม่ค้างชื่อเก่า) ยกเว้นของที่หายไปได้
// อย่างชื่อไฟล์แนบ/ข้อความเช็คลิสต์ ที่เก็บสำเนาไว้ในนี้เลย
enum KanbanActivityType {
  BOARD_CREATED
  BOARD_UPDATED
  BOARD_ARCHIVED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_MOVED
  COLUMN_ARCHIVED
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_ASSIGNED
  CARD_UNASSIGNED
  CARD_DUE_SET
  CARD_LABELED
  CARD_UNLABELED
  CARD_ARCHIVED
  CARD_RESTORED
  CARD_COMPLETED
  CHECKLIST_ITEM_DONE
  COMMENT_ADDED
  ATTACHMENT_ADDED
}

model KanbanActivity {
  id           String             @id @default(cuid())
  tenantId     String
  boardId      String
  board        KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cardId       String? // null = กิจกรรมระดับบอร์ด (คอลัมน์/สมาชิก/บอร์ดเอง)
  card         KanbanCard?        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actorUserId  String? // User.id — null = ระบบเป็นคนทำ (cron/automation/นำเข้า) ไม่ทำ FK เหมือนช่องคนอื่นในโมดูล
  type         KanbanActivityType
  data         Json               @default("{}")
  createdAt    DateTime           @default(now())

  // เส้นอ่านหลัก 2 เส้น — "สายของการ์ดใบนี้" กับ "สายของทั้งบอร์ด" ทั้งคู่เรียงล่าสุดก่อนเสมอ
  @@index([cardId, createdAt(sort: Desc)])
  @@index([boardId, createdAt(sort: Desc)])
  @@index([tenantId])
}
