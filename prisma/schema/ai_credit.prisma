// กระเป๋าเครดิตผู้ช่วย AI — เติมเงินล่วงหน้า (prepaid) ไม่ใช่โควตาต่อรอบ
//
// หน่วยเงิน = ไมโครดอลลาร์ (1 USD = 1,000,000) เก็บเป็น Int
//   ทำไมไม่เก็บเป็นดอลลาร์ทศนิยม: ค่า 1 ข้อความถูกระดับ $0.0001 — ทศนิยมลอยตัวจะปัดหาย
//   เพดาน Int = ~$2,147 ต่อค่าเดียว (พอสำหรับกระเป๋าร้าน · ถ้าจะขายก้อนใหญ่กว่านี้ต้องขยับเป็น BigInt)
//
// ledger เป็น append-only: ทุกแถวเก็บ balanceAfter ไว้ → ตรวจย้อนหลังได้ว่ายอดเดินยังไง

model AiCreditWallet {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  balanceMicro Int       @default(0) // ยอดคงเหลือ (ไมโครดอลลาร์)
  grantedAt    DateTime? // เคยรับเครดิตต้อนรับแล้วหรือยัง — กันแจกซ้ำ (null = ยังไม่เคย)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AiCreditKind {
  GRANT // เครดิตต้อนรับ (แจกครั้งเดียวตอนเปิดกระเป๋า)
  TOPUP // เติมเงินเข้ามา
  USAGE // ใช้ไปกับการเรียก AI
  REFUND // คืนเงิน (เช่น ยกเลิกรายการเติม)
  ADJUST // ปรับมือโดยแอดมินแพลตฟอร์ม
}

// ต้นทางของรายการ — ตอบคำถาม "เงินหายไปกับอะไร" ได้รายทาง (เดิมดูไม่ได้เลย)
enum AiCreditSource {
  CHAT // แชทผู้ช่วย AI (ผู้ใช้พิมพ์เอง)
  SCHEDULED // งานประจำรายชั่วโมง
  WEEKLY_REPORT // รายงานธุรกิจรายสัปดาห์ (cron วันจันทร์)
  DNA_INTERVIEW // สัมภาษณ์ธุรกิจแบบพิมพ์อิสระ
  AUTO_TITLE // ตั้งชื่อห้องแชทอัตโนมัติ
  SUPPORT_DRAFT // ร่างคำตอบเคสใน backoffice (ลงบัญชีแพลตฟอร์ม ไม่หักร้าน)
  // ── ระบบแชทลูกค้า (WO-CW3) ──
  // 🔴 แยกจาก CHAT เด็ดขาด — CHAT คือ "เจ้าของร้านคุยกับผู้ช่วย AI ของตัวเอง"
  //    2 ตัวนี้คือ "ทีมงานใช้ AI ตอนคุยกับลูกค้า" คนละกระเป๋าความหมาย
  //    รวมเป็นตัวเดียว = เจ้าของแยกบิลไม่ออกว่าเงินหมดไปกับอะไร แล้วปิดผิดตัว
  CHAT_TRANSLATE // แปลข้อความในกล่องแชทลูกค้า (กดแปล — มติ W3)
  CHAT_SUGGEST // AI แนะนำคำตอบให้ทีมงาน
  TOPUP // เติมเงิน
  GRANT // เครดิตต้อนรับ
  ADJUST // ปรับมือ
}

model AiCreditTxn {
  id             String         @id @default(cuid())
  tenantId       String
  kind           AiCreditKind
  source         AiCreditSource
  amountMicro    Int // + เข้ากระเป๋า · − ออกจากกระเป๋า
  balanceAfter   Int // ยอดคงเหลือหลังรายการนี้ (snapshot — ตรวจย้อนหลังได้)
  model          String? // โมเดลที่ใช้จริง (เฉพาะ USAGE)
  tokensIn       Int            @default(0)
  tokensOut      Int            @default(0)
  note           String?
  conversationId String?
  userId         String?
  ref            String? // กันซ้ำจากภายนอก (เช่น charge id ของ Beam)
  createdAt      DateTime       @default(now())

  @@unique([tenantId, ref])
  @@index([tenantId, createdAt])
}

// ตั้งค่าผู้ช่วย AI ระดับกิจการ — บ้านของสวิตช์ที่กระทบ "เงินที่ร้านต้องจ่าย"
// กติกา: อะไรที่ระบบทำเองแล้วหักเครดิต ต้อง **ปิดไว้ก่อน** ให้เจ้าของเปิดเอง
// (มติเจ้าของ 8 ส.ค. 2026 — เดิมรายงานสัปดาห์ยิงทุกร้านอัตโนมัติโดยไม่มีใครสั่ง)
model AiSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  weeklyReportEnabled Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
