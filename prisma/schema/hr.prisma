// HR (ระบบ 17) — พนักงาน + ลงเวลา + ลา (contract C-2 availability)
// availability คือของ HR — ระบบอื่นถาม ห้าม copy · ลาอนุมัติ → Booking ปิด slot (wiring ภายหลัง)
enum HrLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrLeaveType {
  SICK
  PERSONAL
  VACATION
  OTHER
}

enum HrAttendanceKind {
  IN
  OUT
}

// ผลตัดสินการเข้างาน (13 ส.ค. 2026) — snapshot ณ วินาทีที่กดเข้างาน ไม่คิดสดตอนอ่าน
// เหตุผล: ตารางแก้ทีหลังต้องไม่ย้อนไปเปลี่ยนคำตัดสินของวันที่ผ่านมาแล้ว (บทเรียนเดียวกับ Appointment.priceSatang)
// NO_SCHEDULE = ยังไม่ตั้งตาราง → ไม่ใช่ความผิดพนักงาน ห้ามนับเป็นสาย
// HR H1.2 ▸ ABSENT (ขาดงาน) / EARLY_OUT (ออกก่อนเวลา) เพิ่มด้วย migration แยก 20261205000001_hr_judgement_enums
//   (ALTER TYPE … ADD VALUE ใช้ในธุรกรรมเดียวกับที่เพิ่มไม่ได้) · H1.2 ยังไม่มีแถวไหนใช้ — ผู้ตัดสิน = H2.5 ◂
enum HrAttendanceJudgement {
  ON_TIME
  LATE
  DAY_OFF
  NO_SCHEDULE
  ABSENT
  EARLY_OUT
}

// ── HR H1.2 ▸ เวลาและการลา (โมเดลอย่างเดียว — เครื่องยนต์ = H2.x) ◂ ──
// ที่มาของตารางงาน: แม่แบบรายสัปดาห์ / จัดมือ / AI เสนอ
enum HrRosterSource {
  TEMPLATE
  MANUAL
  AI
}

// ที่มาของการลงเวลา (null = ก่อน H2.4 — clock() ยังไม่เขียนช่องนี้ · มติ Q7)
enum HrClockSource {
  KIOSK
  MANAGER
  MOBILE
  CORRECTION
  POS
  IMPORT
}

// สถานะคำขอทั่วไป (แก้เวลา / OT)
enum HrRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// สถานะคำขอแลกกะ — AWAITING_PEER = รอเพื่อนร่วมงานตอบก่อน แล้วจึง PENDING รอผู้จัดการ
enum HrSwapStatus {
  AWAITING_PEER
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// OT ก่อนเข้างาน / หลังเลิกงาน (HQ10 — ช่วงเวลา N ชม. อยู่ในการตั้งค่า H2.9)
enum HrOtTiming {
  BEFORE
  AFTER
}

// ชนิดรายการสมุดวันลา — GRANT/CARRY/ADJUST เป็นบวก · USE/EXPIRE เป็นลบ · ยกเลิกใบลาที่อนุมัติแล้ว = ADJUST (use-revert:<leaveId>)
enum HrLeaveTxnKind {
  GRANT
  USE
  CARRY
  EXPIRE
  ADJUST
}

// วันหยุดราชการ / วันหยุดของร้าน
enum HrHolidayKind {
  PUBLIC
  SHOP
}

// ลาครึ่งวันเช้า / บ่าย
enum HrHalfDay {
  AM
  PM
}

// เพศ / สถานะสมรส / ประเภทการจ้าง — ใช้ enum เพื่อให้รายงานนับได้ (ไม่ใช่ข้อความพิมพ์อิสระ)
enum HrGender {
  MALE
  FEMALE
  OTHER
}

enum HrMaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

// ⚠️ HR H1.1 ▸ เลิกใช้เป็น "สถานะ" แล้ว (PROBATION ปนกับประเภทการจ้าง) — สถานะการจ้างย้ายไป HrEmploymentStatus ·
//   คอลัมน์นี้คงไว้ (ข้อมูลเดิม) · backfill แปลง PROBATION → employmentStatus PROBATION ◂
enum HrEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  DAILY
  PROBATION
}

// HR H1.1 ▸ สถานะการจ้าง (แยกจากประเภท) — ทดลองงาน / ประจำ / สิ้นสุด · null = ข้อมูลก่อน H1.1 ที่ยังไม่ backfill ◂
enum HrEmploymentStatus {
  PROBATION
  ACTIVE
  ENDED
}

// ชนิดเอกสารแนบของพนักงาน (13 ส.ค. 2026) — สำเนาบัตร/ทะเบียนบ้าน/สัญญาจ้าง ฯลฯ
enum HrDocKind {
  ID_CARD
  HOUSE_REG
  CONTRACT
  CERTIFICATE
  SSO_FORM
  BANK_BOOK
  OTHER
}

model HrEmployee {
  id           String   @id @default(cuid())
  tenantId     String
  systemId     String
  name         String
  phone        String?
  position     String?
  pinCode      String? // ⚠️ เลิกใช้ (HR H0.5) — PIN ตัวเปล่าแบบเก่า · backfill แล้วเป็น null · ลบคอลัมน์ใน RUN ถัดไป
  // HR H0.5 ▸ PIN เก็บเป็น HMAC-SHA256(HR_PIN_PEPPER, tenantId␟pin) เท่านั้น — อ่าน/เขียนได้ที่ hr/pin.ts ที่เดียว (F16.5)
  //   ไม่ซ้ำ "ทั้งร้าน" ในหมู่คนที่ยังทำงาน = partial unique "HrEmployee_tenantId_pinHash_active_key" (SQL ดิบใน migration
  //   20261201000000_hr_pin_hash — Prisma schema ประกาศ WHERE ไม่ได้) ◂
  pinHash      String?
  pinSetAt     DateTime?
  linkedUserId String? // ผูก User ถ้ามีบัญชี
  // HR H0.7 ▸ 1 บัญชี ↔ พนักงาน 1 คนต่อร้าน = partial unique "HrEmployee_tenantId_linkedUserId_key" (SQL ดิบใน migration
  //   20261203000000_hr_link_unique_requester — Prisma ประกาศ WHERE ไม่ได้) · linkApprovedById = user ที่ยืนยันการผูกบัญชี
  //   (ผูกพนักงานที่มีข้อมูลเงินเดือน = ผู้ดูเงินเดือนเท่านั้น) · ถอนสิทธิ์ (revokeStaffAccess) ล้างทั้งสองช่อง ◂
  linkApprovedById String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── ทะเบียนพนักงานเต็มรูปแบบ (13 ส.ค. 2026 · เจ้าของสั่งข้อ 8) — ทุกช่องไม่บังคับ ──
  // ร้านเล็กกรอกแค่ชื่อก็ใช้งานได้เหมือนเดิม · ร้านที่ต้องทำเอกสาร/ประกันสังคมกรอกเพิ่มได้
  code              String? // รหัสพนักงานของร้าน
  nickname          String?
  gender            HrGender?
  birthDate         DateTime?         @db.Date
  email             String?
  department        String? // แผนก (คู่กับ position = ตำแหน่ง)
  employmentType    HrEmploymentType?
  startDate         DateTime?         @db.Date // วันเริ่มงาน
  endDate           DateTime?         @db.Date // วันสิ้นสุด/ลาออก (คงข้อมูลไว้ ไม่ลบ)
  maritalStatus     HrMaritalStatus?
  // ที่อยู่ปัจจุบัน
  addressLine       String?
  subdistrict       String?
  district          String?
  province          String?
  postcode          String?
  // 🔒 ข้อมูลอ่อนไหว (PDPA) — เห็น/แก้ได้เฉพาะ OWNER หรือผู้มีสิทธิ์ hr.payroll.read
  nationalId        String? // เลขบัตรประชาชน
  ssoNumber         String? // เลขประกันสังคม
  houseRegAddress   String? // ที่อยู่ตามทะเบียนบ้าน (ถ้าต่างจากที่อยู่ปัจจุบัน)
  bankName          String?
  bankAccountNo     String?
  bankAccountName   String?
  // ผู้ติดต่อฉุกเฉิน
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  note              String?
  // WO 3.1 — Party (INTEGRATION-MAP §F.1) — จาก name/phone/email เท่านั้น **ห้ามคัด nationalId/PDPA อื่น**
  partyId           String?

  // HR H1.1 ▸ แกนสาขา (HQ20: สาขา HR = BusinessUnit) — unitId = สาขาประจำ · ไม่มี FK ไป BusinessUnit (ธรรมเนียมรีโป:
  //   อ้าง unit ข้ามโมดูลเป็น String + index) · null = ยังไม่ระบุสาขา (เห็น/แก้ได้เฉพาะผู้ดูแลทุกสาขา — มติผู้คุมงาน 3)
  //   employmentStatus = สถานะการจ้าง · probationEndAt / contractEndAt = ข้อมูลอย่างเดียวใน H1.1 (เตือน = H2.x) ◂
  unitId            String?
  employmentStatus  HrEmploymentStatus?
  probationEndAt    DateTime?         @db.Date
  contractEndAt     DateTime?         @db.Date

  attendances HrAttendance[]
  leaves      HrLeave[]
  schedules   HrWorkSchedule[]
  docs        HrEmployeeDoc[]
  units       HrEmployeeUnit[] // HR H1.1 ▸ ยืมตัวไปสาขาอื่น ◂
  // HR H1.2 ▸ ตารางงาน / คำขอแก้เวลา / OT / สมุดวันลา ◂
  rosterEntries    HrRosterEntry[]
  timeCorrections  HrTimeCorrection[]
  otRequests       HrOtRequest[]
  leaveBalanceTxns HrLeaveBalanceTxn[]

  @@index([systemId, active])
  @@index([tenantId])
  @@index([partyId])
  @@index([systemId, unitId])
  @@index([systemId, employmentStatus])
}

// HR H1.1 ▸ ยืมตัว / ช่วยงานสาขาอื่น — 1 แถว = ช่วงวันที่พนักงานคนนี้อยู่สาขา unitId (นอกจากสาขาประจำ)
//   toDate null = ยังเปิดอยู่ · 🔴 partial unique "HrEmployeeUnit_employeeId_unitId_open_key" ("employeeId","unitId") WHERE "toDate" IS NULL
//   ประกาศเฉพาะใน migration.sql (20261204000000_hr_org_axis · Prisma schema ไม่รองรับ WHERE) — ห้ามใส่ @@unique ของคู่นี้ที่นี่ ·
//   FK → HrEmployee (ลบพนักงาน = ลบแถวยืมตัว) · ไม่มี FK ไป BusinessUnit (Q1) ◂
model HrEmployeeUnit {
  id         String     @id @default(cuid())
  tenantId   String
  systemId   String
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId     String
  fromDate   DateTime   @db.Date
  toDate     DateTime?  @db.Date
  note       String?
  createdAt  DateTime   @default(now())

  @@index([systemId, employeeId])
  @@index([systemId, unitId])
}

// เอกสารแนบของพนักงาน — เก็บเป็น URL (อัปโหลด Bunny หรือวางลิงก์)
// 🔒 อ่อนไหวทั้งตาราง (สำเนาบัตร/ทะเบียนบ้าน) → หน้าจอกันด้วยสิทธิ์เดียวกับเงินเดือน
model HrEmployeeDoc {
  id         String     @id @default(cuid())
  tenantId   String
  systemId   String
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       HrDocKind  @default(OTHER)
  title      String
  url        String
  note       String?
  createdAt  DateTime   @default(now())

  @@index([systemId, employeeId])
  @@index([tenantId])
}

model HrAttendance {
  id         String                 @id @default(cuid())
  tenantId   String
  systemId   String
  employeeId String
  employee   HrEmployee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       HrAttendanceKind
  at         DateTime               @default(now())
  note       String?
  // ผลตัดสิน + หลักฐานที่ใช้ตัดสิน (เฉพาะ kind=IN · null = แถวก่อน 13 ส.ค. 2026 หรือการลงเวลาออก)
  judgement  HrAttendanceJudgement?
  dueMin     Int? // ควรเข้ากี่โมง (นาทีจากเที่ยงคืนเวลาไทย) ณ วันนั้น
  lateMin    Int? // สายกี่นาที (นับจาก dueMin ไม่รวมเวลาผ่อนผัน) · 0 = ไม่สาย
  // HR H1.2 ▸ หลักฐานการลงเวลา — ทุกช่องว่างได้ ไม่มีค่าปริยาย (แถวเดิม = null) · H1.2 ยังไม่มีใครเขียน/อ่าน
  //   🔒 lat/lng/accuracyM/photoKey/deviceId = ข้อมูลอ่อนไหว (GPS/รูป — HQ27) ห้ามออก DTO/หน้า/AI/outbox · deviceId = สตริงทึบ ไม่มี FK (Q9) ◂
  rosterEntryId String?
  rosterEntry   HrRosterEntry?  @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)
  source        HrClockSource?
  lat           Decimal?        @db.Decimal(9, 6)
  lng           Decimal?        @db.Decimal(9, 6)
  accuracyM     Int?
  photoKey      String?
  deviceId      String?
  corrections   HrTimeCorrection[]

  @@index([systemId, employeeId, at])
  @@index([rosterEntryId])
}

model HrLeave {
  id          String        @id @default(cuid())
  tenantId    String
  systemId    String
  employeeId  String
  employee    HrEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        HrLeaveType   @default(PERSONAL)
  fromDate    DateTime      @db.Date
  toDate      DateTime      @db.Date
  status      HrLeaveStatus @default(PENDING)
  reason      String?
  decidedById String?
  // HR H0.7 ▸ user ที่ยื่นแทน (ผู้จัดการ/HR) · null = พนักงานยื่นเอง ◂
  filedById   String?
  createdAt   DateTime      @default(now())
  // HR H1.2 ▸ ประเภทการลาของร้าน + จำนวนวัน/ครึ่งวัน/ชั่วโมง + ใบรับรองแพทย์ — ว่างได้ทุกช่อง (ใบลาเดิม days = null → H2.7 ตัดสิน)
  //   ผู้ยื่น = filedById ?? employee.linkedUserId (มติ Q1 — ไม่มีคอลัมน์ผู้ยื่นแยก) · 🔒 attachmentKey = ข้อมูลสุขภาพ ◂
  policyId      String?
  policy        HrLeavePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  days          Decimal?       @db.Decimal(4, 1)
  halfDay       HrHalfDay?
  hours         Decimal?       @db.Decimal(4, 1)
  attachmentKey String?
  balanceTxns   HrLeaveBalanceTxn[]

  @@index([systemId, status])
  @@index([systemId, employeeId, fromDate])
}

// ตารางเวลาทำงานรายพนักงาน (11 ส.ค. 2026 — เจ้าของทัก: ระบบยังไม่มีเลย)
// เดิมมีแค่บันทึกเข้า-ออก (HrAttendance) แต่ไม่มี "ควรเข้ากี่โมง" → บอกไม่ได้ว่าสายหรือขาด
// 1 แถว = 1 วันในสัปดาห์ของพนักงานคนนั้น · ไม่มีแถว = ยังไม่ตั้ง (ไม่ตัดสินว่าสาย/ขาด)
// ครึ่งวัน = ตั้งช่วงเวลาให้สั้นลง (เช่น เสาร์ 09:00-13:00) ไม่ต้องมีชนิดพิเศษ
model HrWorkSchedule {
  id         String     @id @default(cuid())
  tenantId   String
  systemId   String
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday    Int // 0=อาทิตย์ … 6=เสาร์
  dayOff     Boolean    @default(false) // วันหยุดประจำของคนนี้
  startMin   Int        @default(540) // 09:00
  endMin     Int        @default(1080) // 18:00
  graceMin   Int        @default(15) // เข้าช้าได้กี่นาทีก่อนนับว่าสาย
  // 🔴 วันที่เริ่มมีตาราง — ห้ามนับ "ขาดงาน" ย้อนหลังไปก่อนวันที่ร้านตั้งตารางให้คนนี้
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([employeeId, weekday])
  @@index([systemId, employeeId])
}

// ════════ HR H1.2 ▸ เวลาและการลา (8 ตาราง) — unique ที่มีนิพจน์/เงื่อนไข อยู่ใน migration.sql เท่านั้น ◂ ════════

// กะของร้าน — unitId null = ใช้ทุกสาขา · crossesMidnight = เลิกกะวันถัดไป (endMin < startMin)
//   🔴 unique "ชื่อกะที่ยังใช้อยู่ ไม่ซ้ำต่อระบบ+สาขา" = (systemId, COALESCE(unitId,''), lower(name)) WHERE active (SQL ดิบ)
//   ปิดใช้ (active false) แทนการลบ — ตารางงานอ้างกะด้วย FK Restrict
model HrShift {
  id              String          @id @default(cuid())
  tenantId        String
  systemId        String
  unitId          String?
  name            String
  code            String?
  startMin        Int
  endMin          Int
  breakMin        Int             @default(0)
  graceMin        Int             @default(15)
  crossesMidnight Boolean         @default(false)
  colour          String? // คีย์สีของธีม (shift-1…) ไม่ใช่ hex
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  entries         HrRosterEntry[]

  @@index([tenantId])
  @@index([systemId, unitId, active])
}

// ตารางงานรายวัน — date = วันตามปฏิทินไทยที่กะ "เริ่ม" · เวลาคัดลอกจากกะตอนเขียน (snapshot — แก้กะทีหลังไม่ย้อนแก้ประวัติ · Q6)
//   ไม่มีแถว = วันหยุด · unitId = สาขาที่ทำงานวันนั้น (ยืมตัว)
model HrRosterEntry {
  id              String               @id @default(cuid())
  tenantId        String
  systemId        String
  employeeId      String
  employee        HrEmployee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime             @db.Date
  shiftId         String
  shift           HrShift              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  unitId          String?
  startMin        Int
  endMin          Int
  breakMin        Int
  crossesMidnight Boolean
  published       Boolean              @default(false)
  publishedAt     DateTime?
  source          HrRosterSource       @default(MANUAL)
  note            String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  attendances     HrAttendance[]
  swapRequests    HrShiftSwapRequest[]

  @@unique([employeeId, date, shiftId])
  @@index([tenantId])
  @@index([systemId, date])
  @@index([systemId, unitId, date])
}

// คำขอแลก/ยกกะ — toEntryId null = ยกให้ · 🔴 "คำขอที่ยังเปิดได้ 1 ใบต่อแถวตาราง" = partial unique (fromEntryId)
//   WHERE status IN ('AWAITING_PEER','PENDING') (SQL ดิบ) · requestedByUserId = user ที่กดยื่น (ตัวเอง/ยื่นแทน)
model HrShiftSwapRequest {
  id                  String        @id @default(cuid())
  tenantId            String
  systemId            String
  requesterEmployeeId String
  fromEntryId         String
  fromEntry           HrRosterEntry @relation(fields: [fromEntryId], references: [id], onDelete: Cascade)
  targetEmployeeId    String?
  toEntryId           String?
  status              HrSwapStatus  @default(AWAITING_PEER)
  reason              String?
  requestedByUserId   String?
  peerDecidedAt       DateTime?
  decidedById         String?
  decidedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([tenantId])
  @@index([systemId, status])
}

// คำขอแก้เวลา — attendanceId null = ลืมกด · 🔴 partial unique 2 ตัว (SQL ดิบ): ใบรอ 1 ใบต่อ attendanceId ·
//   ใบรอ 1 ใบต่อ (employeeId, rosterEntryId, kind) · evidenceJson = id ปิดกะ POS เท่านั้น (H2.6)
model HrTimeCorrection {
  id                 String           @id @default(cuid())
  tenantId           String
  systemId           String
  employeeId         String
  employee           HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceId       String?
  attendance         HrAttendance?    @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  rosterEntryId      String?
  kind               HrAttendanceKind
  proposedAt         DateTime
  originalAt         DateTime?
  reason             String
  status             HrRequestStatus  @default(PENDING)
  requestedByUserId  String?
  decidedById        String?
  decidedAt          DateTime?
  resultAttendanceId String?
  evidenceJson       Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId])
  @@index([systemId, status])
}

// คำขอ OT — date = วันไทยที่ OT เริ่ม · multiplierBp = ตัวคูณ ณ ตอนอนุมัติ (ค่าตามกฎหมายมาจาก HrLawTable H1.3 ไม่ใช่โค้ด)
//   🔴 partial unique "OT ที่ยังมีผล ไม่ซ้ำเวลาเริ่ม" = (employeeId, startAt) WHERE status IN ('PENDING','APPROVED') (SQL ดิบ)
model HrOtRequest {
  id                String          @id @default(cuid())
  tenantId          String
  systemId          String
  employeeId        String
  employee          HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rosterEntryId     String?
  date              DateTime        @db.Date
  startAt           DateTime
  endAt             DateTime
  minutes           Int
  timing            HrOtTiming
  reason            String?
  status            HrRequestStatus @default(PENDING)
  requestedByUserId String?
  decidedById       String?
  decidedAt         DateTime?
  multiplierBp      Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([systemId, status])
  @@index([systemId, employeeId, date])
}

// ประเภทการลาของร้าน (มติ review #10 — ไม่ใช่โมเดลชื่อ HrLeaveType) · category = enum HrLeaveType เดิม (หมวดตามกฎหมาย)
//   quotaDays null = ไม่จำกัดโควตา · 🔴 unique (systemId, COALESCE(unitId,''), lower(name)) WHERE active (SQL ดิบ)
model HrLeavePolicy {
  id                   String              @id @default(cuid())
  tenantId             String
  systemId             String
  unitId               String?
  category             HrLeaveType
  name                 String
  paid                 Boolean             @default(true)
  quotaDays            Decimal?            @db.Decimal(4, 1)
  minServiceDays       Int                 @default(0)
  firstYearProrata     Boolean             @default(false)
  carryMaxDays         Decimal             @default(0) @db.Decimal(4, 1)
  carryExpiresMonthDay String? // "MM-DD"
  allowHalfDay         Boolean             @default(true)
  allowHours           Boolean             @default(false)
  attachmentAfterDays  Int?
  yearStartMonth       Int                 @default(1)
  active               Boolean             @default(true)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  leaves               HrLeave[]
  balanceTxns          HrLeaveBalanceTxn[]

  @@index([tenantId])
  @@index([systemId, category])
}

// สมุดวันลา (ledger — เขียนเพิ่มอย่างเดียว ไม่แก้แถว) · ยอดคงเหลือ = ผลรวม days · sourceKey = กันเขียนซ้ำ
//   (grant:<emp>:<policy>:<ปี> · use:<leaveId> · use-revert:<leaveId>) · H1.2 ไม่มีผู้เขียน (นอกจาก oracle fixture)
model HrLeaveBalanceTxn {
  id            String         @id @default(cuid())
  tenantId      String
  systemId      String
  employeeId    String
  employee      HrEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId      String
  policy        HrLeavePolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  kind          HrLeaveTxnKind
  days          Decimal        @db.Decimal(4, 1)
  leaveYear     Int
  effectiveDate DateTime       @db.Date
  leaveId       String?
  leave         HrLeave?       @relation(fields: [leaveId], references: [id], onDelete: SetNull)
  sourceKey     String
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  @@unique([systemId, sourceKey])
  @@index([tenantId])
  @@index([systemId, employeeId, policyId, leaveYear])
}

// วันหยุด — unitId null = ทั้งร้าน · แถวทั้งร้าน + แถวสาขาวันเดียวกันมีได้ทั้งคู่ (ลำดับความสำคัญ = H2.8)
//   presetYear ไม่ว่าง = มาจากชุดวันหยุดของ SHARK (H2.8) · 🔴 unique (systemId, date, COALESCE(unitId,'')) (SQL ดิบ)
model HrHoliday {
  id         String        @id @default(cuid())
  tenantId   String
  systemId   String
  unitId     String?
  date       DateTime      @db.Date
  name       String
  kind       HrHolidayKind
  presetYear Int?
  shopOpen   Boolean       @default(false)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([tenantId])
  @@index([systemId, date])
}
