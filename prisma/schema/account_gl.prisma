// Account — ชั้นบัญชีเต็มรูป (P2/P3): ผังบัญชี + สมุดรายวัน + การเงิน + สินทรัพย์ + คลังเอกสาร
// เจ้าของ schema = main session (contract กลาง) — subagent ไม่แตะไฟล์ prisma
// scope = feature: ทุกตาราง tenantId + systemId · เงิน Int สตางค์ · id cuid()
// อ้างสเปค docs/modules/12-account.md §4.5–4.8 + §4.14 (ผังบัญชี seed) + §7.10 (posting rules)

// ───────── enums (ชั้นบัญชี) ─────────
enum AccountVatTiming {
  ON_ISSUE // สินค้า = ออกใบกำกับตอนส่งมอบ
  ON_PAYMENT // บริการ = ต่องวดรับเงิน
}

enum AccountProductType {
  GOODS
  SERVICE
  /// V2 (WO 4.3 · SPEC §8.1–8.2) — "รายการจัดชุด": ขาย 1 ชุด = ตัดสต็อกส่วนประกอบตาม AccountProductBundleItem
  BUNDLE
}

enum AccountFinanceType {
  CASH
  BANK
  E_WALLET
  PETTY_CASH
}

enum AccountChequeDirection {
  IN
  OUT
}

enum AccountChequeStatus {
  ON_HAND
  DEPOSITED
  CLEARED
  BOUNCED
  ISSUED
  VOIDED
}

enum AccountLedgerType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COGS
  EXPENSE
}

enum AccountCashflowActivity {
  OPERATING
  INVESTING
  FINANCING
  NONE
}

enum AccountJournalBook {
  SALES
  PURCHASES
  RECEIPTS
  PAYMENTS
  GENERAL
}

enum AccountJournalType {
  DOC
  PAYMENT
  ADJUST
  REVERSAL
  DEPRECIATION
  OPENING
}

enum AccountEntrySource {
  AUTO
  MANUAL
}

enum AccountEntryStatus {
  POSTED
  REVERSED
}

enum AccountPeriodStatus {
  OPEN
  CLOSED
}

enum AccountAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
  WRITTEN_OFF
}

enum AccountWhtIncomeType {
  M40_1
  M40_2
  M40_3
  M40_4
  M40_5
  M40_6
  M40_7
  M40_8
}

enum AccountEtaxStatus {
  NOT_SENT
  PENDING
  SENT
  FAILED
}

enum AccountLinkedKind {
  POS
  BUSINESS
  CRM // ระบบ CRM ออกใบเสนอราคาเข้าบัญชีชุดนี้ (WO-0010)
  // ── V2 (WO 8.3 · SPEC §9.5 · เฟรม g14) — additive ล้วน: ค่าเดิม 3 ตัวบนคงเดิมทุกประการ ──
  MEMBER // ระบบสมาชิก (ขายให้สมาชิก → ผู้ติดต่อ/รายได้เข้าบัญชีชุดนี้)
  INVENTORY // คลังสินค้า (ซิงก์สินค้า/ต้นทุน + ลงบัญชีสต็อก)
  CHAT // แชทลูกค้า (ผู้ติดต่อจากห้องแชท + รับบิลจากแชทเข้ากล่องขาเข้า)
  HR // พนักงานและเงินเดือน (ลงบัญชีเงินเดือน)
}

// ───────── 4.3 สินค้า / หน่วย / กลุ่มจัดประเภท ─────────
model AccountUnit {
  id         String    @id @default(cuid())
  tenantId   String
  systemId   String
  name       String // "ชิ้น" "กล่อง" "ชั่วโมง"
  // ── V2 (WO 4.3 · SPEC §8.3) · additive · nullable = แถวเดิมทำงานเหมือนเดิมทุกประการ ──
  /// รหัสหน่วย "PU01" (หน่วยสินค้า) / "SU01" (หน่วยบริการ) — auto ตอนสร้าง · แก้ได้ · ห้ามซ้ำต่อระบบ
  code       String?
  /// ชื่ออังกฤษ ≤20 ("piece" "box" "hour")
  nameEn     String?
  /// ชนิดหน่วย: "PRODUCT" = นับเป็นชิ้น (PU) · "SERVICE" = หน่วยบริการ/เวลา (SU) · null = แถวเดิม
  kind       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([systemId, name])
  @@unique([systemId, code])
}

model AccountProduct {
  id                   String             @id @default(cuid())
  tenantId             String
  systemId             String
  sku                  String?
  name                 String
  nameEn               String?
  type                 AccountProductType @default(GOODS)
  unitId               String?
  salePrice            Int? // สตางค์
  buyPrice             Int?
  vatRateBp            Int                @default(700)
  incomeAccountId      String? // override ผังบัญชีต่อสินค้า
  expenseAccountId     String?
  imageUrl             String?
  // ── V2 (WO 4.3 · SPEC §8.1–8.2 · ภาพ g8) · additive ล้วน · nullable/มีค่าเริ่มต้น = แถวเดิมไม่กระทบ ──
  /// เลขที่สินค้า "P00024" / "S00003" / "B00001" (auto ตามชนิด · แก้ได้ · ไม่ซ้ำต่อระบบ)
  /// 🔴 ความไม่ซ้ำบังคับด้วย **partial unique index** `AccountProduct_systemId_code_active_key`
  ///    (เหตุผลเดียวกับ AccountContact.code — ดู account.prisma) · `prisma migrate diff` มองไม่เห็น ห้ามลบจาก migration
  code                 String?
  barcode              String? // บาร์โค้ด ≤48 (§8.2 ขั้นสูง)
  category             String? // หมวดหมู่ (ข้อความอิสระ — ตัวกรอง "หมวด" ในหน้ารายการ f6)
  description          String? // คำอธิบาย ≤500
  /// วิธีคิดต้นทุน: "AVG" = ถัวเฉลี่ย (ค่าเริ่มต้นของคลัง SHARK) · "FIFO" = 🕓 ยังไม่รองรับ (เลือกไม่ได้)
  costMethod           String             @default("AVG")
  cogsAccountCode      String? // บัญชีต้นทุนขาย (ค่าเริ่มต้น 5000)
  inventoryAccountCode String? // บัญชีสินค้าคงเหลือ (ค่าเริ่มต้น 1200)
  purchaseVatRateBp    Int? // VAT ซื้อ (null = ใช้ค่าเดียวกับ vatRateBp)
  defaultWhtType       String? // บริการ: ประเภทเงินได้ที่หัก ณ ที่จ่ายเป็นประจำ (ม.40 (…))
  defaultWhtRateBp     Int? // บริการ: อัตราหัก ณ ที่จ่ายปริยาย (300 = 3%)
  /// §8.2 "การเชื่อมต่อ" — ขายผ่าน POS (g8 การ์ด toggle ใบที่ 2)
  posEnabled           Boolean            @default(false)
  posCategory          String? // หมวดใน POS
  posPrice             Int? // ราคา POS ถ้าต่างจากราคาขาย (สตางค์ · null = เท่าราคาขาย)
  /// §8.2 "การเชื่อมต่อ" — จองผ่านระบบจอง (บริการเท่านั้น)
  bookingEnabled       Boolean            @default(false)
  bookingDurationMin   Int?
  bookingDepositSatang Int?
  /// รูปสินค้า ≤5 (array ของ URL) — `imageUrl` เดิม = รูปแรก (ยังใช้ได้ ไม่แตะ)
  imageUrls            Json               @default("[]")
  // ⚠️ V2 (WO 4.1): สต็อกของสินค้าที่ "ผูกคลัง" (invItemId != null) = InvItem.onHand เท่านั้น
  //    ช่องนี้เหลือเป็นกระจกสะท้อน (mirror) ไว้ให้หน้าจอเก่าอ่าน — ห้ามใช้ตัดสินใจ/รายงาน
  //    สินค้าที่ยังไม่ผูกคลัง ใช้ช่องนี้เป็นสต็อกของตัวเองเหมือนเดิมทุกประการ
  qtyOnHand            Decimal            @default(0) @db.Decimal(12, 4)
  // V2 (WO 4.1 · MAP §F.8–9): ต้นฉบับในแคตตาล็อกกลาง (InvItem) — ขากลับของ InvItem.accountProductId
  //   null = ไม่ติดตามสต็อกในคลัง (ไม่มีคอลัมน์ trackStock แยก — "ติดตามสต็อก" = invItemId != null)
  invItemId            String?
  // คลังปริยายที่ใบเบิก/ใบส่งคืนของสินค้านี้จะตัด/คืน (InvLocation.id) — null = คลังหลักของระบบคลัง
  warehouseId          String?
  pinned               Boolean            @default(false) // V2 (WO 0.3): ปักหมุดขึ้นหัวรายการ/ตัวเลือกด่วน
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  lines AccountDocumentLine[]

  @@unique([systemId, sku])
  @@index([systemId, type, archivedAt])
  @@index([systemId, pinned, archivedAt]) // V2: ดึงรายการที่ปักหมุดขึ้นก่อน
  @@index([systemId, invItemId]) // V2 (WO 4.1): หาสินค้าบัญชีจาก item กลาง / กรองเฉพาะที่ผูกคลัง
  /// 🔴 WO 4.3 — เหตุผลเดียวกับ AccountContact.code: ความไม่ซ้ำของ `code` ต่อระบบบังคับด้วย
  ///    **partial unique index** ใน migration 20260904190000_account_v2_products_v2:
  ///      CREATE UNIQUE INDEX "AccountProduct_systemId_code_active_key"
  ///        ON "AccountProduct"("systemId","code")
  ///        WHERE "code" IS NOT NULL AND "archivedAt" IS NULL;
  ///    (สินค้าที่ปิดใช้งานแล้วปล่อยให้เลขซ้ำได้) · `prisma migrate diff` มองไม่เห็น → ห้ามลบออกจาก migration
  @@index([systemId, code])
}

// ───────── V2 (WO 4.3 · SPEC §8.2) รายการจัดชุด: ชุด 1 หน่วย ประกอบด้วยสินค้าอะไรบ้าง ─────────
// ขายชุด 1 (ออกใบแจ้งหนี้/ใบเสร็จ หรือบิล POS) ⇒ ตัดสต็อกส่วนประกอบตามจำนวนในตารางนี้
// (ตัวชุดเองไม่มีสต็อก — ห้ามผูก invItemId กับสินค้าชนิด BUNDLE)
model AccountProductBundleItem {
  id                 String   @id @default(cuid())
  tenantId           String
  systemId           String
  bundleProductId    String // AccountProduct (type = BUNDLE)
  componentProductId String // AccountProduct (type = GOODS/SERVICE)
  qty                Decimal  @default(1) @db.Decimal(12, 4)
  unitId             String? // หน่วยของส่วนประกอบ (null = หน่วยของสินค้านั้น)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([bundleProductId, componentProductId])
  @@index([systemId, bundleProductId])
  @@index([systemId, componentProductId])
}

// ───────── V2 (WO 4.3 · SPEC §8.2 "ยอดยกมา") ยอดยกมาของสินค้า (หลาย lot) ─────────
// 1 แถว = 1 lot: วันที่ · จำนวน · ราคาต่อหน่วย · คลัง
// อนุมัติแล้ว (`postedAt` != null) ⇒ สร้างรายการรับเข้าคลัง key `acc-open-<productId>-<seq>` + JV Dr 1200 / Cr 3999
model AccountProductOpeningLot {
  id          String    @id @default(cuid())
  tenantId    String
  systemId    String
  productId   String
  seq         Int // ลำดับ lot ต่อสินค้า (1,2,3…) — เป็นส่วนหนึ่งของ idempotencyKey
  lotDate     DateTime
  qty         Decimal   @db.Decimal(12, 4)
  unitCost    Int // สตางค์/หน่วย
  warehouseId String? // InvLocation.id (null = คลังหลัก)
  postedAt    DateTime? // ลงบัญชี/รับเข้าคลังแล้วเมื่อไร (null = ยังไม่ลง)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, seq])
  @@index([systemId, productId])
}

model AccountCategory {
  id         String    @id @default(cuid())
  tenantId   String
  systemId   String
  name       String
  appliesTo  Json      @default("[]") // [AccountDocType] ที่ใช้ได้ ([] = ทุกชนิด)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  documents AccountDocument[]

  @@unique([systemId, name])
}

// ───────── 4.4 การเงิน + เช็ค ─────────
model AccountFinance {
  id              String             @id @default(cuid())
  tenantId        String
  systemId        String
  type            AccountFinanceType
  name            String
  bankName        String?
  accountNo       String?
  promptpayId     String?
  openingBalance  Int                @default(0) // V2 (WO 5.1): ผลรวมของ AccountFinanceOpening ทั้งหมด — เก็บซ้ำไว้ backward-compat (การ์ด/รายงานเดิมอ่านคอลัมน์นี้)
  openingDate     DateTime? // V2 (WO 5.1): = วันที่ของรายการยอดยกมาแรกสุด (เก็บไว้ backward-compat)
  ledgerAccountId String? // บัญชี GL ที่ผูก (1000/1010 ...)
  showOnDocuments Boolean            @default(false)
  pinned          Boolean            @default(false) // V2 (WO 0.3): ปักหมุดช่องทางเงินที่ใช้บ่อย
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // ───── V2 (WO 5.1 · DESIGN-SPEC-V2 §10.1 modal ขั้นสูง) ─────
  code          String? // CSH001/BSV001/BCA001/EWL001/PTY001 — partial unique index (ดู migration)
  bankSubtype   String? // เฉพาะ type=BANK: "SAVINGS" (ออมทรัพย์ · default) | "CURRENT" (กระแสรายวัน) — เลือก string แทนเพิ่มค่า enum เพราะไม่ต้อง migrate enum แยก
  bankBranch    String? // สาขา
  accountName   String? // ชื่อบัญชี (ต่างจาก name = ชื่อที่ตั้งเรียกในระบบ)
  note          String? // คำอธิบาย ≤500 (validate ชั้น service)
  useForReceive Boolean @default(true) // ใช้รับเงิน
  useForPay     Boolean @default(true) // ใช้จ่ายเงิน
  holderUserId  String? // ผู้ถือ (สำรองรับ/จ่าย)
  limitSatang   Int? // วงเงิน (สำรองรับ/จ่าย) — สตางค์

  payments AccountDocumentPayment[]

  @@index([systemId, type, archivedAt])
  @@index([systemId, pinned, archivedAt]) // V2: ช่องทางที่ปักหมุดขึ้นก่อน
}

// V2 (WO 5.1 · §10.1 modal "ยอดยกมาหลายรายการ"): บันทึกยอดยกมาเป็นรายการย่อยแทนตัวเลขก้อนเดียว
// แต่ละรายการ = 1 JV ของตัวเอง (idempotent ต่อ financeId+seq+version ผ่าน gl.postFinanceOpening)
// version เพิ่มทุกครั้งที่แก้ไข (แก้ = กลับรายการเดิม + โพสต์รายการใหม่ด้วย refId คนละตัว — ห้ามใช้ refId เดิมซ้ำ
// เพราะ gl.alreadyPosted เช็คแค่ "มีแถว idempotencyKey นี้ไหม" ไม่สนสถานะ REVERSED)
model AccountFinanceOpening {
  id           String    @id @default(cuid())
  tenantId     String
  systemId     String
  financeId    String
  seq          Int // ลำดับรายการยอดยกมาต่อบัญชีเงิน (1,2,3…)
  date         DateTime
  amountSatang Int // ติดลบได้ (รายการปรับลด) — ทิศทาง Dr/Cr กำหนดจากเครื่องหมาย
  note         String?
  version      Int       @default(1) // เพิ่มทุกครั้งที่แก้ไขรายการนี้
  entryId      String? // AccountJournalEntry.id ล่าสุดที่โพสต์ให้รายการนี้ (เผื่อ query ย้อน)
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([financeId, seq])
  @@index([systemId, financeId])
}

// V2 (WO 5.1 · §10.1 เมนู ⋮ "โอน"): บันทึกการโอนเงินระหว่างช่องทาง — กันโพสต์ JV ซ้ำเมื่อ request ซ้ำ (สร้างแถวนี้ก่อนโพสต์ ผูก transferId เป็น idempotency key)
model AccountFinanceTransfer {
  id           String   @id @default(cuid())
  tenantId     String
  systemId     String
  fromId       String
  toId         String
  amountSatang Int
  date         DateTime
  note         String?
  entryId      String? // AccountJournalEntry.id ที่โพสต์แล้ว (null = ยังไม่โพสต์สำเร็จ)
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([systemId, fromId])
  @@index([systemId, toId])
}

model AccountCheque {
  id               String                 @id @default(cuid())
  tenantId         String
  systemId         String
  direction        AccountChequeDirection
  chequeNo         String
  bankName         String
  bankBranch       String?
  chequeDate       DateTime
  amount           Int
  status           AccountChequeStatus
  financeAccountId String?
  clearedAt        DateTime?
  // WO 5.4 (§10.4) — วันที่นำฝากจริง (เช็ครับ ON_HAND→DEPOSITED) · ของเดิมเปลี่ยนแค่ status ไม่มีวันที่เก็บ
  // null = ยังไม่นำฝาก/แถวเก่าก่อน WO นี้ (V1 depositCheque ไม่เคยเซ็ต — ไม่กระทบพฤติกรรมเดิม)
  depositedAt      DateTime?
  note             String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  payment AccountDocumentPayment?

  @@index([systemId, direction, status])
}

// WO 5.4 (§10.5) — บันทึกการ "นำส่ง" ภ.ง.ด.3/53 ต่อ (systemId, form, periodKey)
// 1 แถว = 1 งวดที่ทำเครื่องหมายนำส่งแล้ว (form 3 = บุคคลธรรมดา · 53 = นิติบุคคล — เก็บเป็น Int ตรงกับ `pnd()`)
// totalBaseSatang/totalTaxSatang/certCount = ภาพนิ่ง ณ ตอนกดยืนยัน (คำนวณจาก pnd() สด — ไม่ increment
// ⇒ เรียกซ้ำ = เขียนทับค่าเดิมด้วยผลรวมเดิม = idempotent) · unmarkFiled ลบแถวนี้ทิ้ง + เคลียร์ whtFiledPeriodKey
model AccountWhtFiling {
  id               String   @id @default(cuid())
  tenantId         String
  systemId         String
  form             Int // 3 | 53
  periodKey        String // "YYYY-MM"
  filedAt          DateTime @default(now())
  filedById        String?
  totalBaseSatang  Int
  totalTaxSatang   Int
  certCount        Int
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([systemId, form, periodKey])
  @@index([tenantId, systemId])
}

// V2 (WO 6.2 · §11.4): ทำเครื่องหมาย "ยื่น ภ.พ.30 แล้ว" ต่องวด — ใช้ในเช็กลิสต์ก่อนปิดงวด
// แยกตารางจาก AccountWhtFiling เพราะ form ของตัวนั้นเป็นเลขแบบ ภ.ง.ด. (3/53) และหน้า WHT ลิสต์ทุกแถวในตาราง
model AccountVatFiling {
  id              String   @id @default(cuid())
  tenantId        String
  systemId        String
  periodKey       String // "YYYY-MM"
  filedAt         DateTime @default(now())
  filedById       String?
  salesVatSatang  Int      @default(0)
  inputVatSatang  Int      @default(0)
  payableSatang   Int      @default(0) // ภาษีขาย − ภาษีซื้อ (ติดลบ = เครดิตยกไป)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([systemId, periodKey])
  @@index([tenantId, systemId])
}

// ───────── 4.5 ผังบัญชี + mapping ─────────
model AccountLedger {
  id               String                  @id @default(cuid())
  tenantId         String
  systemId         String
  code             String // "1150"
  name             String
  nameEn           String?
  type             AccountLedgerType
  cashflowActivity AccountCashflowActivity @default(OPERATING)
  parentId         String?
  parent           AccountLedger?          @relation("AccountLedgerTree", fields: [parentId], references: [id])
  children         AccountLedger[]         @relation("AccountLedgerTree")
  isSystem         Boolean                 @default(false)
  pinned           Boolean                 @default(false) // V2 (WO 0.3): ปักหมุดบัญชีที่ลงบ่อย
  archivedAt       DateTime?
  // ── V2 (WO 6.1 · SPEC §11.1 · §14 ข้อ 6) ผังบัญชี V2 ──
  description      String? // คำอธิบายบัญชี (แสดงในแผงขวาของผังบัญชี)
  defaultWhtRateBp Int? // อัตราหัก ณ ที่จ่ายเริ่มต้น (basis point: 300 = 3%) · null = ไม่ใช้กับบัญชีนี้
  defaultWhtType   String? // ประเภทเงินได้ตั้งต้นของ WHT (ค่าเดียวกับ AccountDocument.whtType)
  vatTreatment     String? // ประเภทภาษี (ฝั่งซื้อ): CLAIMABLE | NON_CLAIMABLE | PENDING_INVOICE · null = ไม่ระบุ
  level            Int? // 1 หมวด · 2 หมวดรอง · 3 หมวดย่อย · 4 บัญชี — null = คิดจากความยาวรหัส/parent ตอนอ่าน
  sortOrder        Int? // ลำดับแสดงในผังบัญชี (null = เรียงตามรหัส)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  journalLines AccountJournalLine[]
  mappings     AccountMapping[]
  docLines     AccountDocumentLine[]

  @@unique([systemId, code])
  @@index([systemId, type, archivedAt])
  @@index([systemId, pinned, archivedAt]) // V2: ผังบัญชีที่ปักหมุดขึ้นก่อน
}

model AccountMapping {
  id        String        @id @default(cuid())
  tenantId  String
  systemId  String
  key       String // §7.10: "AR" "AP" "VAT_OUTPUT" "VAT_INPUT" ... "SUSPENSE" + "DOC:{docType}"
  accountId String
  account   AccountLedger @relation(fields: [accountId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([systemId, key])
  @@index([systemId])
}

// ───────── 4.6 สมุดรายวัน (immutable — Σdebit == Σcredit) ─────────
model AccountJournalEntry {
  id             String               @id @default(cuid())
  tenantId       String
  systemId       String
  docNo          String // "JV-2026-07-0001"
  book           AccountJournalBook
  journal        AccountJournalType
  date           DateTime
  periodKey      String // "2026-07"
  refType        String? // "AccountDocument" | "AccountDocumentPayment" | "AccountDepreciation" | "PosSale"
  refId          String?
  memo           String?
  source         AccountEntrySource
  status         AccountEntryStatus   @default(POSTED)
  needsReview    Boolean              @default(false)
  // V2 (WO 6.2 · §11.2): เหตุผลของธง ⚑ "ต้องตรวจ" ที่คนติด/ปลดเอง (tooltip บนตารางสมุดรายวัน)
  flagNote       String?
  idempotencyKey String?
  reversalOfId   String?              @unique
  reversalOf     AccountJournalEntry? @relation("AccountReversal", fields: [reversalOfId], references: [id])
  reversedBy     AccountJournalEntry? @relation("AccountReversal")
  postedById     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  lines AccountJournalLine[]

  @@unique([systemId, docNo])
  @@unique([tenantId, idempotencyKey])
  @@index([systemId, periodKey, book])
  @@index([systemId, date])
  @@index([refType, refId])
  @@index([systemId, needsReview])
}

model AccountJournalLine {
  id        String              @id @default(cuid())
  tenantId  String
  systemId  String // denormalized — งบ query ตรงไม่ join
  entryId   String
  entry     AccountJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   AccountLedger       @relation(fields: [accountId], references: [id])
  debit     Int                 @default(0)
  credit    Int                 @default(0)
  contactId String?
  note      String?

  // ───── V2 (WO 5.3 · §10.2): กระทบยอดธนาคาร — ทำเครื่องหมายที่ "บรรทัด" ไม่ใช่ทั้ง entry
  // (JV โอนระหว่างช่องทางมีบรรทัดธนาคาร 2 บัญชี ⇒ ระดับ entry จะทับกัน)
  reconciledAt              DateTime?
  reconciledStatementLineId String?   @unique // 1 บรรทัดสมุดรายวัน = 1 แถว statement

  @@index([entryId])
  @@index([systemId, accountId])
  @@index([systemId, contactId, accountId])
  @@index([systemId, accountId, reconciledAt]) // "รายการที่กระทบยอดแล้ว" ต่อช่องทาง
}

model AccountPeriod {
  id         String              @id @default(cuid())
  tenantId   String
  systemId   String
  periodKey  String // "2026-07"
  status     AccountPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  // V2 (WO 6.2 · §11.4): ผลเช็กลิสต์ก่อนปิด ณ เวลาที่ปิด (snapshot — auditor ย้อนดูได้ว่าปิดตอนสถานะไหน)
  checklist  Json?
  // V2 (WO 6.2): เวลาเปิดงวดใหม่ครั้งล่าสุด (รายละเอียดเต็มยังอยู่ใน reopenLog)
  reopenedAt DateTime?
  reopenLog  Json                @default("[]")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([systemId, periodKey])
}

// ───────── 4.7 สินทรัพย์ + ค่าเสื่อม ─────────
model AccountFixedAsset {
  id               String             @id @default(cuid())
  tenantId         String
  systemId         String
  code             String // "FA-0001"
  name             String
  category         String?
  acquiredDate     DateTime
  startDepDate     DateTime
  cost             Int
  salvageValue     Int                @default(100)
  usefulLifeMonths Int
  assetAccountId   String // 16xx
  accumAccountId   String // 16x9
  expenseAccountId String // 6800
  sourceDocumentId String?
  status           AccountAssetStatus @default(ACTIVE)
  disposedAt       DateTime?
  // V2 (WO 6.2 · §11.5): วิธีจำหน่าย "SELL" (ขาย) | "WRITE_OFF" (ตัดบัญชี) — เดิมรู้ได้แค่จาก status
  disposalMethod   String?
  disposalAmount   Int?
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  depreciations AccountDepreciation[]

  @@unique([systemId, code])
  @@index([systemId, status])
}

model AccountDepreciation {
  id        String            @id @default(cuid())
  tenantId  String
  systemId  String
  assetId   String
  asset     AccountFixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodKey String
  amount    Int
  entryId   String?
  createdAt DateTime          @default(now())

  @@unique([assetId, periodKey])
  @@index([systemId, periodKey])
}

// ───────── 4.8 คลังเอกสาร + เชื่อมระบบ ─────────
model AccountAttachment {
  id           String           @id @default(cuid())
  tenantId     String
  systemId     String
  documentId   String?
  document     AccountDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder       String?
  // V2 (WO 6.2 · §11.2): ผูกไฟล์แนบกับ "อย่างอื่นที่ไม่ใช่เอกสาร" — ตอนนี้ใช้กับ JV มือ
  // (refType = "AccountJournalEntry") · ของเดิมผูกผ่าน documentId เท่านั้น จึงแนบไฟล์เข้า JV ไม่ได้
  refType      String?
  refId        String?
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime         @default(now())

  // ═════ V2 (WO 7.1 · DESIGN-SPEC-V2 §12) — คลังเอกสาร: แท็บสถานะ + จำแนกชนิด + dedupe + ลบนุ่ม ═════
  // docTypeHint: ป้ายประเภทที่ตั้ง/เดาไว้ก่อนผูกเอกสารจริง — ค่าที่ใช้จริง: "REVENUE" | "EXPENSE" | "GENERAL"
  //   หรือรหัส AccountDocType ตรง ๆ ถ้าเจาะจงได้ (เช่น "EXPENSE","PURCHASE_TAX_INVOICE","INVOICE")
  //   หลังผูกเอกสารแล้ว หน้าจอคำนวณป้ายจริงจาก document.docType เสมอ ไม่ใช้ hint นี้ต่อ (แต่ยังเก็บไว้เผื่อแยกออกภายหลัง)
  docTypeHint  String?
  // status: UNLINKED (ค่าเริ่มต้นตอนสร้าง documentId=null) · LINKED (ผูกแล้ว) · NOT_ACCOUNTING (ผู้ใช้บอกว่าไม่ใช่เอกสารบัญชี)
  //   · ARCHIVED (ลบนุ่ม — ไม่มีทางลบไฟล์จริงทิ้ง) — null = แถวเก่าก่อน WO 7.1 (ของเดิมไม่มีแนวคิดสถานะ)
  status       String?
  // source: ไฟล์เข้ามาทางไหน — UPLOAD (ผู้ใช้อัปโหลดเอง) · EMAIL/CHAT (กล่องขาเข้า WO 7.2) · APP (ถ่ายบิลจากแอป)
  source       String?
  // thumbUrl: รูปย่อ — ตอนนี้ยังไม่มีบริการย่อรูปจริง จึงเท่ากับ fileUrl สำหรับไฟล์รูป (pdf = null ใช้ไอคอนแทน)
  thumbUrl     String?
  // sha256: hash เนื้อไฟล์ — dedupe ไฟล์เดิมที่อัปโหลดซ้ำภายในระบบเดียวกัน (ไม่ข้ามระบบ/ไม่ข้าม tenant)
  sha256       String?
  // archivedAt: เวลาที่ "ลบ" (ลบนุ่มเสมอ — ไม่มี hard delete ของไฟล์คลังเอกสาร)
  archivedAt   DateTime?
  note         String?
  // ═════ V2 (WO 7.2 · DESIGN-SPEC-V2 §12 "กล่องขาเข้า" · BLUEPRINT §0.3(6)) — AI อ่านบิลจากรูป ═════
  // aiExtract: ผลอ่านบิล (JSON ตาม BillExtract ใน inbox-ai.ts — ผู้ขาย/ยอด/VAT/เลขที่ใบกำกับ/บรรทัดสินค้า/ความมั่นใจ)
  //   เก็บทั้งก้อนไว้ที่นี่ **ไม่แตกเป็นคอลัมน์** เพราะเป็น "ข้อเสนอของ AI" ไม่ใช่ข้อมูลบัญชี — ของจริงเกิดตอนกด
  //   "สร้างบันทึกค่าใช้จ่าย" แล้วเข้า AccountDocument (ที่นั่นตรวจ/แก้ได้และมี GL) · เปลี่ยนสคีมาผลอ่านได้โดยไม่ต้อง migrate
  aiExtract    Json?
  // aiStatus: PENDING (กำลังอ่าน) · DONE · FAILED (อ่านแล้วตีความไม่ได้) · UNSUPPORTED (ชนิดไฟล์อ่านไม่ได้ เช่น PDF)
  //   · SKIPPED (ไม่ได้เรียก AI เลย — ปิดผู้ช่วย/เครดิตหมด) · null = ยังไม่เคยสั่งอ่าน
  aiStatus     String?
  aiModel      String? // โมเดลที่อ่านจริง (เก็บไว้ตรวจย้อนหลังว่าเลขชุดนี้มาจากโมเดลไหน)
  // ค่าใช้จ่ายของการอ่านครั้งล่าสุด เป็น "สตางค์" — มิเตอร์จริงคิดเป็นไมโครดอลลาร์ (AiCreditTxn)
  // ที่นี่แปลงเป็นเงินไทยด้วยเรทคงที่ (inbox-ai.ts THB_PER_USD) เพื่อ **แสดงให้เจ้าของร้านอ่านออก** เท่านั้น
  // 🔴 ห้ามใช้ค่านี้ไปลงบัญชี/เรียกเก็บเงิน — ตัวเลขที่เก็บเงินจริงคือ AiCreditTxn.amountMicro
  aiCostSatang Int?
  aiReadAt     DateTime?
  // senderLabel: "ผู้ส่ง" ที่แสดงบนการ์ด g15 (ชื่อลูกค้าจากแชท / อีเมลต้นทาง / ชื่อผู้ถ่ายบิลจากแอป)
  //   ต่างจาก uploadedById ตรงที่ผู้ส่งอาจไม่ใช่ผู้ใช้ในระบบ (ลูกค้าที่ทักไลน์เข้ามา)
  senderLabel  String?
  // sourceRef: id ฝั่งต้นทาง (ChatMessage.id / Message-ID ของอีเมล) — กันรับซ้ำเมื่อ outbox replay
  sourceRef    String?
  // expenseDocId: เอกสารรายจ่ายที่ "สร้างจากไฟล์นี้" (createExpenseFromAttachment) — documentId ผูกไฟล์กับเอกสาร
  //   ได้หลายทาง (ผูกมือ/แนบตอนแก้เอกสาร) ช่องนี้บอกเฉพาะที่เกิดจากกล่องขาเข้า → กดสร้างซ้ำไม่ได้ + วัดผลได้
  expenseDocId String?

  @@unique([systemId, sourceRef]) // Postgres ถือ NULL ต่างกันเสมอ ⇒ ไฟล์ที่อัปโหลดเอง (sourceRef=null) ไม่ชนกัน
  @@index([systemId, documentId])
  @@index([systemId, folder])
  @@index([systemId, refType, refId])
  @@index([systemId, status, createdAt])
  @@index([systemId, aiStatus])
}

model AccountSystemLink {
  id         String            @id @default(cuid())
  tenantId   String
  systemId   String // ระบบบัญชีชุดนี้
  linkedKind AccountLinkedKind
  linkedId   String // AppSystem.id (POS) | BusinessUnit.id (business)
  config     Json              @default("{}")
  // ── V2 (WO 8.3): "ตัดการเชื่อม" แบบไม่ลบแถว (ตัวเลือก/ประวัติยังอยู่ · เชื่อมกลับได้เหมือนเดิม)
  //    false = ไม่ลงบัญชีให้ (กติกาความปลอดภัยของ §9.5: ไม่เชื่อม = ไม่ลงบัญชีให้)
  enabled     Boolean  @default(true)
  /** ผู้ที่แก้การเชื่อมต่อครั้งล่าสุด (User.id) — ไว้ตามรอยคู่กับ AuditLog */
  updatedById String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([systemId, linkedKind, linkedId])
  @@index([linkedKind, linkedId])
}

// ═════════ V2 (WO 5.3 · DESIGN-SPEC-V2 §10.2 · เฟรม g10) — กระทบยอดธนาคาร ═════════
// สถานะแถว statement: รอจับคู่ · แนะนำจับคู่ (ยอดตรงแต่วันคลาด/มีหลายตัวเลือก) · จับคู่แล้ว ·
//                     สร้างรายการแล้ว (ค่าธรรมเนียม/ดอกเบี้ย) · ข้าม
enum AccountBankStatementLineStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  CREATED
  SKIPPED
}

// รายการเดินบัญชี 1 งวด/1 ช่องทาง (นำเข้าจาก CSV ของธนาคาร) — 1 ช่องทาง 1 เดือน มีได้ใบเดียว
// (นำเข้าไฟล์เดิมซ้ำ = เติมแถวใหม่ที่ยังไม่มีลงใบเดิม ไม่สร้างใบใหม่ · กันซ้ำด้วย fingerprint)
model AccountBankStatement {
  id                   String    @id @default(cuid())
  tenantId             String
  systemId             String
  financeId            String // AccountFinance (ช่องทางประเภทธนาคาร/e-Wallet)
  periodKey            String // "2026-09"
  source               String // "KBANK" | "SCB" | "KTB" | "BBL" | "GENERIC"
  fileName             String
  importedAt           DateTime  @default(now())
  importedById         String?
  openingBalanceSatang Int? // ยอดยกมาต้นงวดตาม statement (ถ้าไฟล์มีคอลัมน์ยอดคงเหลือ)
  closingBalanceSatang Int // ยอดปลายงวดตาม statement (คอลัมน์ยอดคงเหลือแถวสุดท้าย หรือ opening + Σ)
  rowCount             Int       @default(0)
  confirmedAt          DateTime? // ยืนยันกระทบยอดเดือนนี้ (ล็อกงวด — ส่วนต่างต้องเป็น 0)
  confirmedById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lines AccountBankStatementLine[]

  @@unique([financeId, periodKey])
  @@index([systemId, financeId, periodKey])
}

model AccountBankStatementLine {
  id                 String               @id @default(cuid())
  statementId        String
  statement          AccountBankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  tenantId           String
  systemId           String
  financeId          String // denormalize — unique fingerprint/ดัชนีค้นหาไม่ต้อง join
  seq                Int // ลำดับแถวในไฟล์ (1,2,3…) — ใช้เรียงเมื่อวันที่ซ้ำ
  txDate             DateTime
  description        String
  refNo              String?
  amountSatang       Int // เซ็นชื่อ: + = เงินเข้า · − = เงินออก
  balanceAfterSatang Int?
  // hash ของ วันที่|จำนวน|รายละเอียด|อ้างอิง|ลำดับที่ซ้ำ — นำเข้าไฟล์เดิมซ้ำ = 0 แถวใหม่
  // (แถวที่เหมือนกันเป๊ะจริง ๆ ในไฟล์เดียวต่างกันที่ "ลำดับที่ซ้ำ" ⇒ ไม่ถูกกลืน)
  fingerprint        String

  status AccountBankStatementLineStatus @default(UNMATCHED)
  // ผูกกับ "บรรทัด" ของสมุดรายวัน ไม่ใช่ทั้ง entry — JV โอนระหว่างช่องทาง 1 ใบมีบรรทัดธนาคาร 2 บัญชี
  // ถ้าผูกระดับ entry จะชนกันเมื่อกระทบยอดทั้ง 2 ช่องทาง (ดู wo-notes/5.3.md "ต่างจาก WO")
  matchedLineId    String?
  matchedEntryId   String? // เก็บคู่ไว้เพื่อลิงก์ไปเอกสาร/ใบสำคัญโดยไม่ต้อง join
  suggestedLineId  String?
  suggestedEntryId String?
  suggestedHint    String? // "ยอดและวันที่ตรงกัน ±1 วัน" (g10)
  createdEntryId   String? // JV ที่สร้างจากแถวนี้ (ค่าธรรมเนียม/ดอกเบี้ย)
  skipReason       String?
  matchedAt        DateTime?
  matchedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([financeId, fingerprint])
  @@unique([financeId, matchedLineId]) // กันบรรทัดสมุดรายวันเดียวถูกจับคู่ 2 แถว (NULL ซ้ำได้ตามมาตรฐาน Postgres)
  @@index([systemId, statementId, txDate])
  @@index([systemId, financeId, status])
}
