// Account (บัญชี) — ระบบเอกสารฝั่งรายรับ (P1)
// scope = feature: ทุกตารางผูก tenantId + systemId (systemId = AppSystem type ACCOUNT)
// เงิน = Int สตางค์ · id cuid() · เอกสารเงิน immutable (พ้น DRAFT แก้ไม่ได้ → void/reissue)
// Pipeline: ใบเสนอราคา → ใบแจ้งหนี้ → ใบเสร็จ/ใบกำกับภาษี
// Defer P2+: ฝั่งรายจ่าย, journal/posting, งบการเงิน, WHT, เช็ค, สินทรัพย์

enum AccountDocType {
  QUOTATION // ใบเสนอราคา
  INVOICE // ใบแจ้งหนี้/ใบส่งของ
  RECEIPT // ใบเสร็จรับเงิน
  TAX_INVOICE // ใบกำกับภาษีขาย
  TAX_INVOICE_ABB // ใบกำกับอย่างย่อ (POS link) — P2
  DEPOSIT_RECEIPT // ใบรับเงินมัดจำ
  CREDIT_NOTE // ใบลดหนี้
  DEBIT_NOTE // ใบเพิ่มหนี้
  BILLING_NOTE // ใบวางบิล
  // ── รายจ่าย (P2) ──
  PURCHASE // บันทึกซื้อสินค้า
  EXPENSE // บันทึกค่าใช้จ่าย
  PURCHASE_ORDER // ใบสั่งซื้อ (PO)
  ASSET_PURCHASE_ORDER // ใบสั่งซื้อสินทรัพย์
  ASSET_PURCHASE // ซื้อสินทรัพย์
  PURCHASE_TAX_INVOICE // ใบกำกับภาษีซื้อ (ทะเบียนรับ)
  DEPOSIT_PAYMENT // ใบจ่ายเงินมัดจำ
  CREDIT_NOTE_RECEIVED // รับใบลดหนี้
  DEBIT_NOTE_RECEIVED // รับใบเพิ่มหนี้
  COMBINED_PAYMENT // ใบรวมจ่าย
  GOODS_ISSUE // ใบเบิกสินค้า
  GOODS_ISSUE_RETURN // ใบส่งคืนเบิกสินค้า
  COST_ADJUSTMENT // ใบปรับต้นทุนสินค้า (CA — V2 WO 4.3 · SPEC §8.4)
  WHT_CERT // หนังสือรับรองหัก ณ ที่จ่าย (50 ทวิ)
}

enum AccountDocStatus {
  DRAFT
  AWAITING_ACCEPT // ใบเสนอราคา รอตอบรับ
  ACCEPTED
  REJECTED
  AWAITING_APPROVAL // PO/ใบสั่งซื้อสินทรัพย์ รออนุมัติ
  APPROVED
  AWAITING_PAYMENT // รอชำระเงิน
  PARTIAL // ชำระบางส่วน
  PAID // ชำระครบ
  AWAITING_DEDUCT // มัดจำ รอหัก
  DEDUCTED // มัดจำถูกหักครบ
  AWAITING_RECEIVE // ใบกำกับภาษีซื้อ/ซื้อสินทรัพย์ รอรับตัวจริง
  RECEIVED // รับใบกำกับ/ใบเสร็จแล้ว
  ISSUED // ใบกำกับ/ใบลด-เพิ่มหนี้/ใบวางบิล มีผลแล้ว
  VOIDED // เคยมีผล + ถูกยกเลิก
  CANCELLED // ยกเลิกก่อนมีผล (ยกเลิก DRAFT)
}

enum AccountVatMode {
  INCLUDE // ราคารวม VAT แล้ว
  EXCLUDE // ราคายังไม่รวม VAT
  NONE // ไม่มี VAT
}

enum AccountDocDirection {
  IN // รายจ่าย (P2)
  OUT // รายรับ
  INTERNAL
}

enum AccountRelationType {
  CONVERT // แปลงเอกสาร (QT→IV→RE)
  DEPOSIT_APPLY // หักมัดจำ
  ADJUST // ใบลดหนี้/เพิ่มหนี้อ้างใบเดิม
  BILL // ใบวางบิลรวมหลายใบแจ้งหนี้
  PAY_GROUP // ใบรวมจ่ายรวมหลายบันทึกซื้อ (ฝั่งจ่าย)
  TAX_FOR // ใบกำกับภาษีของเอกสารต้นทาง
  REPLACE // ออกใบแทน (void + reissue)
}

enum AccountPayChannel {
  CASH
  TRANSFER
  PROMPTPAY
  CARD
  E_WALLET
  CHEQUE
  DEPOSIT_APPLY
  CREDIT_APPLY
  OTHER
}

enum AccountContactKind {
  CUSTOMER
  VENDOR
  BOTH
}

enum AccountLegalType {
  PERSON
  COMPANY
}

// ── V2 (WO 0.3) ──────────────────────────────────────────────────────────────
// ที่มาของเอกสาร — ใช้แยกว่าใบนี้คนพิมพ์เอง หรือไหลมาจากระบบอื่น/AI (SPEC §14.1)
enum AccountDocSource {
  MANUAL // คนสร้างเอง (ค่าเดิมของทุกแถวก่อน V2)
  AI // ผู้ช่วย AI สร้างให้
  IMPORT // นำเข้าไฟล์
  INBOX // กล่องขาเข้า (บิลที่ส่งเข้ามา/อ่านด้วย AI)
  CRM // ไหลมาจาก CRM (ใบเสนอราคาจากดีล)
  POS // ไหลมาจากขายหน้าร้าน
  RECURRING // เอกสารประจำงวด (สร้างอัตโนมัติ)
}

// โหมดราคาที่ผู้ใช้ "คิด" ตอนกรอก — คนละชั้นกับ AccountVatMode ที่เป็นผลลัพธ์ในเอกสาร
// (เก็บเป็น null = ยังไม่เคยเลือก → ใช้ค่าจากตั้งค่า/พฤติกรรมเดิม)
enum AccountPriceMode {
  EXCL_VAT // ราคายังไม่รวม VAT
  INCL_VAT // ราคารวม VAT แล้ว
  NO_VAT // ไม่มี VAT
}

// ส่วนลดท้ายบิลกรอกเป็นจำนวนเงินหรือเปอร์เซ็นต์ (ตัวเลขจริงยังเก็บใน discountAmount = สตางค์)
enum AccountDiscountMode {
  AMOUNT
  PERCENT
}

// ───────────── เอกสาร (แกนระบบ — polymorphic docType) ─────────────

model AccountDocument {
  id              String                @id @default(cuid())
  tenantId        String
  systemId        String
  docType         AccountDocType
  docNo           String? // จองตอน issue (DRAFT = null → NULL distinct ใน pg)
  status          AccountDocStatus      @default(DRAFT)
  direction       AccountDocDirection   @default(OUT)
  issueDate       DateTime              @default(now())
  dueDate         DateTime? // ครบกำหนดชำระ
  validUntil      DateTime? // ใบเสนอราคา: ยืนราคาถึง
  contactId       String?
  contact         AccountContact?       @relation(fields: [contactId], references: [id])
  contactSnapshot Json? // freeze ชื่อ/ที่อยู่/เลขภาษี ณ วันออก (พ้น DRAFT)
  // ── ยอดเงิน (สตางค์) ──
  vatMode         AccountVatMode        @default(EXCLUDE)
  vatTiming       AccountVatTiming      @default(ON_ISSUE) // จุดรับรู้ภาษีขาย (สินค้า/บริการ)
  subTotal        Int                   @default(0) // Σ บรรทัดหลังส่วนลดบรรทัด (ฐานก่อน VAT)
  discountAmount  Int                   @default(0) // ส่วนลดท้ายบิล
  vatAmount       Int                   @default(0)
  whtAmount       Int                   @default(0) // WHT preview (ตัวจริงอยู่ payment)
  depositDeducted Int                   @default(0) // Σ มัดจำที่หักในใบนี้
  grandTotal      Int                   @default(0) // สุทธิที่ต้องชำระ
  paidTotal       Int                   @default(0) // Σ payment
  // ── อ้างอิง ──
  sourceDocId     String? // เอกสารต้นทางที่แปลงมา (quotation→invoice→receipt)
  sourcePaymentId String? // QC5-A1: ใบกำกับภาษี(บริการ) ออกต่อ payment งวดที่รับ (1 payment = 1 ใบกำกับ)
  taxPointBasis   AccountVatTiming? // QC5-A1: จุดรับรู้ภาษี (GOODS=ON_ISSUE / SERVICE=ON_PAYMENT)
  refSystemId     String? // ระบบต้นทาง (POS system / business unit) เมื่อไหลจาก link
  refType         String? // ชื่อ Prisma model ตรงตัว (เช่น "PosSale")
  refId           String?
  categoryId      String? // กลุ่มจัดประเภท
  category        AccountCategory?      @relation(fields: [categoryId], references: [id])
  note            String? // หมายเหตุบนเอกสาร (พิมพ์)
  internalNote    String? // โน้ตภายใน
  adjustReason    String? // CN/DN: เหตุผลตามประกาศสรรพากร · V2 WO 4.3: ใบเบิก = "สาเหตุการเบิก" · CA = "เหตุผลการปรับ"
  /// V2 (WO 4.3 · SPEC §8.4) — บัญชีคู่ของเอกสารปรับปรุงสต็อก/ต้นทุน (รหัสบัญชี 6 หลัก)
  ///   ใบเบิก PRR = "ค่าใช้จ่ายที่ปรับปรุง" ขา Dr (ค่าเริ่มต้น 5300)
  ///   ใบปรับต้นทุน CA = บัญชีกำไร/ขาดทุนจากการปรับมูลค่า (ค่าเริ่มต้น 5310)
  ///   null = ใช้ค่าเริ่มต้นจาก mapping key ตอนโพสต์
  adjustAccountCode String?
  whtIncomeType   AccountWhtIncomeType? // WHT_CERT: ประเภทเงินได้ ม.40
  whtRateBp       Int? // WHT_CERT: basis point (300 = 3%)
  // WO 5.4 (§10.5) — WHT_CERT (direction IN = 50 ทวิที่เราหักผู้ขาย) ที่ถูก "ทำเครื่องหมายนำส่งแล้ว"
  // ค่า = "<form>:<periodKey>" เช่น "53:2026-09" (ยื่น ภ.ง.ด.53 งวด ก.ย. 69) · null = ยังไม่ยื่น
  // เขียนครั้งเดียวตอน markFiled (idempotent ต่อ (form, periodKey) — ดู wht.ts) · เอกสารชนิดอื่นไม่ใช้ฟิลด์นี้
  whtFiledPeriodKey String?
  etaxStatus      AccountEtaxStatus     @default(NOT_SENT) // P4
  etaxMeta        Json? // P4: {providerId, xmlUrl, sentAt, error}
  pdfUrl          String?
  publicToken     String?               @unique // ลิงก์สาธารณะ
  acceptedAt      DateTime? // ใบเสนอราคา accepted
  approvedById    String? // PO/APO: ผู้อนุมัติ
  replacedById    String?               @unique // ใบใหม่ที่ออกแทน (คู่ relation REPLACE)
  voidedAt        DateTime?
  voidReason      String?
  createdById     String?
  // ── V2 (WO 0.3) · additive ทั้งหมด — แถวเดิมได้ MANUAL / [] / null = พฤติกรรมเดิมเป๊ะ ──
  source          AccountDocSource      @default(MANUAL) // ที่มาของเอกสาร (SPEC §14.1)
  tags            String[]              @default([]) // ป้ายกำกับอิสระของผู้ใช้
  priceMode       AccountPriceMode? // โหมดราคาที่ผู้ใช้เลือกตอนกรอก (null = ตามตั้งค่า)
  discountMode    AccountDiscountMode? // ส่วนลดท้ายบิลกรอกแบบเงิน/เปอร์เซ็นต์ (null = เงิน)
  salesUserId     String? // พนักงานขายเจ้าของใบ (รายงานยอดขายรายคน)
  // ── V2 (WO 1.3 · ฟอร์ม DocEditorV2 §5.2 B) · additive · nullable ──
  reference       String? // "อ้างอิง" ที่ผู้ใช้พิมพ์ (เลข PO ลูกค้า / เอกสารต้นทาง) ≤35 ตัว
  autoTaxInvoice  Boolean? // toggle "ออกใบกำกับภาษีพร้อมกัน" ต่อใบ (null = ตามตั้งค่ากิจการ §9.2)

  lines         AccountDocumentLine[]
  payments      AccountDocumentPayment[]
  paymentRequests AccountPaymentRequest[] // WO 5.5 — คำขอชำระเงิน (ลิงก์+QR PromptPay)
  attachments   AccountAttachment[]
  relationsFrom AccountDocumentRelation[] @relation("AccountRelFrom")
  relationsTo   AccountDocumentRelation[] @relation("AccountRelTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemId, docType, docNo])
  @@index([systemId, docType, status, issueDate])
  @@index([systemId, docType, dueDate])
  @@index([systemId, contactId, docType])
  @@index([systemId, direction, issueDate])
  @@index([systemId, docType, source]) // V2: กรอง "มาจากไหน" ในหน้ารายการ
  @@index([tenantId, systemId])
  // WO 5.4: หา WHT_CERT ที่ยังไม่ยื่นของ (systemId, docType) เร็ว — ใช้ตอน markFiled คำนวณผลรวมใหม่
  @@index([systemId, docType, whtFiledPeriodKey])
}

model AccountDocumentLine {
  id            String                @id @default(cuid())
  tenantId      String
  systemId      String
  documentId    String
  document      AccountDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder     Int                   @default(0)
  description   String
  qty           Decimal               @default(1) @db.Decimal(12, 4)
  unitName      String?
  unitPrice     Int // สตางค์/หน่วย
  discount      Int                   @default(0) // ส่วนลดบรรทัด (สตางค์)
  vatRateBp     Int                   @default(700) // 700 = 7% | 0 = 0% | -1 = ยกเว้น
  amount        Int // qty×unitPrice − discount (ฐานบรรทัด)
  productId     String? // เลือกจากทะเบียนสินค้า/บริการ
  product       AccountProduct?       @relation(fields: [productId], references: [id])
  accountId     String? // override บัญชี GL (EXPENSE บังคับเลือกหมวด)
  account       AccountLedger?        @relation(fields: [accountId], references: [id])
  assetId       String? // ASSET_PURCHASE: ผูกทะเบียนสินทรัพย์หลังขึ้นทะเบียน
  // ── V2 (WO 1.3) · additive · nullable ทั้งคู่ = แถวเดิม/โค้ดเดิมพฤติกรรมไม่เปลี่ยน ──
  // หัก ณ ที่จ่าย "ต่อบรรทัด" (DESIGN-SPEC-V2 §5.2 C) — ฟอร์ม V2 เก็บสิ่งที่ผู้ใช้เลือกไว้
  // เพื่อให้เปิดร่างกลับมาแก้แล้วค่าไม่หาย · **การสร้าง WHT_CERT/JV จริงยังเป็นงาน WO 1.4**
  whtIncomeType AccountWhtIncomeType? // ประเภทเงินได้ ม.40
  whtRateBp     Int? // 300 = 3%
  // ── V2 (WO 4.3) · additive · nullable = แถวเดิม/โค้ดเดิมไม่กระทบ ──
  /// ต้นทุน/หน่วย (สตางค์) ของบรรทัดนี้ — ใช้กับเอกสารปรับปรุงสต็อกเท่านั้น:
  ///   ใบเบิก PRR/ใบส่งคืน RPR = ต้นทุนที่ตัด/คืนจริงตอนอนุมัติ (มาจาก InvMovement.costSatang)
  ///   ใบปรับต้นทุน CA = **ต้นทุนเดิม** ก่อนปรับ (ต้นทุนใหม่เก็บที่ `unitPrice`)
  unitCost      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, sortOrder])
  @@index([systemId, productId])
}

model AccountDocumentPayment {
  id               String            @id @default(cuid())
  tenantId         String
  systemId         String
  documentId       String
  document         AccountDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paidAt           DateTime          @default(now())
  channel          AccountPayChannel @default(TRANSFER)
  financeAccountId String? // บัญชีเงินที่เข้า/ออก (null เฉพาะ DEPOSIT_APPLY/CREDIT_APPLY)
  financeAccount   AccountFinance?   @relation(fields: [financeAccountId], references: [id])
  amount           Int // เงินที่เข้า/ออกจริง (ไม่รวม WHT)
  whtAmountSatang  Int               @default(0) // WHT ถูกหัก (รับ) / หักเขา (จ่าย)
  whtRateBp        Int?
  whtCertDocId     String?           @unique // Document(WHT_CERT) ที่ออกให้ vendor
  feeAmount        Int               @default(0) // ค่าธรรมเนียมโอน/gateway
  chequeId         String?           @unique
  cheque           AccountCheque?    @relation(fields: [chequeId], references: [id])
  entryId          String? // AccountJournalEntry ของการชำระ (ไม่ unique — ใบวางบิล/รวมจ่าย 1 entry หลาย payment ได้, Gate B-M4)
  // WO 1.4: กันบันทึกรับ/จ่ายซ้ำจากการกดปุ่มซ้ำ/รีทราย (คีย์ที่ฝั่งเรียกสร้าง เช่น "<docId>:<n>:<hash>")
  // null = ไม่คุม (ทางเรียกเดิมทั้งหมด) ⇒ แถวเดิมพฤติกรรมไม่เปลี่ยน
  idempotencyKey   String?           @unique
  note             String?
  voidedAt         DateTime?
  voidReason       String?
  createdById      String?

  // ───── V2 (WO 5.2 · §10.3 "เบิกชดเชย"): เชื่อมรายการจ่ายที่จ่ายจากบัญชีสำรองรับ-จ่าย (PETTY_CASH)
  // กับการโอนเงินเข้าบัญชีนั้นที่เติมชดเชยให้ — nullable column บน payment เดิม (ตามกติกา WO: ห้ามเพิ่มตารางใหม่
  // ถ้าเพิ่มคอลัมน์พอ) แทนสร้างตารางกลาง ไม่ผูก relation จริงกับ AccountFinanceTransfer (คนละ table คนละ scope)
  // — เก็บแค่ id ไว้เผื่อ query ย้อน · reimbursedAt = null คือ "ยังไม่เบิกชดเชย"
  reimbursedAt         DateTime?
  reimbursedTransferId String?

  // ───── V2 (WO 5.5 · §0.3 ข้อ 5 "ลิงก์+QR PromptPay"): คำขอชำระเงินที่ทำให้เกิดรายการรับเงินนี้
  // nullable = แถวเดิม/ทางเรียกเดิมทั้งหมดไม่เปลี่ยนพฤติกรรม · ไม่ผูก relation จริง (อ่านย้อนผ่าน id พอ
  // และกันวงจร relation กับ AccountPaymentRequest ที่ชี้กลับมาที่ payment ด้วย paymentId)
  paymentRequestId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId, paidAt])
  @@index([documentId])
  // WO 5.2: หา "รายการที่จ่ายจากกล่องนี้ ยังไม่เบิกชดเชย" เร็ว (เบิกชดเชย modal — เลือกช่องทาง + filter reimbursedAt null)
  @@index([systemId, financeAccountId, reimbursedAt])
  // WO 5.5: หา "รายการรับเงินของคำขอชำระเงินใบนี้" เร็ว (หน้าเอกสาร + ตัวกันซ้ำ)
  @@index([systemId, paymentRequestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WO 5.5 · §0.3 ข้อ 5 — "ส่งลิงก์+QR PromptPay ให้ลูกค้า → จ่ายแล้วกระทบยอดอัตโนมัติ"
//
// 2 โหมด (เลือกให้เองตามว่าแพลตฟอร์มตั้งกุญแจ Beam ไว้หรือยัง):
//   PROMPTPAY_BEAM   = มี BEAM_MERCHANT_ID/API_KEY/WEBHOOK_SECRET → สร้าง charge จริง · webhook ยืนยัน
//                      → บันทึกรับชำระ + JV + จับคู่ statement ให้อัตโนมัติ
//   PROMPTPAY_STATIC = ยังไม่มีกุญแจ → QR PromptPay นิ่ง (EMVCo ล็อกยอด) ไม่มี webhook
//                      → ยืนยันเองที่หน้าเอกสาร **หรือ** ให้ตัวนำเข้า statement (WO 5.3) จับยอด+วันแล้วบันทึกให้
//
// token = 128 บิต (randomBytes(16).base64url) — ลิงก์สาธารณะ `/pay/<token>` คือ capability
// ห้ามใส่ id ที่เดาได้ลงใน URL และห้ามให้หน้าสาธารณะเปิดเผยข้อมูลลูกค้ารายอื่น
// ─────────────────────────────────────────────────────────────────────────────
enum AccountPaymentRequestMethod {
  PROMPTPAY_STATIC
  PROMPTPAY_BEAM
}

enum AccountPaymentRequestStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model AccountPaymentRequest {
  id         String  @id @default(cuid())
  tenantId   String
  systemId   String
  documentId String
  document   AccountDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// ช่องทางการเงินที่เงินจะเข้า (AccountFinance) — ใช้เป็น financeAccountId ตอนบันทึกรับชำระ
  financeId  String

  token           String @unique // url-safe · 128 บิต
  amountSatang    Int // ยอดที่ขอเก็บ ณ ตอนสร้าง (= ยอดคงค้างของเอกสาร)
  currency        String @default("THB")
  method          AccountPaymentRequestMethod
  provider        String? // "beam" เมื่อผ่านผู้ให้บริการ · null = QR นิ่ง
  providerChargeId String? @unique // charge ฝั่ง Beam — กันบันทึกซ้ำระดับฐานข้อมูล
  qrPayload       String? // สตริง EMVCo (static) — dynamic เก็บ URL ของ Beam

  status    AccountPaymentRequestStatus @default(PENDING)
  expiresAt DateTime

  paidAt           DateTime?
  paidAmountSatang Int?
  paymentId        String? // AccountDocumentPayment ที่บันทึกไว้ (null = ยังไม่จ่าย)
  statementLineId  String? // AccountBankStatementLine ที่จับคู่ให้ (ถ้ามาจากตัวนำเข้า statement)
  note             String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([systemId, documentId, status])
  // หา "คำขอ QR นิ่งที่ยังค้าง" ของช่องทางนี้ตอนนำเข้า statement (WO 5.3 autoMatch)
  @@index([systemId, financeId, status])
  @@index([tenantId, systemId])
}

model AccountDocumentRelation {
  id       String              @id @default(cuid())
  tenantId String
  systemId String
  fromId   String
  from     AccountDocument     @relation("AccountRelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId     String
  to       AccountDocument     @relation("AccountRelTo", fields: [toId], references: [id], onDelete: Cascade)
  type     AccountRelationType
  amount   Int?

  createdAt DateTime @default(now())

  @@unique([fromId, toId, type])
  @@index([systemId, type])
  @@index([toId])
}

// ───────────── เลขรันเอกสาร (จองใน tx เดียวกับ insert) ─────────────

model AccountDocSequence {
  id        String         @id @default(cuid())
  tenantId  String
  systemId  String
  docType   AccountDocType
  prefix    String
  periodKey String // "2026-07" | "2026" | "-"
  lastNo    Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemId, docType, periodKey])
}

// ───────────── ผู้ติดต่อ (ลูกค้า/ผู้ขาย) ─────────────

model AccountContact {
  id               String             @id @default(cuid())
  tenantId         String
  systemId         String
  kind             AccountContactKind @default(CUSTOMER)
  legalType        AccountLegalType   @default(COMPANY)
  name             String // ชื่อจดทะเบียน
  taxId            String? // 13 หลัก
  branchCode       String?            @default("00000")
  branchName       String?
  address          String?
  phone            String?
  email            String?
  creditTermDays   Int                @default(0) // 0 = เงินสด
  note             String?
  archivedAt       DateTime?
  // ── V2 (WO 0.3) · additive ทั้งหมด (SPEC §14.2) ──
  /// เบอร์รูปแบบเดียว (normalizePhoneTh) — คอลัมน์นี้คือกุญแจจับผู้ติดต่อซ้ำจากเบอร์
  /// ทุกจุดที่เขียน phone ต้องเขียนค่านี้ด้วย (service.contactWriteFields)
  phoneNorm        String?
  ownerUserId      String? // เจ้าของผู้ติดต่อ (ผู้ดูแลลูกค้ารายนี้)
  mergedIntoId     String? // ถูกรวมเข้ากับผู้ติดต่อใด (การรวมรายการซ้ำ — ไม่ลบของเดิม)
  defaultPriceMode AccountPriceMode? // โหมดราคาปริยายเวลาออกเอกสารให้รายนี้
  defaultWhtType   String? // ประเภทเงินได้ที่หัก ณ ที่จ่ายเป็นประจำ (ม.40 (…))
  defaultWhtRateBp Int? // อัตราหัก ณ ที่จ่ายปริยาย (basis point · 300 = 3%)
  bankAccountNote  String? // บัญชีธนาคารสำหรับโอนจ่าย (ข้อความอิสระ)
  // ── WO 3.1 — Party (INTEGRATION-MAP §F.1) ──
  /// เชื่อมตัวตนกลางระดับ tenant (nullable — ไม่มี = ทำงานเหมือนเดิม) ไม่ใส่ FK/relation ตามใบสั่งงาน
  partyId          String?
  // ── WO 3.3 — modal ผู้ติดต่อ พื้นฐาน/ขั้นสูง (DESIGN-SPEC-V2 §7.2 · ภาพ g5) · additive ล้วน ──
  /// เลขที่ผู้ติดต่อ "C00019" — เดิม WO 3.2 คำนวณสดจากลำดับ createdAt (เลขขยับเมื่อมีคนถูกลบ/เพิ่มย้อนหลัง)
  /// ตอนนี้เก็บจริงและแก้ได้ (SPEC §7.2 "auto C000xx · แก้ได้") · ความไม่ซ้ำบังคับที่ DB ด้วย
  /// **partial unique index** `AccountContact_systemId_code_active_key` (ดูเหตุผลเดียวกับ taxId ด้านล่าง)
  /// null = แถวเก่าที่ยังไม่ backfill → UI ถอยไปใช้เลขที่คำนวณสดของ WO 3.2 (ไม่มีอะไรพัง)
  code             String?
  /// ประเภทนิติบุคคล (บริษัทจำกัด · หจก. · บมจ. · อื่น ๆ) — ข้อความไทยตรงตามที่ผู้ใช้เลือก ไม่ใช่ enum
  legalEntityType  String?
  /// คำนำหน้าบุคคล (นาย/นาง/นางสาว/…) — ใช้กับ legalType = PERSON (g5 แยกช่องจาก legalEntityType)
  personTitle      String?
  /// ประเทศของเลขทะเบียน — "TH" = เลขไทย 13 หลัก (ตรวจ 13 หลัก) · อื่น ๆ = ต่างประเทศ (ไม่ตรวจรูปแบบ)
  taxIdCountry     String?            @default("TH")
  /// ประเภทสำนักงาน: UNSPECIFIED | HQ | BRANCH (คู่กับ branchCode 5 หลักที่มีอยู่แล้ว)
  officeType       String?
  // ที่อยู่แบบแยกช่อง (§7.2) — `address` เดิมยังอยู่และถูกเขียนเป็น "สตริงรวม" เสมอ
  // เพื่อให้การพิมพ์เอกสาร/ใบกำกับของเดิม (อ่าน `address`) ทำงานต่อได้โดยไม่ต้องแก้
  addressLine      String?
  subdistrict      String? // แขวง/ตำบล
  district         String? // เขต/อำเภอ
  province         String?
  postcode         String?
  country          String?            @default("TH")
  contactPerson    String? // ชื่อผู้ติดต่อในองค์กร (≤100)
  website          String?
  fax              String?
  lineId           String?
  /// แท็กอิสระ (array ของสตริง) — เก็บเป็น Json เหมือน Customer.tags (ไม่เพิ่มตาราง)
  tags             Json               @default("[]")
  /// บัญชีลูกหนี้/เจ้าหนี้เฉพาะราย — รหัสบัญชี 6 หลัก ใช้แทนค่าเริ่มต้น 1100/2000 (null = ใช้ค่าเริ่มต้น)
  arAccountCode    String?
  apAccountCode    String?

  documents      AccountDocument[]
  groups         AccountContactGroupMember[]
  /// WO 1.9 — กฎเอกสารประจำที่ออกให้ผู้ติดต่อรายนี้ (ลบผู้ติดต่อ → contactId ของกฎกลายเป็น null ตาม default ของ Prisma)
  recurringRules AccountRecurringRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId, kind, archivedAt])
  @@index([systemId, taxId])
  @@index([systemId, name])
  @@index([systemId, phoneNorm]) // V2: จับคู่ซ้ำจากเบอร์ (แทนการสแกนทั้งตาราง)
  @@index([partyId]) // WO 3.1
  /// 🔴 ของจริงที่บังคับความไม่ซ้ำคือ **partial unique index** ที่สร้างด้วย raw SQL ใน migration
  ///    20260902xxxxxx_account_v2_phase0:
  ///      CREATE UNIQUE INDEX "AccountContact_systemId_taxId_branchCode_active_key"
  ///        ON "AccountContact"("systemId","taxId","branchCode")
  ///        WHERE "taxId" IS NOT NULL AND "archivedAt" IS NULL;
  ///    Prisma แสดง partial index ไม่ได้ (@@unique ไม่มี where) — ถ้าประกาศ @@unique ตรง ๆ
  ///    จะกลายเป็น unique เต็มตาราง = ห้ามมีผู้ติดต่อที่ถูกเก็บซ้ำเลขภาษีเดิม ซึ่งผิดจากที่ต้องการ
  ///    ที่นี่จึงประกาศแค่ @@index (ให้ client มีดัชนีค้นหา) แล้วปล่อยความ "unique" ให้ DB
  ///    👉 `prisma migrate diff` มองไม่เห็น partial index นี้ → ห้ามลบออกจาก migration
  @@index([systemId, taxId, branchCode])
  /// 🔴 WO 3.3 — เหตุผลเดียวกันเป๊ะกับ taxId ด้านบน: ความไม่ซ้ำของ `code` ต่อระบบบังคับด้วย
  ///    **partial unique index** ใน migration 20260904060000_account_v2_contact_modal:
  ///      CREATE UNIQUE INDEX "AccountContact_systemId_code_active_key"
  ///        ON "AccountContact"("systemId","code")
  ///        WHERE "code" IS NOT NULL AND "archivedAt" IS NULL;
  ///    (ผู้ติดต่อที่ปิดใช้งานแล้วปล่อยให้เลขซ้ำได้ — เลขเดิมถูกนำกลับมาใช้ใหม่ได้)
  ///    👉 `prisma migrate diff` มองไม่เห็น → ห้ามลบออกจาก migration
  @@index([systemId, code])
}

// ───────────── กลุ่มผู้ติดต่อ (V2 · WO 0.3 — SPEC §14.2) ─────────────
// จัดกลุ่มลูกค้า/ผู้ขายแบบหลายกลุ่มต่อคน (ลูกค้าประจำ · ค้างชำระ · ตัวแทน …)

model AccountContactGroup {
  id        String   @id @default(cuid())
  tenantId  String
  systemId  String
  name      String
  color     String? // สีป้าย (token ของ UI — เก็บเป็นข้อความ)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  members AccountContactGroupMember[]

  @@unique([systemId, name])
  @@index([systemId, sortOrder])
}

model AccountContactGroupMember {
  id        String              @id @default(cuid())
  tenantId  String
  systemId  String
  groupId   String
  group     AccountContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   AccountContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([groupId, contactId])
  @@index([systemId, contactId])
}

// ───────────── ตั้งค่าเอกสาร/องค์กร (1 ต่อระบบ) ─────────────

model AccountSettings {
  id               String  @id @default(cuid())
  tenantId         String
  systemId         String  @unique
  orgName          String  @default("")
  orgNameEn        String?
  taxId            String?
  branchCode       String? @default("00000")
  branchName       String? @default("สำนักงานใหญ่")
  address          String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  vatRegistered    Boolean @default(true)
  vatRateBp        Int     @default(700) // 700 = 7%
  defaultDueDays   Int     @default(30)
  defaultValidDays Int     @default(30)
  footerNote       String?
  docConfig        Json    @default("{}") // per-docType prefix/pattern override

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, systemId])
}

// ───────────── เอกสารประจำ (recurring · V2 · WO 1.9 — BLUEPRINT §0.3 ข้อ 7) ─────────────
// "ใบแจ้งหนี้ค่าเช่าทุกวันที่ 1" — กฎ 1 แถว = เครื่องออกร่างให้เองทุกงวด แล้วเตือนคนตรวจ
// 🔴 กันซ้ำอยู่ที่ `AccountRecurringRun @@unique([ruleId, periodKey])` — ไม่ใช่ที่ตรรกะในโค้ด
//    (cron ยิงซ้ำ/สองเครื่องยิงพร้อมกัน ก็ได้เอกสารงวดละ 1 ใบเสมอ)

enum AccountRecurringFrequency {
  WEEKLY // ทุกสัปดาห์ (ใช้ weekday 0=อาทิตย์ … 6=เสาร์)
  MONTHLY // ทุกเดือน (ใช้ dayOfMonth · 31 ในเดือนสั้นถูกหดเป็นวันสุดท้ายของเดือน)
  QUARTERLY // ทุก 3 เดือน
  YEARLY // ทุกปี
}

model AccountRecurringRule {
  id       String         @id @default(cuid())
  tenantId String
  systemId String
  /// ชื่อกฎที่คนอ่านรู้เรื่อง — ใช้เป็น "อ้างอิง" บนเอกสารที่สร้างด้วย
  name     String
  /// จำกัดที่ INVOICE | QUOTATION | PURCHASE | EXPENSE ในชั้นโค้ด (recurring-shared.RECURRING_DOC_TYPES)
  docType  AccountDocType

  contactId String?
  contact   AccountContact? @relation(fields: [contactId], references: [id])

  /// แม่แบบเอกสาร: { priceMode, lines[], note?, tags[], dueDays? } — ดู recurring-shared.parseRecurringTemplate
  templateJson Json @default("{}")

  frequency   AccountRecurringFrequency
  dayOfMonth  Int? // 1–31 (MONTHLY/QUARTERLY/YEARLY)
  weekday     Int? // 0–6 (WEEKLY)
  startDate   DateTime
  endDate     DateTime?
  /// วันที่นัดของงวดถัดไป (UTC เที่ยงคืน) — คือหัวใจของ cron
  nextRunAt   DateTime
  lastRunAt   DateTime?
  /// สร้างล่วงหน้ากี่วันก่อนถึงวันที่นัด (0 = สร้างวันนั้น)
  leadDays    Int                       @default(0)
  /// true = ออกเอกสารให้เลย (ถ้าข้อมูลครบ) · false = ปล่อยเป็นร่างให้คนตรวจ
  autoApprove Boolean                   @default(false)
  active      Boolean                   @default(true)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs AccountRecurringRun[]

  @@index([systemId, active, nextRunAt])
  @@index([tenantId, systemId])
}

model AccountRecurringRun {
  id         String               @id @default(cuid())
  tenantId   String
  systemId   String
  ruleId     String
  rule       AccountRecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// กุญแจงวด: MONTHLY "2026-09" · QUARTERLY "2026-Q3" · YEARLY "2026" · WEEKLY "2026-09-07"
  periodKey  String
  documentId String
  createdAt  DateTime             @default(now())

  @@unique([ruleId, periodKey])
  @@index([systemId, createdAt])
}
