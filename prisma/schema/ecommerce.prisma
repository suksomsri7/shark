// E-commerce storefront (WO-0053) — catalog ต่อ unit · ออเดอร์ → เส้นเงินผ่าน pos.createSale (chokepoint C-2)
// นโยบายจ่ายเงิน v1: PromptPay QR (PaymentProfile ของร้าน) — ร้านกดยืนยันรับเงินเอง (ไม่มี bank API)
enum ShopOrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

model ShopProduct {
  id          String   @id @default(cuid())
  tenantId    String
  unitId      String
  name        String
  description String?
  priceSatang Int      @default(0)
  imageUrl    String?
  invItemId   String? // ผูกสต็อก inventory (optional) — ตัดตอนยืนยันรับเงิน
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // P1.1a: PosProduct.id (แคตตาล็อกเดียว · id หลวมข้ามไฟล์ schema) — มี invItemId = แถวเดียวกับ InvItem นั้น
  posProductId String?

  lines ShopOrderLine[]

  @@index([tenantId, unitId, active])
  // P1.1a: index ของคอลัมน์นี้เพิ่มใน P6.1 ด้วย CREATE INDEX CONCURRENTLY นอก prisma migrate (round 2 M1)
}

model ShopOrder {
  id            String          @id @default(cuid())
  tenantId      String
  unitId        String
  code          String // SO-0001 running ต่อ unit
  status        ShopOrderStatus @default(PENDING_PAYMENT)
  customerName  String
  customerPhone String
  note          String?
  totalSatang   Int             @default(0)
  posSaleId     String? // PosSale ที่เกิดตอนยืนยันรับเงิน (เส้นเงิน C-2)
  paidAt        DateTime?
  cancelledAt   DateTime?
  refundedAt    DateTime? // คืนเงิน (PAID→REFUNDED) — void PosSale + คืนสต็อก (ห้ามลบ order)
  createdAt     DateTime        @default(now())
  // CRM v2 (crm_v2_a · C11) — Party กลาง · nullable · ไม่มี FK (แบบ TicketOrder/HotelReservation)
  partyId        String?

  lines ShopOrderLine[]

  @@unique([unitId, code])
  @@index([tenantId, unitId, status])
  @@index([partyId])
}

model ShopOrderLine {
  id              String      @id @default(cuid())
  tenantId        String
  orderId         String
  order           ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         ShopProduct @relation(fields: [productId], references: [id])
  name            String // snapshot
  qty             Int
  unitPriceSatang Int // snapshot
  lineTotalSatang Int
  posProductId    String? // P1.1a: PosProduct.id (productId เดิม = ShopProduct · คงไว้) · null = ออเดอร์เดิม

  @@index([orderId])
  // P1.1a: index ของคอลัมน์นี้เพิ่มใน P6.1 ด้วย CREATE INDEX CONCURRENTLY นอก prisma migrate (round 2 M1)
}
