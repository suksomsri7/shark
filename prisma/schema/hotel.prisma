// Hotel (โรงแรม) — scope=unit (tenantId+unitId ทุกตาราง)
// P1 slice: ประเภทห้อง + ห้องพัก + เรตพื้นฐาน + การจอง(สร้าง/เช็คอิน/เช็คเอาท์/ยกเลิก) + ปฏิทินว่างพื้นฐาน
// เงินทุกจำนวน = Int หน่วยสตางค์ (satang) · วันที่ (check-in/out) เก็บ @db.Date, timezone ร้าน Asia/Bangkok
// เลื่อนไป 🔜 (ไม่ทำใน P1): housekeeping module เต็มรูป, night audit, folio/POS charge,
//   pricing ตามฤดู/rate plan หลายแบบ, channel manager/OTA, storefront จองออนไลน์, group booking
// อย่าประกาศ generator/datasource ที่นี่ (อยู่ใน core) — ไฟล์นี้ session Hotel แก้ได้ไฟล์เดียว

// สถานะห้องจริง (housekeeping/พร้อมขาย) — ห้อง OOO/CLEANING ไม่ถูก assign
enum HotelRoomStatus {
  AVAILABLE // ว่าง พร้อมขาย
  OCCUPIED // มีแขกพักอยู่
  CLEANING // รอทำความสะอาด (เช็คเอาท์แล้ว)
  OOO // out of order — ปิดใช้งานชั่วคราว
}

// สถานะการจอง (state machine พื้นฐาน P1)
enum HotelReservationStatus {
  BOOKED // จองแล้ว รอเข้าพัก
  CHECKED_IN // เข้าพักอยู่
  CHECKED_OUT // ออกแล้ว
  CANCELLED // ยกเลิก
  REFUNDED // คืนเงินหลังเช็คเอาท์ (POS bill ถูก void — ห้ามลบ การเงินแก้ด้วย reversal)
}

// ─────────────────────── INVENTORY ───────────────────────

model HotelRoomType {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String
  name           String // "Deluxe Sea View"
  code           String? // "DLX" ใช้ย่อในรายงาน/ปฏิทิน
  description    String?
  capacity       Int      @default(2) // จำนวนผู้เข้าพักสูงสุด/ห้อง
  baseRateSatang Int      @default(0) // ราคาต่อคืน (สตางค์) — 🔜 season/rate plan
  depositSatang  Int      @default(0) // มัดจำต่อการจอง (0 = ไม่ต้องมัดจำ) — ลูกค้าจองออนไลน์จ่ายมัดจำ PromptPay
  active         Boolean  @default(true) // soft-delete (ห้าม hard delete)
  sortOrder      Int      @default(0)
  // SVC R0.1 ▸ หอ/รายเดือน (CC §5.2)
  monthlyRateSatang Int? // ค่าเช่ารายเดือน (สตางค์)
  areaSqm           Decimal? // พื้นที่ ตร.ม.
  rentMode          String   @default("NIGHTLY") // "NIGHTLY" | "MONTHLY" | "BOTH"
  amenities         Json?
  // ◂ SVC R0.1
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rooms        HotelRoom[]
  reservations HotelReservation[]

  @@unique([unitId, name])
  @@index([tenantId, unitId])
  @@index([unitId, active, sortOrder])
}

model HotelRoom {
  id         String          @id @default(cuid())
  tenantId   String
  unitId     String
  roomTypeId String
  roomType   HotelRoomType   @relation(fields: [roomTypeId], references: [id])
  number     String // "203" (unique ต่อ unit)
  floor      String? // "2"
  status     HotelRoomStatus @default(AVAILABLE)
  active     Boolean         @default(true) // soft-delete
  note       String?
  // SVC R0.1 ▸ แกนห้อง (CC §5.2 · คง floor ข้อความเดิม)
  buildingId String?
  building   RoomBuilding?   @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floorNo    Int?
  rentMode   String? // null = ตามประเภทห้อง
  hkStatus   String          @default("CLEAN") // "CLEAN" | "DIRTY" | "INSPECTED" | "OUT_OF_ORDER"
  // ◂ SVC R0.1
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  reservations HotelReservation[]
  occupancies  RoomOccupancy[] // SVC R0.1
  dormLeases   DormLease[] // SVC D.0 (FK Restrict)
  dormMeters   DormMeter[] // SVC D.0 (FK Restrict)

  @@unique([unitId, number])
  @@index([tenantId, unitId])
  @@index([unitId, roomTypeId, active])
  @@index([unitId, status])
  @@index([buildingId]) // SVC D.0 (หนี้ดัชนี R0.8)
}

// ─────────────────────── BOOKING ─────────────────────────

model HotelReservation {
  id                 String                 @id @default(cuid())
  tenantId           String
  unitId             String
  code               String // รหัสจอง เช่น "HR-2607-0001" (running ต่อ unit)
  publicToken        String?                @unique @default(cuid()) // ลิงก์สถานะลูกค้า (public/no-auth) — จองออนไลน์
  status             HotelReservationStatus @default(BOOKED)
  // ผู้เข้าพัก (snapshot บนเอกสาร) — customerId เชื่อมระบบสมาชิกภายหลังได้ (P1 เก็บเป็น scalar)
  guestName          String
  guestPhone         String?
  guestEmail         String?
  customerId         String? // Customer.id — 🔜 ผูก member.findOrCreate ตอน check-in
  // ห้อง
  roomTypeId         String
  roomType           HotelRoomType          @relation(fields: [roomTypeId], references: [id])
  roomId             String? // ห้องจริงที่ assign (ตอนจอง/ตอน check-in)
  room               HotelRoom?             @relation(fields: [roomId], references: [id])
  // ช่วงพัก (checkOutDate exclusive — คืนสุดท้าย = checkOutDate-1)
  checkInDate        DateTime               @db.Date
  checkOutDate       DateTime               @db.Date
  nights             Int                    @default(1)
  adults             Int                    @default(2)
  children           Int                    @default(0)
  // เงิน (snapshot ตอนจอง — สตางค์)
  ratePerNightSatang Int                    @default(0)
  totalSatang        Int                    @default(0)
  // มัดจำ (snapshot จาก roomType ตอนจอง — สตางค์) · จ่าย PromptPay แล้วร้านยืนยัน → depositPaidAt + บิล POS DEPOSIT (Dr 2110)
  depositSatang      Int                    @default(0) // 0 = ไม่ต้องมัดจำ
  depositPaidAt      DateTime? // เวลาที่ร้านยืนยันรับมัดจำ (null = ยังไม่จ่าย)
  depositSaleId      String? // PosSale.id ของบิลมัดจำ (null = ไม่ผูก POS / ยังไม่จ่าย)
  note               String?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  refundedAt         DateTime? // เวลาที่คืนเงินหลังเช็คเอาท์ (คู่กับ status REFUNDED)
  createdById        String? // User.id พนักงาน (null = ระบบ/ลูกค้า)
  // WO 3.1 — Party (INTEGRATION-MAP §F.1): คอลัมน์เพิ่มเฉย ๆ — ยังไม่มีโค้ด hotel เขียนค่านี้ (นอกขอบเขต WO นี้)
  partyId            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([unitId, code])
  @@index([tenantId, unitId])
  @@index([unitId, status, checkInDate])
  @@index([unitId, roomTypeId, checkInDate, checkOutDate]) // ← availability query
  @@index([unitId, roomId, checkInDate, checkOutDate]) // กันห้องจริงถูก assign ซ้อน
  @@index([unitId, guestPhone])
  @@index([partyId])
}

// ─────────────────────── SVC R0.1 ▸ แกนห้อง (CC §5.2 · เจ้าของโค้ด R0.8/R0.9) ───────────────────────

model RoomBuilding {
  id        String      @id @default(cuid())
  tenantId  String
  unitId    String
  name      String
  floors    Int
  sortOrder Int

  rooms HotelRoom[]
}

// การครองห้องรายช่วงวัน (endDate ไม่รวมวันจบ — [startDate, endDate)) · refId = ข้อความ ไม่มี FK
// 🔴 กันจองซ้อนระดับ DB (SQL มือ — Prisma เขียนเองไม่ได้):
//    svc_r0:  CREATE EXTENSION IF NOT EXISTS btree_gist
//             CONSTRAINT "RoomOccupancy_no_overlap" EXCLUDE USING gist ("roomId" WITH =, daterange("startDate","endDate",'[)') WITH &&) WHERE (active)
//    svc_r0b: CONSTRAINT "RoomOccupancy_dates_check" CHECK ("endDate" > "startDate")
//    Prisma 7.8 ไม่สร้าง DROP ให้ของพวกนี้ (ตรวจ 27 ต.ค.) — ใบถัดไปให้รัน migrate diff ตรวจซ้ำ
model RoomOccupancy {
  id            String    @id @default(cuid())
  tenantId      String
  unitId        String
  roomId        String
  room          HotelRoom @relation(fields: [roomId], references: [id])
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date // ไม่รวมวันจบ
  kind          String // "LEASE" | "STAY" | "HOLD" | "BLOCK" | "CHANNEL_HOLD"
  refType       String
  refId         String
  active        Boolean   @default(true)
  holdExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SVC D.0 ▸ หนี้ดัชนี R0.8 (Prisma)
  @@index([tenantId, refType, refId])
  @@index([tenantId, unitId, startDate])
  // SVC D.0 ▸ SQL มือ (svc_d · Prisma ประกาศ partial ไม่ได้ · migrate diff ไม่เสนอ DROP):
  //    "RoomOccupancy_holdExpiresAt_hold_idx" ON ("holdExpiresAt") WHERE "active" AND "kind" IN ('HOLD','CHANNEL_HOLD')  — expireHolds
  //    UNIQUE "RoomOccupancy_refType_refId_stay_key" ON ("refType","refId") WHERE "active" AND "kind" = 'STAY'  — การจองโรงแรมถือห้องจริง 1 แถว active
}
// ◂ SVC R0.1
