// Booking (จองคิว/นัดหมาย) — scope=unit (tenantId+unitId ทุกตาราง)
// MVP: บริการ + ช่าง + ตารางเวลา(รายสัปดาห์) + นัด + slot engine
// เลื่อนไป 🔜: skill mapping ราย service, วันหยุด/ลา, มัดจำ, recurring

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  DONE
  NO_SHOW
  CANCELLED
  // SVC B.0 — ต่อท้ายเท่านั้น (ALTER TYPE ADD VALUE) · ตั้งได้ทางเครื่องสถานะ B.4 เท่านั้น (setStatusAction รับ 6 ค่าเดิม)
  QUEUED // walk-in ต่อคิวแล้ว ยังไม่ได้ช่าง/ยังไม่เริ่ม
  IN_SERVICE // กำลังให้บริการ
  LATE // เลยเวลานัด (อยู่ในช่วงผ่อนผัน)
}

// ⚠️ 13 ส.ค. 2026: บริการ "ต้นฉบับ" ย้ายไปอยู่แคตตาล็อกกลาง (InvItem kind=SERVICE)
// แถวนี้เหลือหน้าที่ = "บริการที่สาขานี้เปิดรับจอง" (projection) — นัดอ้างถึงแถวนี้ ห้ามลบจริง
// itemId = ต้นฉบับในแคตตาล็อก (null = บริการเก่าที่ยังไม่ย้าย — กดย้ายได้ที่หน้าบริการ)
model BookingService {
  id            String   @id @default(cuid())
  tenantId      String
  unitId        String
  name          String
  durationMin   Int // ใช้เวลา (นาที)
  priceSatang   Int      @default(0)
  depositSatang Int      @default(0) // มัดจำต่อบริการ (0 = ไม่ต้องมัดจำ) — ร้านตั้งเอง กัน no-show
  bufferMin     Int      @default(0) // เวลาพักหลังบริการ
  active        Boolean  @default(true)
  // ให้ลูกค้าจองล่วงหน้าได้ไหม — false = ขายหน้าร้านอย่างเดียว (ค่าจัดส่ง/ห่อของขวัญ/ค่าติดตั้ง)
  // ธุรกิจที่มีทั้งสินค้าและบริการต้องแยกสองอย่างนี้ ไม่งั้น "ค่าจัดส่ง" จะโผล่เป็นคิวให้จอง
  bookable      Boolean  @default(true)
  sortOrder     Int      @default(0)
  itemId        String? // ต้นฉบับในแคตตาล็อกกลาง (InvItem kind=SERVICE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
  staffServices BookingStaffService[] // SVC B.0

  @@index([tenantId, unitId])
  @@index([unitId, itemId])
}

model BookingStaff {
  id         String   @id @default(cuid())
  tenantId   String
  unitId     String
  name       String
  employeeId String? // soft link → HrEmployee.id (ถ้าเลือกจากพนักงาน HR) · null = พิมพ์ชื่อเอง
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hours        BookingStaffHours[]
  appointments Appointment[]
  services     BookingStaffService[] // SVC B.0

  @@index([tenantId, unitId])
}

// เวลาทำการของร้าน (ระดับ unit รายสัปดาห์) — ใช้เป็นกรอบช่องจองของทุกช่าง
// weekday 0=อาทิตย์..6=เสาร์ · closed=true = วันหยุดร้าน (ไม่รับนัด)
model BookingHours {
  id        String   @id @default(cuid())
  tenantId  String
  unitId    String
  weekday   Int
  openMin   Int      @default(600) // 10:00
  closeMin  Int      @default(1200) // 20:00
  closed    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([unitId, weekday])
  @@index([tenantId, unitId])
}

// ตารางเวลาทำงานรายสัปดาห์ (weekday 0=อาทิตย์..6=เสาร์, นาทีจากเที่ยงคืน)
model BookingStaffHours {
  id       String       @id @default(cuid())
  tenantId String
  unitId   String
  staffId  String
  staff    BookingStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([staffId])
  @@index([tenantId, unitId])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  unitId         String
  customerId     String? // มีเมื่อระบบนี้เชื่อมกับระบบสมาชิก
  customer       Customer?         @relation(fields: [customerId], references: [id])
  staffId        String
  staff          BookingStaff      @relation(fields: [staffId], references: [id])
  serviceId      String
  service        BookingService    @relation(fields: [serviceId], references: [id])
  startAt        DateTime
  endAt          DateTime // รวม buffer แล้ว (กันจองซ้อน)
  status         AppointmentStatus @default(CONFIRMED)
  customerName   String // snapshot
  customerPhone  String // snapshot
  note           String?
  source         String            @default("STAFF") // STAFF | ONLINE
  // snapshot ราคา ณ วันจอง — ร้านขึ้นราคาทีหลังต้องไม่กระทบนัดที่จองไว้แล้ว
  // -1 = นัดเก่าที่จองก่อนมีฟิลด์นี้ (อ่านราคาจากบริการตามเดิม)
  priceSatang    Int               @default(-1)
  depositSatang  Int               @default(0) // snapshot มัดจำจากบริการตอนสร้างนัด (0 = ไม่ต้องมัดจำ)
  depositPaidAt  DateTime? // เวลาที่ร้านรับมัดจำ (null = ยังไม่จ่าย)
  depositSaleId  String? // PosSale.id ของบิลมัดจำ (null = ไม่ผูก POS / ยังไม่จ่าย)
  idempotencyKey String? // กันสร้างนัดซ้ำจากยิงซ้ำ/ดับเบิลคลิก (null = ไม่ผูก key)
  // M1.1 (ระบบสมาชิก v2) — สแตมป์ที่ได้จากการมาตามนัดใบนี้ (StampEvent.id · เขียนจริงที่ M2.3)
  stampEventId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // CRM v2 (crm_v2_a · C11) — Party กลาง · nullable · ไม่มี FK (แบบ TicketOrder/HotelReservation)
  partyId        String?
  // ── SVC B.0 (จองคิว V2 · DESIGN-BOOKING-QUEUE §4.4) — id หลวมทั้งหมดไม่มี FK · CHECK อยู่ใน migration svc_b (SQL มือ) ──
  kind              String    @default("BOOKED") // BOOKED | WALKIN (CHECK)
  assignMode        String    @default("SPECIFIC") // SPECIFIC | ANY (CHECK)
  channel           String? // ONLINE | LINE | PHONE | STAFF | KIOSK | REMOTE
  checkedInAt       DateTime?
  startedAt         DateTime?
  doneAt            DateTime?
  lateAt            DateTime?
  plannedStartAt    DateTime?
  plannedStaffId    String?
  resourceId        String? // SvcResource.id
  groupId           String? // นัดหลายบริการ/หลายคน
  queueTicketId     String? // QueueTicket.id
  manageTokenHash   String? // hash ของ token ลิงก์จัดการนัด (ไม่เก็บ token ดิบ · X7)
  heldCartId        String? // PosHeldCart.id
  rescheduledFromId String?
  rescheduleCount   Int       @default(0) // CHECK >= 0
  cancelReason      String?
  policySnapshot    Json? // CC §1.6 — snapshotPolicy("appointment")

  @@unique([tenantId, idempotencyKey])
  @@unique([manageTokenHash])
  @@index([tenantId, unitId, startAt])
  @@index([staffId, startAt])
  @@index([partyId])
  @@index([groupId])
  @@index([queueTicketId])
}

// SVC B.0 — ช่าง × บริการ (ไม่มีแถวของช่าง = ทำทุกบริการ · booking.staff.servicesMode) · CHECK ใน migration svc_b
model BookingStaffService {
  id          String         @id @default(cuid())
  tenantId    String
  unitId      String
  staffId     String
  staff       BookingStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId   String
  service     BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  durationMin Int? // null = ตามบริการ · CHECK > 0
  priceSatang Int? // null = ตามบริการ · CHECK >= 0
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([staffId, serviceId])
  @@index([tenantId, unitId])
}

// SVC B.0 — ทรัพยากร (เก้าอี้/เตียง/ห้อง · ใช้จริง B.13) · ไม่มี FK · CHECK ใน migration svc_b
model SvcResource {
  id         String   @id @default(cuid())
  tenantId   String
  unitId     String
  kind       String
  name       String
  capacity   Int      @default(1) // CHECK >= 1
  cleanupMin Int      @default(0) // CHECK >= 0
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([unitId, name])
  @@index([tenantId, unitId])
}

// วันหยุด/เวลาพิเศษรายวัน (11 ส.ค. 2026 — เจ้าของทัก: เดิมตั้งได้แค่รายสัปดาห์)
// ใช้ทับ BookingHours ของ weekday นั้นเฉพาะวันที่ระบุ
//   closed=true  → ปิดทั้งวัน (ปีใหม่ สงกรานต์ ลาพักร้อน)
//   closed=false → เปิดเวลาพิเศษ (เช่น วันสิ้นปีเปิด 10:00-14:00)
model BookingClosure {
  id        String   @id @default(cuid())
  tenantId  String
  unitId    String
  date      String // "YYYY-MM-DD" เวลาไทย
  closed    Boolean  @default(true)
  openMin   Int?
  closeMin  Int?
  note      String?
  createdAt DateTime @default(now())

  @@unique([unitId, date])
  @@index([tenantId, unitId])
}
