// ระบบ 10 — รวม Chat (Omni-channel Inbox) — system-scoped (AppSystem type CHAT)
// ทุกตารางมี tenantId + systemId · unique = @@unique([systemId, ...])
// P1 (MVP): WEBCHAT (built-in) + LINE · เฟสถัดไป: FACEBOOK/INSTAGRAM/SHOPEE/LAZADA/WHATSAPP
// คนละ inbox กับระบบ 11 Meeting (แชทภายใน) — ห้ามใช้ตารางร่วม
// ดูสเปคเต็ม: docs/modules/10-chat.md · connections: docs/BLUEPRINT_CONNECTIONS.md (C-3 AI, C-5 KB)

// ───────────────────────── enums ─────────────────────────

enum ChatChannelType {
  WEBCHAT // ✅ MVP — built-in ไม่ต้องมี connection
  LINE // ✅ MVP
  FACEBOOK // 🔜 เฟส 2 (Meta)
  INSTAGRAM // 🔜 เฟส 2 (Meta)
  SHOPEE // 🔜 เฟส 3
  LAZADA // 🔜 เฟส 3
  WHATSAPP // 🔜 เฟส 4
  // 🔴 APP แยกจาก WEBCHAT เพราะ "แชทจากแอปมือถือของลูกค้า" ไม่ใช่ "แชทจากหน้าเว็บ":
  //    วันนี้ SiamDive RN ยิงเข้ามาปนกับ widget เว็บใต้ป้าย WEBCHAT เดียวกัน ⇒ แยกไม่ออกว่า
  //    ลูกค้าทักมาจากไหน (มีผลกับ deep link ที่ส่งกลับ · การนับสถิติช่องทาง · ไอคอนในกล่องแชท)
  //    ถ้าไม่มีค่านี้ ต้องไปเดาจาก meta.userAgent ซึ่งเป็นข้อมูลที่ปลอมได้และหายเมื่อ purge
  APP // 🔜 แอปมือถือของลูกค้า (SiamDive RN ฯลฯ) — ยังไม่มี adapter แยก
  TIKTOK // 🔜 เฟส 4 (คอขวดคือการอนุมัติของแพลตฟอร์ม ไม่ใช่โค้ด)
}

enum ChatConnectionStatus {
  CONNECTED
  EXPIRED // token หมดอายุ/ถูก revoke — ต้อง re-auth
  ERROR // ส่ง/รับพังต่อเนื่อง
  DISABLED // ปิดชั่วคราวโดยร้าน
}

enum ChatConversationStatus {
  OPEN
  PENDING // รอลูกค้า — หยุดนับ SLA ฝั่งร้าน
  RESOLVED
}

enum ChatMessageDirection {
  IN // ลูกค้า → ร้าน
  OUT // ร้าน → ลูกค้า (รวม system/auto)
}

enum ChatMessageType {
  TEXT
  IMAGE
  STICKER
  FILE
  ORDER_CONTEXT // การ์ดออเดอร์/สินค้า (Shopee/Lazada)
  SYSTEM // ข้อความระบบในเธรด — ไม่ส่งออกช่องทาง
  // 🔴 AUDIO แยกจาก FILE เพราะ "ข้อความเสียง" ไม่ใช่ "ไฟล์ที่แนบมา" (WO-CV8):
  //    ฟองเสียงต้องวาดปุ่มเล่น+คลื่น+ความยาว และรายการแชทต้องสรุปว่า "ข้อความเสียง"
  //    ถ้าใช้ FILE ปนกัน ต้องไปเดาจาก mimeType ของไฟล์แนบ = เดาผิดได้ (audio/* ที่ลูกค้าส่งเป็นไฟล์เพลง)
  //    และช่องทางที่ส่งเสียงไม่ได้จะกันก่อนกดส่งไม่ได้ เพราะแยกไม่ออกว่าอันไหนคือเสียง
  AUDIO
}

enum ChatDeliveryStatus {
  PENDING // OUT: เข้าคิว adapter
  SENT
  FAILED // deliveryError บอกเหตุผล
}

enum ChatEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  UNIT_CHANGED
  CUSTOMER_LINKED
  REOPENED
  DELIVERY_FAILED
}

// ─────────────── การเชื่อมช่องทาง (ต่อ system) ───────────────

model ChatChannelConnection {
  id                String               @id @default(cuid())
  tenantId          String
  systemId          String // AppSystem (type CHAT)
  type              ChatChannelType // ไม่มีแถวสำหรับ WEBCHAT (built-in)
  displayName       String
  externalAccountId String // LINE bot userId / FB pageId / IG accountId / shop_id / WA phoneNumberId
  credentials       Json // 🔐 AES-256-GCM ที่ service layer เท่านั้น — ห้าม return เต็มออก API
  webhookKey        String               @unique @default(cuid())
  defaultUnitId     String? // conversation จาก connection นี้ tag unit ไหน
  status            ChatConnectionStatus @default(CONNECTED)
  // widget ฝัง (D2/D3) — กุญแจสาธารณะ + กันเอา id ไปแปะเว็บอื่น
  originAllowlist   Json                 @default("[]") // ["https://www.siamdive.com"] · [] = ยังไม่เปิด CORS ให้ origin ไหน
  publicKeyHash     String? // sha256(raw public key) — เก็บ hash เท่านั้น เหมือน ApiKey.keyHash
  publicKeyPrefix   String? // 12 ตัวแรกของ raw ไว้แสดงในตาราง (ApiKey.prefix)
  tokenExpiresAt    DateTime? // Shopee/Lazada/FB — cron refresh ล่วงหน้า
  lastInboundAt     DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  meta              Json? // per-channel เช่น LINE quota used
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  contacts      ChatContact[]
  conversations ChatConversation[]

  @@unique([systemId, type, externalAccountId])
  @@unique([publicKeyHash]) // lookup widget key ด้วย hash (nullable = หลายแถวว่างได้)
  @@index([tenantId, systemId, status])
  @@index([tokenExpiresAt])
}

// ─────────────── ตัวตนลูกค้าต่อช่องทาง ───────────────

model ChatContact {
  id                  String                 @id @default(cuid())
  tenantId            String
  systemId            String
  channel             ChatChannelType
  channelConnectionId String? // null = WEBCHAT
  channelConnection   ChatChannelConnection? @relation(fields: [channelConnectionId], references: [id])
  externalUserId      String // id ฝั่ง provider; WEBCHAT = guest token
  displayName         String?
  avatarUrl           String?
  phone               String?
  email               String?
  customerId          String? // Member id ในระบบ Member ที่เชื่อม — nullable
  lang                String? // ภาษาที่ลูกค้าใช้ (BCP-47 สั้น: th/en/cn/ja/de) — ใช้เลือก greeting/offline
  externalRef         String? // id ฝั่งระบบต้นทาง เช่น deviceId ของ SiamDive
  verifiedEmail       Boolean                @default(false) // true = email ผ่าน OTP ฝั่งต้นทางแล้ว
  linkedByUserId      String?
  linkedAt            DateTime?
  blockedAt           DateTime?
  lastSeenAt          DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  // WO 3.1 — Party (INTEGRATION-MAP §F.1): คอลัมน์เพิ่มเฉย ๆ (additive) — **ไม่มีโค้ด chat เขียนค่านี้**
  // (กติกา run: ห้ามแตะ src/lib/modules/chat/**) session แชทเป็นผู้เขียนค่านี้เองภายหลัง เมื่อ
  // `maybeAutoLinkMember` เชื่อม customerId แล้ว ให้ตั้ง partyId = ค่าเดียวกับ Customer.partyId ที่เพิ่ง
  // ได้จาก `member.findOrCreate` (ตอนนี้ `member.findOrCreate` เซ็ต Customer.partyId ให้แล้วใน WO นี้)
  partyId             String?

  conversations ChatConversation[]

  @@unique([systemId, channel, channelConnectionId, externalUserId])
  @@index([systemId, customerId])
  @@index([systemId, channel, lastSeenAt])
  @@index([tenantId, phone])
  @@index([partyId])
}

// ─────────────── Conversation ───────────────

model ChatConversation {
  id                  String                 @id @default(cuid())
  tenantId            String
  systemId            String
  channel             ChatChannelType // denormalize จาก contact เพื่อ filter เร็ว
  channelConnectionId String?
  channelConnection   ChatChannelConnection? @relation(fields: [channelConnectionId], references: [id])
  contactId           String
  contact             ChatContact            @relation(fields: [contactId], references: [id])
  unitId              String? // tag ที่มา (unit ที่เชื่อมระบบนี้)
  status              ChatConversationStatus @default(OPEN)
  assigneeUserId      String?
  tags                Json                   @default("[]")
  meta                Json? // บริบทลูกค้า §3.3 — { pageUrl, country, userAgent, lang, ... }

  // denormalized เพื่อ inbox list
  lastMessageAt        DateTime?
  lastMessagePreview   String?
  lastMessageDirection ChatMessageDirection?
  staffUnreadCount     Int                   @default(0)

  replyWindowExpiresAt DateTime? // FB/IG/WA

  // ── ปักหมุดห้องแชท (WO-CV10) ──
  // 🔴 "ระดับร้าน" ไม่ใช่รายคน (มติ: ทีมต้องเห็นตรงกัน) — ห้องที่ปักหมุดคือ "งานสำคัญของร้าน"
  //    เช่น ลูกค้าที่กำลังจะโอนมัดจำ · ถ้าเป็นรายคน คนที่เข้ากะต่อจะไม่เห็นว่าห้องไหนต้องตามต่อ
  //    (ต่างจาก "ปิดเสียง" ที่เป็นความรำคาญส่วนตัว → อยู่ใน ChatConversationPref)
  // เก็บ `pinnedByUserId` ไว้ตอบคำถาม "ใครปักหมุดไว้" เวลาทีมเถียงกันว่าทำไมห้องนี้ค้างอยู่บนสุด
  // 🔴 เรียงลำดับต้องสั่ง `nulls: "last"` เสมอ — Postgres ตั้งต้นให้ DESC = NULLS FIRST
  //    ⇒ เขียน `orderBy: { pinnedAt: "desc" }` เฉย ๆ จะได้ห้องที่ **ไม่ได้ปักหมุด** ขึ้นก่อน (กลับหัว)
  //    ตั้งใจไม่ทำ index ให้: index ของ pinnedAt เป็น NULLS FIRST จึงใช้กับ order นี้ไม่ได้อยู่ดี
  //    และห้องที่ปักหมุดมีไม่กี่ห้องต่อร้าน (ตัวกรอง systemId ตัดงานทิ้งไปแล้ว)
  pinnedAt       DateTime?
  pinnedByUserId String?

  // SLA
  firstCustomerMessageAt DateTime?
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  reopenedCount          Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages   ChatMessage[]
  events     ChatConversationEvent[]
  readStates ChatReadState[]
  prefs      ChatConversationPref[]

  @@index([systemId, status, lastMessageAt(sort: Desc)])
  @@index([systemId, channel, status])
  @@index([systemId, assigneeUserId, status])
  @@index([systemId, unitId, status])
  @@index([contactId])
}

// ⚠️ "1 contact = 1 conversation active" บังคับ 2 ชั้น:
//   (1) service: advisory lock ต่อ contactId ใน transaction ก่อนหา/สร้าง
//   (2) partial unique index (raw SQL หลัง db push):
//       CREATE UNIQUE INDEX chat_conv_active ON "ChatConversation" ("contactId") WHERE status <> 'RESOLVED';

// ─────────────── Message ───────────────

model ChatMessage {
  id                String               @id @default(cuid())
  tenantId          String
  systemId          String
  conversationId    String
  conversation      ChatConversation     @relation(fields: [conversationId], references: [id])
  direction         ChatMessageDirection
  type              ChatMessageType      @default(TEXT)
  senderUserId      String? // OUT: staff ผู้ส่ง (null = system/auto)
  senderName        String? // ชื่อที่ลูกค้าเห็น (เช่น "ทีมงาน SiamDive") — null = ใช้ ChatSetting.senderAlias
  body              String?              @db.Text
  stickerMeta       Json?
  orderContext      Json?
  isInternal        Boolean              @default(false)
  clientMessageId   String?
  externalMessageId String?
  deliveryStatus    ChatDeliveryStatus   @default(SENT)
  deliveryError     String?
  meta              Json?
  // ── คำแปล (WO-CW1) — มติ W3: "กดแปลเมื่อต้องการ" ไม่ใช่แปลอัตโนมัติ ──
  // 🔴 เก็บผลแปลไว้ในแถวเดียวกับต้นฉบับ **ไม่ทับ body** เพราะ 2 เหตุผล:
  //    (1) ค่าใช้จ่าย — 1 ข้อความ ≈ $0.008 ถ้าไม่เก็บ คนกดซ้ำ/รีเฟรชหน้า = จ่ายใหม่ทุกครั้ง
  //    (2) ต้นฉบับคือหลักฐาน — คำแปลผิดได้ ทีมต้องย้อนดูสิ่งที่ลูกค้าพิมพ์จริงเสมอ
  // เก็บ 1 คำแปล/ข้อความ (ภาษาปลายทางล่าสุด) ไม่ทำตาราง n:1 เพราะทีมอ่านภาษาเดียว
  //    (ChatSetting.staffLang) — วันที่ต้องรองรับหลายภาษาพร้อมกันค่อยแตกตาราง ไม่ใช่ตอนนี้
  detectedLang      String? // ภาษาที่ตรวจได้จากต้นฉบับ (BCP-47 สั้น: th/en/cn) — null = ยังไม่เคยแปล
  translatedBody    String?              @db.Text
  translatedLang    String? // ภาษาปลายทางของ translatedBody — ต่างจากที่ขอ = ต้องแปลใหม่
  translatedAt      DateTime?
  // 🔴 PDPA: `translatedBody` = สำเนาเนื้อความอีกชุดหนึ่ง ⇒ retention ต้องล้างพร้อม `body`
  //    วันนี้ chat/retention.ts ล้างแค่ body/stickerMeta/orderContext/meta/senderName
  //    ⇒ ถ้าไม่เพิ่มฟิลด์นี้เข้าไปด้วย ข้อความที่ "ปกปิดแล้ว" จะยังอ่านได้จากช่องคำแปล (WO-CW3)
  purgedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  attachments ChatAttachment[]

  @@unique([conversationId, clientMessageId])
  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([systemId, createdAt])
  @@index([systemId, deliveryStatus])
}

model ChatAttachment {
  id         String          @id @default(cuid())
  tenantId   String
  systemId   String
  messageId  String
  message    ChatMessage     @relation(fields: [messageId], references: [id])
  kind       ChatMessageType // IMAGE | FILE | STICKER
  storageKey String
  url        String
  fileName   String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  // ความยาวคลิปเสียง/วิดีโอเป็นมิลลิวินาที (WO-CV8)
  // 🔴 มีไว้เพื่อ **วาด "0:12" ได้โดยไม่ต้องโหลดไฟล์เสียง** — รายการแชทและฟองเสียงต้องขึ้นความยาว
  //    ทันทีที่เปิดหน้า ถ้าไม่เก็บ ต้องดึงไฟล์ทุกก้อนมาอ่าน metadata = เปลืองเน็ตลูกค้าและช้า
  //    เป็น Int (ms) ไม่ใช่วินาที เพราะ MediaRecorder/ffprobe คืนค่าเป็น ms อยู่แล้ว — ปัดที่ชั้นแสดงผล
  durationMs Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([messageId])
  @@index([systemId, createdAt])
}

// ─────────────── Unread / read state (ฝั่ง staff ต่อคน) ───────────────

model ChatReadState {
  id                String           @id @default(cuid())
  tenantId          String
  systemId          String
  conversationId    String
  conversation      ChatConversation @relation(fields: [conversationId], references: [id])
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([conversationId, userId])
  @@index([systemId, userId])
}

// ─────────────── ค่าตั้งของ "คนต่อห้อง" (WO-CV10) ───────────────
// 🔴 ทำไมต้องเป็นตารางใหม่ ไม่ไปเกาะ ChatReadState ที่มีคู่ (conversation, user) อยู่แล้ว:
//    ChatReadState คือ "อ่านถึงไหนแล้ว" — เป็นข้อมูลที่ระบบเขียนทับตลอดเวลาและรีเซ็ต/ล้างได้
//    (retention · เปลี่ยนเครื่อง · ล้างตัวนับ) ส่วนตารางนี้คือ **ความตั้งใจของผู้ใช้**
//    ถ้าเอาไปปนกัน วันที่ล้างสถานะการอ่าน ทีมจะถูก "เปิดเสียงคืน" โดยไม่มีใครสั่ง = เสียงเด้งกลางดึก
//
// ปิดเสียงเป็น **รายคน** (ไม่ใช่ระดับร้านแบบปักหมุด) เพราะเป็นความรำคาญส่วนตัว:
// คนที่ไม่ได้ดูแลห้องนั้นปิดเสียงได้ โดยคนที่ดูแลอยู่ต้องยังได้รับแจ้งเตือนตามปกติ
model ChatConversationPref {
  id             String           @id @default(cuid())
  tenantId       String
  systemId       String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  userId         String
  // 🔴 เก็บ "ปิดเสียงถึงเมื่อไหร่" ไม่ใช่ boolean `muted` — เพราะของจริงที่คนใช้คือ
  //    "ปิด 1 ชม. / ถึงพรุ่งนี้ 9 โมง / ปิดไปเลย" · boolean ทำได้แค่แบบสุดท้าย
  //    ปิดถาวร = ใส่วันไกล ๆ · null = ไม่เคยปิด/เปิดเสียงคืนแล้ว (หมดอายุเองโดยไม่ต้องมี cron)
  mutedUntil     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([conversationId, userId])
  @@index([systemId, userId])
}

// ─────────────── Event log (SLA + audit เธรด) ───────────────

model ChatConversationEvent {
  id             String           @id @default(cuid())
  tenantId       String
  systemId       String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  type           ChatEventType
  actorUserId    String?
  meta           Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([systemId, type, createdAt])
}

// ─────────────── Quick reply ───────────────

model ChatQuickReply {
  id              String    @id @default(cuid())
  tenantId        String
  systemId        String
  shortcut        String // พิมพ์ /ส่ง
  title           String
  body            String    @db.Text // {{contact.name}} {{unit.name}} {{staff.name}}
  channelTypes    Json      @default("[]") // [] = ทุกช่องทาง
  usageCount      Int       @default(0)
  createdByUserId String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([systemId, shortcut])
  @@index([systemId])
}

// ─────────────── AI แนะนำคำตอบ + คลังคำตอบที่ผ่านมนุษย์ (WO-CW1) ───────────────
// ทำไมต้องเก็บ "ข้อเสนอ" ไม่ใช่เก็บแค่ผลลัพธ์: ถ้าบันทึกเฉพาะข้อความที่ส่งจริง
// จะตอบไม่ได้เลยว่า AI ช่วยได้จริงไหม (ทีมกดใช้กี่ครั้ง · แก้เยอะแค่ไหน · ข้ามทิ้งกี่ครั้ง)
// ⇒ วัดคุณภาพไม่ได้ = ปรับ prompt แบบเดา ๆ และเถียงกันด้วยความรู้สึก

model ChatAiSuggestion {
  id              String   @id @default(cuid())
  tenantId        String
  systemId        String
  conversationId  String
  sourceMessageId String // ข้อความลูกค้าที่ AI ใช้ตั้งต้น
  suggestedBody   String   @db.Text
  rank            Int      @default(0) // 0..2 (เสนอได้สูงสุด 3 ตัวเลือกต่อครั้ง)
  model           String
  costMicro       Int      @default(0)
  // 🔴 ไม่ใช่ของประดับ — เป็นหลักฐานว่าคำตอบมาจากข้อมูลจริงของร้าน ไม่ใช่ AI แต่งเอง
  //    ["kb:<id>","example:<id>","tool:sales_today"] · ว่าง = ต้องขึ้นป้ายเตือนบนตัวเลือกนั้น
  sourcesUsed     Json     @default("[]")
  // PENDING | IGNORED | SENT_AS_IS | SENT_EDITED
  // เริ่มที่ PENDING เสมอ เพราะ "เสนอแล้วยังไม่มีใครตัดสิน" ต่างจาก "เสนอแล้วถูกข้าม"
  outcome         String   @default("PENDING")
  sentMessageId   String?
  // 0..100 · ความเหมือนของที่ส่งจริงกับที่เสนอ — แยก AS_IS/EDITED และวัดคุณภาพรายเดือน
  // เก็บเป็น Int เพราะเป็นตัวชี้วัดเชิงสถิติ ไม่ต้องการความละเอียดระดับทศนิยม
  similarity      Int?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([systemId, conversationId, createdAt])
  @@index([systemId, outcome, createdAt])
}

model ChatAnswerExample {
  id               String          @id @default(cuid())
  tenantId         String
  systemId         String
  question         String          @db.Text // ข้อความลูกค้าที่นำไปสู่คำตอบนี้
  // 🔴 เก็บ "คำตอบที่ส่งจริง" ไม่ใช่ที่ AI เสนอ — ของมนุษย์คือความจริงเสมอ
  //    (ถ้าเก็บของ AI คลังจะเรียนรู้จากคำตอบที่ทีมเห็นว่าไม่ดีพอจนต้องแก้)
  answer           String          @db.Text
  channel          ChatChannelType
  lang             String?
  tags             Json            @default("[]")
  sourceMessageId  String? // ChatMessage.id ของคำตอบที่ส่งจริง
  fromSuggestionId String? // มาจาก AI ที่ถูกแก้แล้วส่ง (null = พิมพ์เองล้วน)
  useCount         Int             @default(0)
  lastUsedAt       DateTime?
  // ถอดตัวอย่างที่ไม่ดีออกได้โดยไม่ลบแถว — ของที่ลบทิ้งจะตรวจย้อนไม่ได้ว่าเคยแนะนำอะไรผิดไป
  archivedAt       DateTime?
  createdByUserId  String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // 🔴 PDPA: ตารางนี้เป็น "สำเนาเนื้อความอีกที่หนึ่ง" (question/answer) ⇒ ต้องถูกกวาดด้วย
  //    ChatSetting.retentionDays เหมือน lastMessagePreview ไม่งั้นข้อความที่ปกปิดแล้วยังโผล่ที่นี่
  @@index([systemId, archivedAt, createdAt])
  @@index([systemId, channel, lang])
}

// ─────────────── Settings (1 แถว/ระบบ) ───────────────

model ChatSetting {
  id                    String    @id @default(cuid())
  tenantId              String
  systemId              String    @unique
  memberSystemId        String? // 🔗 เชื่อมระบบ Member
  // 🔴 เวลาที่ "เจ้าของเลือกเอง" ว่าจะเชื่อมชุดไหน (รวมกรณีเลือก "ไม่เชื่อม")
  //    null = ยังไม่เคยเลือก → ระบบเชื่อมให้อัตโนมัติได้ถ้าร้านมีระบบสมาชิกชุดเดียว
  //    ถ้าไม่มีฟิลด์นี้ จะแยก "ยังไม่เคยตั้ง" กับ "ตั้งใจไม่เชื่อม" ไม่ออก แล้วระบบจะไปเชื่อมทับ
  //    ของที่เจ้าของตั้งใจปิดไว้ทุกครั้งที่เปิดหน้า (บทเรียนเดียวกับ businessHours ด้านล่าง)
  memberSystemChosenAt  DateTime?
  widgetEnabled         Boolean   @default(true)
  widgetDisabledUnitIds Json      @default("[]")
  // map ภาษาเปิด: { "<locale>": "ข้อความ" } เช่น { th, en, cn, ja, de } — เพิ่มภาษาได้โดยไม่ต้อง migrate
  greetingMessage       Json      @default("{}")
  offlineMessage        Json      @default("{}") // map ภาษาเปิดแบบเดียวกับ greetingMessage
  senderAlias           String? // ชื่อ default ที่ลูกค้าเห็นเวลาแอดมินตอบ (fallback ของ ChatMessage.senderName)
  theme                 Json      @default("{}") // หน้าตา widget ฝัง: { primaryColor, position, launcherIcon, ... }
  preChatFormEnabled    Boolean   @default(false)
  slaFirstResponseMin   Int       @default(15)
  unassignedAlertMin    Int       @default(5)
  retentionDays         Int       @default(365) // 90–730
  // เวลาทำการของทีมตอบแชท (WO-C16) — ส่งออกทาง GET /api/v1/chat/config
  // 🔴 null = "ร้านยังไม่ได้ตั้ง" → API คืน businessHours: null (ผู้รับ fallback เอง)
  //    ห้ามใช้ @default("{}") เพราะจะแยก "ไม่ได้ตั้ง" กับ "ตั้งแล้วว่าง" ไม่ออก
  // รูป: { tz: "Asia/Bangkok", note: {"<locale>":"…"} | "…", days: [{ d:0..6, open:"09:00", close:"18:00" }],
  //       holidays: ["2026-12-31"] }
  //  · วันที่ไม่อยู่ใน days = วันหยุดประจำสัปดาห์ (ไม่ต้องมีฟิลด์แยก)
  //  · holidays = วันหยุดเฉพาะกิจตามปฏิทินของเขตเวลานั้น
  //  · เป็น Json เพราะเพิ่มช่อง (เช่น พักเที่ยง/หลายช่วงต่อวัน) ได้โดยไม่ต้อง migrate ซ้ำ
  //    อ่าน/เขียนผ่าน src/lib/modules/chat/business-hours.ts เท่านั้น (ตรวจรูปที่นั่นที่เดียว)
  businessHours         Json?
  // ── AI + การแปล (WO-CW1) ──
  // 🔴 default false ทั้งคู่ (opt-in) เพราะทั้งสองอย่าง **มีค่าใช้จ่ายจริงต่อครั้ง** (~$0.008/ข้อความ)
  //    ของที่กินเงินของร้านต้องให้เจ้าของกดเปิดเอง ห้ามเปิดให้อัตโนมัติตอน migrate
  //    (ร้านที่มีอยู่ทั้งหมดจะได้ false = พฤติกรรมเดิมไม่เปลี่ยน)
  aiSuggestEnabled      Boolean   @default(false)
  translateEnabled      Boolean   @default(false)
  // ภาษาที่ "ทีมงานอ่าน" — คนละตัวกับ ChatContact.lang (ภาษาที่ลูกค้าใช้)
  // เป็นปลายทางของการแปลขาเข้า และเป็นต้นทางของการแปลขาออก
  // ไม่ nullable เพราะทุกร้านต้องมีภาษาอ่านเสมอ · ค่าเริ่ม "th" ตรงกับฐานลูกค้าวันนี้
  staffLang             String    @default("th")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─────────────── Rate limit bucket (บน Postgres — แก้ B2) ───────────────
// in-memory ต่อ process กันอะไรไม่ได้บน Vercel หลาย instance → ย้ายมาที่นี่
// แนวคิดลอกจาก siamdive2 `RateLimitBucket` (prisma/schema.prisma) แต่มี id/createdAt/updatedAt ตามแบบ repo นี้
// ตั้งใจไม่มี tenantId/systemId: key ถูกสร้างก่อนรู้ tenant (เช่น "chat:ip:1.2.3.4") — ดู scope.ts

model ChatRateBucket {
  id          String   @id @default(cuid())
  key         String   @unique // เช่น "chat:webchat:<connectionId>:<ip>"
  count       Int      @default(0)
  windowStart DateTime // ต้นหน้าต่างเวลาปัจจุบัน — เกินหน้าต่างแล้วรีเซ็ต count
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart]) // sweep แถวเก่าทิ้ง
}

// ─────────────── Webhook log (dedupe + debug) ───────────────

model ChatWebhookLog {
  id           String          @id @default(cuid())
  connectionId String? // null = resolve ไม่ได้ (webhookKey ผิด)
  channelType  ChatChannelType
  eventKey     String // event/message id ฝั่ง provider — dedupe ชั้นแรก
  status       String // RECEIVED | PROCESSED | DUPLICATE | FAILED
  error        String?
  payloadHash  String? // ไม่เก็บ payload เต็ม (PII)
  meta         Json?
  createdAt    DateTime        @default(now())

  @@unique([connectionId, eventKey])
  @@index([createdAt])
}
