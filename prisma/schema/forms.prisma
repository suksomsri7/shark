// Form builder v1 (WO-0054) — ฟอร์ม config ได้ + public link + submissions → CRM lead
model FormDef {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  publicToken String   @unique // ลิงก์สาธารณะ /f/<token>
  active      Boolean  @default(true)
  crmEnabled  Boolean  @default(false) // ส่ง submission เข้า CRM (ระบบ CRM ต้องเปิด)
  fieldsJson  Json     @default("[]") // [{key,label,type:text|phone|email|select|textarea,required,options?[]}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── crm_v2_b (C2.0 · ใช้โดย C2.6) — เพิ่มคอลัมน์ล้วน (nullable/default) · ไม่มี FK (ข้ามโมดูล · แถวเดิมไม่ถูกตรวจ)
  crmSystemId            String? // ระบบ CRM ปลายทาง (null = กติกาเดิม resolveFormCrmSystem: ระบบ CRM แรกของร้าน)
  assignRuleId           String? // CrmAssignmentRule.id
  utmCapture             Boolean @default(true)
  scoreOnSubmit          Int?
  createCompanyFromField String? // key ของฟิลด์ที่ใช้สร้างบริษัท
  spamGuard              Json? // {honeypot, minSeconds, rateLimit…} (C24)

  submissions FormSubmission[]

  @@index([tenantId, active])
}

model FormSubmission {
  id           String   @id @default(cuid())
  tenantId     String
  formId       String
  form         FormDef  @relation(fields: [formId], references: [id], onDelete: Cascade)
  answersJson  Json     @default("{}") // {key: value}
  crmContactId String? // CrmContact ที่เกิด (ถ้า crmEnabled)
  ip           String?
  createdAt    DateTime @default(now())
  // ── crm_v2_b (C2.0 · C2.6) — ที่มาของการส่งฟอร์ม · nullable ทั้งหมด
  utm          Json?
  pageUrl      String?
  referrer     String?
  webSessionId String? // CrmWebSession.id (ไม่มี FK)

  @@index([formId, createdAt])
  @@index([tenantId])
}
