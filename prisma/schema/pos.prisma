// POS (14) — จุดตัดเงินกลาง (scope=unit). ทุกโมดูลชำระเงินผ่าน createSale
// MVP: PAID_NOW + เงินสด/โอน/PromptPay + เลขใบเสร็จรันต่อ unit/เดือน
// 🔜: PENDING_PAYMENT intent, VAT, coupon, account posting, ROOM_CHARGE provider, กะ/สต็อก/สินค้า

enum PosSaleStatus {
  PAID
  VOIDED
  REFUNDED
}

enum PosPayType {
  CASH
  TRANSFER
  PROMPTPAY
  DEPOSIT
  ROOM_CHARGE
  CARD // P1.6: บัตร (EDC/อ้างอิงมือ · ไม่มีเกตเวย์ — P1.7)
}

// P1.8 — ชนิดเอกสารของ PosSale (enum ใหม่ ⇒ ไม่มี ALTER TYPE … ADD VALUE) · ใบคืนเงิน = เอกสารใหม่ ไม่ใช่แก้บิลเดิม (มติ R1)
enum PosSaleDocType {
  SALE
  REFUND
}

model PosSale {
  id               String        @id @default(cuid())
  tenantId         String
  unitId           String
  systemId         String // ระบบ POS ไหน (scope)
  memberId         String? // Customer.id
  sourceModule     String        @default("POS") // POS | BOOKING | HOTEL | RESTAURANT | TICKET
  sourceId         String?
  idempotencyKey   String
  receiptNo        String?
  status           PosSaleStatus @default(PAID)
  subtotalSatang   Int
  discountSatang   Int           @default(0)
  vatSatang        Int           @default(0)
  grandTotalSatang Int
  pointEarned      Int           @default(0)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // ── M1.1 (ระบบสมาชิก v2 · §4.1) — ร่องรอยสิทธิ์สมาชิกที่ใช้กับบิลใบนี้ · เพิ่มคอลัมน์ล้วน ──
  // 🔴 ยังไม่มีโค้ดเขียนค่าเหล่านี้ในใบ M1.1 (ตาราง Voucher/StampEvent/GiftCard เกิดที่ M2.x)
  //    ใบนี้เตรียมช่องไว้ก่อนเพื่อให้ migration เป็นก้อนเดียว — บิลเดิมทุกใบได้ค่าว่าง/0 = พฤติกรรมเดิมเป๊ะ
  voucherUseIds     String[] @default([]) // Voucher.id ที่ใช้กับบิลนี้ (M2.5)
  giftCardTxnId     String? // GiftCardTxn.id ที่ตัดยอดบัตรของขวัญ (M2.6)
  tierDiscountSatang Int     @default(0) // ส่วนลดจากสิทธิ์ระดับสมาชิก (M1.9)
  stampEventIds     String[] @default([]) // StampEvent.id ที่บิลนี้ทำให้เกิด (M2.3)
  attributionId     String? // MemberAttribution.id ที่ยกความดีความชอบให้ช่องทางไหน (M1.8)

  // ── M2.6 — บิลใบนี้คือ "ขาย/เติมบัตรกำนัล" (GiftCard.id) ──────────────────────────────
  // 🔴 consumer `pos.sale.paid` ต้อง **ข้าม** บิลที่มีค่านี้: ไม่ให้แต้ม · ไม่ลงบัญชีขาย
  //    (โมดูล giftcard ลงบัญชีเองเป็น "รับเงินล่วงหน้า" 2110 — ขายบัตร ≠ รายได้ · §9.1 §9.4)
  giftCardId        String?

  // ── P1.6 — จอชำระเงิน · เพิ่มคอลัมน์ล้วน (บิลเดิม = null/0 = พฤติกรรมเดิม) ──
  note                String? // หมายเหตุบิล (≤500)
  serviceChargeSatang Int     @default(0) // ค่าบริการ — อยู่ใน grandTotal และในฐาน VAT
  tipSatang           Int     @default(0) // ทิป — ไม่อยู่ใน grandTotal · ไม่ใช่รายได้ · Σจ่าย = grandTotal + tip

  // ── P1.9 — กะ/ลิ้นชัก · เพิ่มคอลัมน์ล้วน (บิลเดิม = null = นอกกะ) ──
  // id หลวม (ไม่มี FK · metadata-only แบบ M1) · index สร้างใน P6.1 ด้วย CREATE INDEX CONCURRENTLY นอก prisma migrate
  shiftId             String? // PosShift.id ที่บิลนี้ผูก (createSale ล็อกแถวกะ FOR SHARE ในtx ของบิล)

  // ── P1.17 — ผู้ขายของบิล (R6 · Q17.1) · เพิ่มคอลัมน์ล้วน (บิลเดิม = null → รายงานใช้ผู้เปิดกะ / "ไม่ระบุ") ──
  // id หลวม (User.id · ไม่มี FK · ไม่มี index แบบ shiftId) · หน้าขาย (submitRegisterSale) + หน้าขายเดิม (actions/pos.ts) เขียน · โมดูลอื่น = null
  soldByUserId        String?

  // ── P1.8 — คืนเงินบางส่วน/ใบลดหนี้ · เพิ่มคอลัมน์ล้วน (บิลเดิม = SALE/null/0 = พฤติกรรมเดิม) ──
  // ใบ REFUND: ยอดเป็นบวกทั้งหมด ตีความตาม docType · status PAID (เงินออกแล้ว) · soldByUserId = ผู้คืน · note = เหตุผล
  // refSaleId = id หลวมของบิล SALE เดิม (ไม่มี FK · index สร้างใน P6.1 ด้วย CREATE INDEX CONCURRENTLY)
  docType             PosSaleDocType @default(SALE)
  refSaleId           String?
  refundedSatang      Int            @default(0) // บนบิล SALE: ยอดที่คืนไปแล้วสะสม (สุทธิ = grandTotal − refundedSatang)
  reasonCode          String? // ใบ REFUND: DAMAGED | WRONG_ITEM | CHANGED_MIND | OTHER

  // ── P1.11 — ใบเสร็จออนไลน์ /r/<token> · เพิ่มคอลัมน์ล้วน (บิลเดิม = null → ได้โทเคนแบบขี้เกียจผ่าน ensureReceiptToken) ──
  // 12 ตัว Crockford base32 จาก crypto.randomBytes · ตั้งใน tx ของ createSale/refundSale · ไม่เปลี่ยนตลอดอายุบิล · ค้นด้วย unique index เท่านั้น (R9)
  publicToken         String?        @unique

  lines    PosSaleLine[]
  payments PosPayment[]

  @@unique([tenantId, idempotencyKey])
  @@unique([unitId, receiptNo])
  @@index([tenantId, unitId, createdAt])
}

model PosSaleLine {
  id              String  @id @default(cuid())
  tenantId        String
  unitId          String
  saleId          String
  sale            PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name            String
  qty             Int
  unitPriceSatang Int
  discountSatang  Int     @default(0)
  lineTotalSatang Int
  itemId          String? // InvItem.id ที่ผูก (ตัด/คืนสต็อก perpetual) · null = บริการ/รายการเพิ่มเอง (ไม่ตัดสต็อก)
  serviceId       String? // BookingService.id ที่ผูก — ใช้แยกยอด "สินค้า vs บริการ" ในรายงาน
  // (itemId=null อย่างเดียวแยกไม่ออกว่าเป็นบริการหรือรายการพิมพ์เอง)
  productId       String? // P1.1a: PosProduct.id (แคตตาล็อกเดียว) · id หลวมแบบ itemId/serviceId · null = บิลเดิม
  note            String? // P1.6: หมายเหตุบรรทัด/เหตุผลส่วนลด (≤500)
  // ── P1.2 — เพิ่มคอลัมน์ล้วน (บิลเดิม = null = พฤติกรรมเดิม) ──
  components      Json? // ชุด/คอมโบ: สำเนาส่วนประกอบตอนขาย [{invItemId, qty}] ต่อ 1 หน่วย · ตัดสต็อก qty × line.qty คีย์ pos-consume-<sale>-<line>-<invItem>
  weightGrams     Int? // สินค้าชั่ง: น้ำหนัก (กรัม) ของบรรทัด (qty = 1 เสมอ) · ตัดสต็อกเป็นกรัม
  // ── P1.8 — บรรทัดของใบ REFUND เท่านั้น (บิลขาย = null) ──
  refLineId       String? // PosSaleLine.id ของบิลเดิม (id หลวม)
  restock         Boolean? // true = รับของคืนเข้าคลัง · false = ไม่รับ (ของเสีย — ต้นทุนขายคงอยู่)
  options         PosSaleLineOption[]

  @@index([saleId])
  // P1.1a: index ของคอลัมน์นี้เพิ่มใน P6.1 ด้วย CREATE INDEX CONCURRENTLY นอก prisma migrate (round 2 M1)
}

// P1.2 — ตัวเลือกที่เลือกบนบรรทัดบิล (สำเนา ณ เวลาขาย แบบ RestaurantOrderItemOption) · ราคาตัวเลือกที่แก้ทีหลังไม่กระทบบิลเดิม
// PosSaleLine.unitPriceSatang = ราคาเต็มต่อหน่วย (ฐาน + Σ priceDeltaSatang) อยู่แล้ว ⇒ สะพานบัญชี/รายงาน/คืนเงินไม่ต้องอ่านตารางนี้
model PosSaleLineOption {
  id               String      @id @default(cuid())
  tenantId         String
  saleId           String // PosSale.id (id หลวม · มี index)
  lineId           String
  line             PosSaleLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  choiceId         String // MenuOptionChoice.id ณ เวลาขาย (id หลวม — ตัวเลือกถูกเก็บถาวรได้)
  groupId          String // MenuOptionGroup.id ณ เวลาขาย
  groupName        String
  choiceName       String
  priceDeltaSatang Int // สตางค์ต่อหน่วย ติดลบได้

  @@index([tenantId])
  @@index([saleId])
  @@index([lineId])
}

model PosPayment {
  id           String     @id @default(cuid())
  tenantId     String
  unitId       String
  saleId       String
  sale         PosSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type         PosPayType
  amountSatang Int
  refSaleId    String? // DEPOSIT/ROOM_CHARGE อ้างบิลเดิม
  note         String?
  // P1.6 — เงินรับ/ทอน อยู่ที่แถว CASH เท่านั้น (มติ §8 ข้อ 2) · reference = เลขอ้างอิงบัตร/EDC/โอน
  tenderedSatang Int?
  changeSatang   Int?
  reference      String?

  @@index([saleId])
}

// เลขใบเสร็จรันต่อ unit ต่อเดือน
model PosReceiptCounter {
  id       String @id @default(cuid())
  tenantId String
  unitId   String
  period   String // YYYYMM
  seq      Int    @default(0)

  @@unique([unitId, period])
}

// P1.8 — เลขเอกสารที่ไม่ใช่ใบเสร็จขาย (ใบคืนเงิน CN${YYYYMM}-NNNN) ต่อสาขา/ชนิด/เดือน (มติ R4 · O2)
//   ใบเสร็จขายยังใช้ PosReceiptCounter เดิม (การย้ายเข้าตารางนี้เลื่อนไป P1.10/P6.1) · จองเลขใน tx ของใบคืน (upsert + increment)
model PosDocCounter {
  id       String         @id @default(cuid())
  tenantId String
  unitId   String
  docType  PosSaleDocType
  period   String // YYYYMM
  seq      Int            @default(0)

  @@unique([unitId, docType, period])
}

// ═══════════════════ P1.1a — แคตตาล็อกเดียว (PosProduct) · ตารางใหม่ล้วน ═══════════════════
// ขอบเขต (มติ R1): tenantId + systemId (AppSystem type POS) · unitId null = ขายทุกสาขาของระบบนี้
//   · invItemId null = ไม่ผูกคลัง (เมนู/สินค้าเว็บล้วน) · ไม่ซ้ำต่อ (systemId, invItemId) เมื่อมีค่า
// ผู้เขียนเดียว = src/lib/modules/pos/catalog.ts (fitness F15.1) · P1.1a ยังไม่มี dual-write (P1.1b)
// 🔴 ฟิลด์เมนู (stationId · stockQty · dailyStockQty · isOutOfStock) และช่วงเวลาขายของหมวด = **สำเนาอย่างเดียว**
//    ต้นฉบับที่ระบบใช้จริงยังเป็น MenuItem/MenuCategory จนถึง P1.1b/P2.4 — ห้ามอ่านค่าพวกนี้ไปตัดสินการขาย

enum PosProductKind {
  PRODUCT
  SERVICE
  MENU
  BUNDLE
}

model PosCategory {
  id            String    @id @default(cuid())
  tenantId      String
  systemId      String // AppSystem.id (type POS)
  unitId        String? // null = ทุกสาขาของระบบ POS นี้ · มีค่า = หมวดของสาขานั้น (หมวดเมนูเป็นของสาขา)
  name          String
  nameEn        String?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true) // สำเนาจาก MenuCategory.isVisible
  availableFrom String? // สำเนาจาก MenuCategory (ช่วงเวลาขาย "06:00") — ต้นฉบับยังอยู่ที่ MenuCategory
  availableTo   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products PosProduct[]

  @@unique([systemId, unitId, name])
  /// 🔴 M5: หมวด "ทุกสาขา" (unitId null) ห้ามชื่อซ้ำในระบบเดียว — unique ข้างบนกันไม่ได้ (NULL ไม่เท่ากัน)
  ///    บังคับด้วย **partial unique index** ใน migration 20261120000000_pos_v2_a:
  ///      CREATE UNIQUE INDEX "PosCategory_systemId_name_all_branches_key" ON "PosCategory"("systemId","name") WHERE "unitId" IS NULL;
  ///    (แบบเดียวกับ AccountProduct_systemId_code_active_key) · `prisma migrate diff` มองไม่เห็น → ห้ามลบออกจาก migration
  @@index([tenantId])
}

model PosProduct {
  id                 String         @id @default(cuid())
  tenantId           String
  systemId           String // AppSystem.id (type POS) — ระบบที่ขายแถวนี้
  unitId             String? // null = ทุกสาขาของระบบ POS นี้
  invItemId          String? // InvItem.id (ต้นฉบับ "ของ" · สต็อก/ต้นทุน/บาร์โค้ด/SKU) · null = ไม่ผูกคลัง
  parentId           String? // R3: แม่ของตัวแปร (ขนาด/สี) — P1.2 เป็นเจ้าของ · P1.1a ว่างไว้
  parent             PosProduct?    @relation("PosProductVariants", fields: [parentId], references: [id], onDelete: SetNull)
  children           PosProduct[]   @relation("PosProductVariants")
  kind               PosProductKind @default(PRODUCT)
  name               String
  nameEn             String?
  categoryId         String?
  category           PosCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePriceSatang    Int? // สตางค์ · null = ยังไม่ตั้งราคา (ไม่ใช้ต้นทุนแทน) · 0 = ตั้งใจให้ฟรี
  vatRateBp          Int? // สำเนาจาก AccountProduct.vatRateBp · null = ไม่มีบัญชีผูก
  barcode            String? // บาร์โค้ดของแถวนี้เอง (แถวที่ผูกคลังใช้ InvItem.barcode — ไม่คัดลอก)
  images             Json           @default("[]") // ["url", …] index 0 = ปก
  sortOrder          Int            @default(0)
  trackStock         Boolean? // C2 tri-state: null = AUTO (คิดตอนอ่าน: ผูก InvItem + PRODUCT + มี movement หรือ onHand ≠ 0) · true/false = ร้านตั้งเอง
  unavailableUnitIds String[]       @default([]) // สาขาที่ปิดขายชั่วคราว (availability[unit] = false)
  // ── สำเนาจาก MenuItem (copy-only ถึง P1.1b/P2.4) ──
  stationId          String? // KdsStation.id
  stockQty           Int?
  dailyStockQty      Int?
  isOutOfStock       Boolean        @default(false)
  // ── P1.2 สินค้าชั่ง — basePriceSatang = ราคาต่อกิโลกรัม · สต็อกนับเป็นกรัม ──
  soldByWeight       Boolean        @default(false)
  /// รหัสสินค้าบนป้ายเครื่องชั่ง (5 หลัก) · ไม่ซ้ำในแถวที่ยังไม่เก็บถาวรของระบบ POS เดียว =
  /// partial unique `PosProduct_systemId_scalePlu_active_key` (SQL เขียนมือใน migration 20261124000000_pos_p12_options · prisma มองไม่เห็น WHERE)
  scalePlu           String?
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  optionGroups PosProductOptionGroup[]
  recipeLines  RecipeLine[]

  @@unique([systemId, invItemId])
  @@index([tenantId])
  @@index([systemId, archivedAt, name, id]) // M4: ลำดับของ listForUnit (keyset ชื่อ+id)
  @@index([systemId, barcode])
  @@index([parentId])
}

// ผูกสินค้า ↔ กลุ่มตัวเลือกเดิมของร้านอาหาร (MenuOptionGroup ใช้ต่อ ไม่สร้างใหม่ · ต่อสาขาเหมือนเดิม)
model PosProductOptionGroup {
  id        String     @id @default(cuid())
  tenantId  String
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String // MenuOptionGroup.id (คนละไฟล์ schema — id หลวมแบบเดียวกับ MenuItem.invItemId)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([productId, groupId])
  @@index([tenantId])
  @@index([groupId])
}

// สูตร/BOM: ขาย 1 หน่วยของ productId ใช้ InvItem เท่าไร (P2.3 เป็นเจ้าของ) · P1.1a: เมนูที่มี MenuItem.invItemId → 1 แถว qty 1
model RecipeLine {
  id        String     @id @default(cuid())
  tenantId  String
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  invItemId String // InvItem.id (หน่วยเดียวกับ InvMovement — จำนวนเต็ม)
  qty       Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([productId, invItemId])
  @@index([tenantId])
  @@index([invItemId])
}

// ═══════════════════ P1.5 — พักบิล / เรียกคืน (PosHeldCart) · ตารางใหม่ล้วน (มติ H1) ═══════════════════
// ขอบเขต: ต่อสาขา (tenantId + systemId POS + unitId) · ทุกผู้ใช้หน้าขายของสาขาเห็น · id หลวม (ไม่มี FK) แบบ PosProduct
// ผู้เขียนเดียว = src/lib/modules/pos/held-cart.ts · cartJson = { cart: RegisterQuoteInput ที่ผ่านการตรวจแล้ว, heldUnitPrices }
//   🔴 ราคาใน cartJson ไม่ถูกเชื่อ — เรียกคืนแล้วคิดราคาใหม่ผ่าน quoteRegisterCart เสมอ (H3) · heldUnitPrices ใช้แค่บอก "ราคาเปลี่ยน"
// เรียกคืน = UPDATE … WHERE id AND status='HELD' (ผู้ชนะคนเดียว · H2) · หมดอายุแบบขี้เกียจตอน list (H4 · ไม่มี cron)

enum PosHeldCartStatus {
  HELD
  RECALLED
  DISCARDED
}

model PosHeldCart {
  id                String            @id @default(cuid())
  tenantId          String
  unitId            String // BusinessUnit.id — สาขาที่พัก (เห็น/เรียกคืนได้เฉพาะสาขานี้)
  systemId          String // AppSystem.id (type POS)
  label             String? // ≤ 60 ตัวอักษร (ตรวจใน held-cart.ts) · null = ไม่ตั้งป้าย
  cartJson          Json
  lineCount         Int
  approxTotalSatang Int // ยอด quote ของเซิร์ฟเวอร์ ณ ตอนพัก (ไว้แสดงในลิ้นชักเท่านั้น)
  heldByUserId      String
  recalledAt        DateTime?
  recalledByUserId  String?
  status            PosHeldCartStatus @default(HELD)
  createdAt         DateTime          @default(now())
  version           Int               @default(1)

  @@index([unitId, status, createdAt])
}

// ═══════════════════ P1.9 — กะ · ลิ้นชักเงินสด · X/Z · บังคับปิด (มติ S1–S16 · ตารางใหม่ล้วน) ═══════════════════
// ผู้เขียนเดียว = src/lib/modules/pos/shift.ts · เครื่อง = deviceId ทึบ (P1.10 เพิ่ม PosDevice + FK ทีหลัง)
// 1 กะ OPEN ต่อ (สาขา, เครื่อง) = partial unique `one_open_shift_per_device` (SQL เขียนมือใน migration)
// Z แช่แข็ง: zReport เขียนครั้งเดียวตอนปิด ไม่มีโค้ดใดเขียนแถวที่ปิดแล้วอีก
// 🔴 ไม่มี PIN ที่นี่ — PIN เป็นของ HR (verifyPin · P1.15/P3.5)

enum PosShiftStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

enum PosCashMoveKind {
  IN
  OUT
}

model PosShift {
  id                 String         @id @default(cuid())
  tenantId           String
  unitId             String
  systemId           String // AppSystem.id (type POS)
  deviceId           String // [A-Za-z0-9_-]{8,64} จาก client
  deviceLabel        String? // ≤ 40
  shiftNo            Int // จากตัวนับต่อสาขา (PosShiftCounter.shiftSeq)
  status             PosShiftStatus @default(OPEN)
  openedByUserId     String
  openedAt           DateTime       @default(now())
  floatSatang        Int // เงินทอนตั้งต้น
  floatDetail        Json? // { "<ธนบัตรสตางค์>": จำนวน }
  closedByUserId     String? // null = ระบบบังคับปิด
  closedAt           DateTime?
  expectedCashSatang Int?
  countedCashSatang  Int?
  overShortSatang    Int? // counted − expected
  countDetail        Json?
  countedByMethod    Json? // { CARD: 2900, PROMPTPAY: 4000 } ยอดที่นับ/กระทบได้ของวิธีอื่น
  closeNote          String?
  closeKey           String? // idempotencyKey ของการปิดที่ชนะ
  zNumber            Int? // เลข Z ต่อสาขา (PosShiftCounter.zSeq) เรียงตามลำดับปิด ไม่มีช่องว่าง
  zReport            Json? // Z แช่แข็ง (ShiftReport + ผลนับ)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([unitId, shiftNo])
  @@unique([unitId, zNumber])
  @@index([tenantId, unitId, status])
}

model PosCashMovement {
  id             String          @id @default(cuid())
  tenantId       String
  unitId         String
  shiftId        String // PosShift.id (id หลวม ไม่มี FK แบบ PosHeldCart)
  kind           PosCashMoveKind
  amountSatang   Int // > 0
  reason         String // 1–200
  byUserId       String
  idempotencyKey String
  createdAt      DateTime        @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([shiftId])
}

model PosShiftCounter {
  id       String @id @default(cuid())
  tenantId String
  unitId   String @unique
  shiftSeq Int    @default(0)
  zSeq     Int    @default(0)
}

// POS P1.9b — ผู้จัดการนับเงินย้อนหลังของกะที่ระบบบังคับปิด (Q9.4 · มติ R1) · 1 แถวต่อกะ ครั้งเดียวจบ (R6)
//   ผู้เขียนเดียว = pos/shift.ts recountShift · แถว PosShift ของกะไม่ถูกเขียนอีก (Z แช่แข็ง R3) · shiftId = id หลวม ไม่มี FK
model PosShiftRecount {
  id                 String   @id @default(cuid())
  tenantId           String
  unitId             String
  systemId           String // AppSystem.id (type POS)
  shiftId            String   @unique // PosShift.id — 1 ครั้งต่อกะ · ดัชนีนี้ตัดสินการแข่ง (R11)
  zNumber            Int // สำเนาจาก PosShift.zNumber
  expectedCashSatang Int // สำเนาจาก PosShift.expectedCashSatang (Z แช่แข็ง · R4)
  countedCashSatang  Int
  varianceSatang     Int // counted − expected
  countDetail        Json? // { "<ธนบัตรสตางค์>": จำนวน }
  note               String // 1–200 (บังคับ)
  recountedByUserId  String
  idempotencyKey     String
  createdAt          DateTime @default(now()) // = เวลานับ (recountedAt)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId, createdAt])
}

// POS P1.10 — ทะเบียนเครื่องขาย (มติ R1–R3 · ledger/pos-briefs/pos-brief-P1.10.md) · ผู้เขียนเดียว = pos/device.ts
//   deviceCode = รหัสเครื่องของ P1.9 (localStorage · [A-Za-z0-9_-]{8,64}) ⇒ กะ/บิลที่ผูกรหัสนี้อยู่แล้วคงความหมายเดิม
//   id หลวม ไม่มี FK (แบบ PosShift) · REVOKED = ขาย/เปิดกะ/พัก/เรียกคืนจากเครื่องนี้ไม่ได้ (สาขาเดียวกัน)
//   printerConfig = ค่าที่ผ่าน parsePrinterConfig แล้วเท่านั้น (device-shared.ts)
enum PosDeviceStatus {
  ACTIVE
  REVOKED
}

model PosDevice {
  id                 String          @id @default(cuid())
  tenantId           String
  unitId             String // BusinessUnit.id
  systemId           String // AppSystem.id (type POS)
  name               String // 1–60
  deviceCode         String // [A-Za-z0-9_-]{8,64} = PosShift.deviceId
  status             PosDeviceStatus @default(ACTIVE)
  registeredByUserId String
  lastSeenAt         DateTime? // heartbeat (เขียนไม่ถี่กว่า 30 วินาที) · online = ภายใน 120 วินาที
  posRegNo           String? // เลขประจำเครื่อง POS (กรมสรรพากร) — พิมพ์บนใบกำกับภาษีอย่างย่อ
  printerConfig      Json? // { paper, mode, autoPrint, drawerKick, thaiText, copies }
  revokedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([unitId, deviceCode])
  @@index([tenantId, unitId, status])
}

// POS P1.14 — ตรวจนับสต็อกจากหน้าขาย (มติ R1 · ledger/pos-briefs/pos-brief-P1.14.md) · ผู้เขียนเดียว = pos/stock-count.ts
//   id หลวม ไม่มี FK (แบบ PosShift) · 1 รอบ OPEN ต่อ (คลัง × ที่เก็บ) = partial unique เขียนมือใน migration
//   (PosStockCount_open_location_key ON ("inventorySystemId","locationId") WHERE status = 'OPEN' — prisma แสดง WHERE ไม่ได้)
//   จำนวนเป็นหน่วยสต็อกของสินค้า (ชิ้น · กรัมสำหรับสินค้าชั่ง P1.2) · เงินเป็นสตางค์
enum PosStockCountStatus {
  OPEN
  CONFIRMED
  CANCELLED
}

enum PosStockCountScope {
  ALL
  CATEGORY
}

model PosStockCount {
  id                String              @id @default(cuid())
  tenantId          String
  systemId          String // AppSystem.id (type POS)
  unitId            String
  inventorySystemId String // AppSystem.id (type INVENTORY) ของสาขา ณ ตอนเปิด
  locationId        String // InvLocation.id ที่นับ
  countNo           Int // เลขรอบต่อสาขา 1,2,3… ("ตรวจนับ #7")
  scope             PosStockCountScope
  categoryIds       String[]            @default([]) // InvCategory.id (scope CATEGORY)
  blind             Boolean             @default(false)
  status            PosStockCountStatus @default(OPEN)
  note              String?
  snapshotAt        DateTime
  openedByUserId    String
  openKey           String
  confirmKey        String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  cancelKey         String?
  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([tenantId, openKey])
  @@unique([unitId, countNo])
  @@index([tenantId, unitId, status])
}

model PosStockCountLine {
  id              String    @id @default(cuid())
  tenantId        String
  countId         String // PosStockCount.id (id หลวม)
  itemId          String // InvItem.id
  snapshotQty     Int // ยอดที่ที่เก็บ ณ เปิดรอบ (ข้อมูลประกอบ)
  countedQty      Int? // ยอดที่นับได้ (null = ยังไม่นับ)
  expectedAtCount Int? // ยอดระบบที่ที่เก็บ ณ รายการนับล่าสุด (อ่านใต้ล็อกสินค้า · R6)
  countedAt       DateTime?
  varianceQty     Int? // countedQty − expectedAtCount (แช่แข็งตอนยืนยัน)
  costSatang      Int? // ต้นทุนเฉลี่ยของสินค้า ณ ยืนยัน
  movementId      String? // InvMovement.id ของ ADJUST (ผลต่าง ≠ 0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([countId, itemId])
  @@index([tenantId])
}

model PosStockCountEntry {
  id             String   @id @default(cuid())
  tenantId       String
  countId        String
  lineId         String
  itemId         String
  mode           String // "SET" | "ADD"
  qty            Int
  code           String? // รหัสที่สแกน (บาร์โค้ด/SKU/ป้ายเครื่องชั่ง)
  byUserId       String
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([countId])
}

// ── POS P1.11 — ลูกค้าแจ้งปัญหาบิลจากหน้าใบเสร็จออนไลน์ (R4) · ผู้เขียนเดียว = pos/receipt-issue.ts (+ kanbanCardId จาก pos-receipt-bridges.ts) ──
//   saleId = id หลวมของบิล SALE (ไม่มี FK) · เพดาน 3 ครั้ง/บิล/24 ชม. นับจากแถวเอง (CD4 — ไม่มีตารางตัวนับ)
enum PosReceiptIssueStatus {
  OPEN
  RESOLVED
}

model PosReceiptIssue {
  id           String                @id @default(cuid())
  tenantId     String
  unitId       String
  saleId       String // PosSale.id (SALE)
  message      String // 1–500 (ตัดช่องว่างแล้ว)
  contact      String? // ≤120 (ไม่บังคับ)
  status       PosReceiptIssueStatus @default(OPEN)
  kanbanCardId String? // KanbanCard.id ที่ consumer เปิด (id หลวม · null = ยังไม่มี/ร้านไม่มีบอร์ด)
  createdAt    DateTime              @default(now())

  @@index([tenantId, saleId, createdAt])
}

// ── POS P1.11 — คำขอใบกำกับภาษีเต็มรูปจากหน้าใบเสร็จออนไลน์ (R5) · ผู้เขียน = pos/receipt-tax-request.ts · P1.13 ออกเอกสาร (accountDocId) ──
//   1 คำขอที่ยังเปิด (REQUESTED/ISSUED) ต่อบิล — ตัดสินใต้ล็อกแถวบิล (FOR UPDATE) · taxId ตรวจรูปแบบอย่างเดียว (DBD = P1.13)
enum PosTaxInvoiceRequestStatus {
  REQUESTED
  ISSUED
  REJECTED
}

model PosTaxInvoiceRequest {
  id           String                     @id @default(cuid())
  tenantId     String
  unitId       String
  saleId       String // PosSale.id (SALE)
  name         String // ชื่อผู้ซื้อ/บริษัท
  taxId        String // 13 หลัก
  branchCode   String                     @default("00000") // 5 หลัก
  address      String
  email        String?
  status       PosTaxInvoiceRequestStatus @default(REQUESTED)
  accountDocId String? // AccountDocument.id ของใบกำกับเต็มรูป (P1.13)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([tenantId, saleId])
  @@index([tenantId, status, createdAt])
// POS P1.7 — ใบขอรับเงิน (payment intent) ของส่วนที่ไม่ใช่เงินสด ก่อนบิลเกิด
//   PromptPay ไดนามิก (QR ล็อกยอด) · Beam (PromptPay ยืนยันอัตโนมัติ + บัตร) · ยืนยันเอง (มี audit)
//   ผู้เขียนเดียว = src/lib/modules/pos/payment-intent.ts · บิลใช้ intent ได้ครั้งเดียวใน submitRegisterSale (FOR UPDATE)
//   id = "pi_" + สุ่ม (ไม่ใช่ cuid) ⇒ เลขอ้างอิงในวิธีจ่ายบอกได้ทันทีว่าเป็น intent
model PosPaymentIntent {
  id                String    @id
  tenantId          String
  unitId            String
  systemId          String // ระบบ POS
  kind              String // "PROMPTPAY_STATIC" | "PROMPTPAY_BEAM" | "CARD_BEAM"
  amountSatang      Int
  status            String // "PENDING" | "PAID" | "CONSUMED" | "EXPIRED" | "CANCELLED"
  qrPayload         String? // EMV ของ QR (STATIC/Beam) · บัตร = URL หน้าชำระของ Beam
  beamChargeId      String?
  beamRef           String? // chargeId ที่ webhook ยืนยัน
  deviceId          String
  createdByUserId   String
  confirmedVia      String? // "WEBHOOK" | "MANUAL"
  confirmedByUserId String?
  paidAt            DateTime?
  expiresAt         DateTime
  saleId            String? // บิลที่ใช้ intent นี้ (CONSUMED)
  lateWebhook       Boolean   @default(false) // เงินเข้าหลังหมดเวลา (เงินจริง — ยังใช้ได้ใน 24 ชม.)
  idempotencyKey    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId, status, createdAt])
  @@index([beamChargeId])
}
