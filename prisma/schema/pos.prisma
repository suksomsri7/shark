// POS (14) — จุดตัดเงินกลาง (scope=unit). ทุกโมดูลชำระเงินผ่าน createSale
// MVP: PAID_NOW + เงินสด/โอน/PromptPay + เลขใบเสร็จรันต่อ unit/เดือน
// 🔜: PENDING_PAYMENT intent, VAT, coupon, account posting, ROOM_CHARGE provider, กะ/สต็อก/สินค้า

enum PosSaleStatus {
  PAID
  VOIDED
  REFUNDED
}

enum PosPayType {
  CASH
  TRANSFER
  PROMPTPAY
  DEPOSIT
  ROOM_CHARGE
}

model PosSale {
  id               String        @id @default(cuid())
  tenantId         String
  unitId           String
  systemId         String // ระบบ POS ไหน (scope)
  memberId         String? // Customer.id
  sourceModule     String        @default("POS") // POS | BOOKING | HOTEL | RESTAURANT | TICKET
  sourceId         String?
  idempotencyKey   String
  receiptNo        String?
  status           PosSaleStatus @default(PAID)
  subtotalSatang   Int
  discountSatang   Int           @default(0)
  vatSatang        Int           @default(0)
  grandTotalSatang Int
  pointEarned      Int           @default(0)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // ── M1.1 (ระบบสมาชิก v2 · §4.1) — ร่องรอยสิทธิ์สมาชิกที่ใช้กับบิลใบนี้ · เพิ่มคอลัมน์ล้วน ──
  // 🔴 ยังไม่มีโค้ดเขียนค่าเหล่านี้ในใบ M1.1 (ตาราง Voucher/StampEvent/GiftCard เกิดที่ M2.x)
  //    ใบนี้เตรียมช่องไว้ก่อนเพื่อให้ migration เป็นก้อนเดียว — บิลเดิมทุกใบได้ค่าว่าง/0 = พฤติกรรมเดิมเป๊ะ
  voucherUseIds     String[] @default([]) // Voucher.id ที่ใช้กับบิลนี้ (M2.5)
  giftCardTxnId     String? // GiftCardTxn.id ที่ตัดยอดบัตรของขวัญ (M2.6)
  tierDiscountSatang Int     @default(0) // ส่วนลดจากสิทธิ์ระดับสมาชิก (M1.9)
  stampEventIds     String[] @default([]) // StampEvent.id ที่บิลนี้ทำให้เกิด (M2.3)
  attributionId     String? // MemberAttribution.id ที่ยกความดีความชอบให้ช่องทางไหน (M1.8)

  // ── M2.6 — บิลใบนี้คือ "ขาย/เติมบัตรกำนัล" (GiftCard.id) ──────────────────────────────
  // 🔴 consumer `pos.sale.paid` ต้อง **ข้าม** บิลที่มีค่านี้: ไม่ให้แต้ม · ไม่ลงบัญชีขาย
  //    (โมดูล giftcard ลงบัญชีเองเป็น "รับเงินล่วงหน้า" 2110 — ขายบัตร ≠ รายได้ · §9.1 §9.4)
  giftCardId        String?

  lines    PosSaleLine[]
  payments PosPayment[]

  @@unique([tenantId, idempotencyKey])
  @@unique([unitId, receiptNo])
  @@index([tenantId, unitId, createdAt])
}

model PosSaleLine {
  id              String  @id @default(cuid())
  tenantId        String
  unitId          String
  saleId          String
  sale            PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name            String
  qty             Int
  unitPriceSatang Int
  discountSatang  Int     @default(0)
  lineTotalSatang Int
  itemId          String? // InvItem.id ที่ผูก (ตัด/คืนสต็อก perpetual) · null = บริการ/รายการเพิ่มเอง (ไม่ตัดสต็อก)
  serviceId       String? // BookingService.id ที่ผูก — ใช้แยกยอด "สินค้า vs บริการ" ในรายงาน
  // (itemId=null อย่างเดียวแยกไม่ออกว่าเป็นบริการหรือรายการพิมพ์เอง)
  productId       String? // P1.1a: PosProduct.id (แคตตาล็อกเดียว) · id หลวมแบบ itemId/serviceId · null = บิลเดิม

  @@index([saleId])
  // P1.1a: index ของคอลัมน์นี้เพิ่มใน P6.1 ด้วย CREATE INDEX CONCURRENTLY นอก prisma migrate (round 2 M1)
}

model PosPayment {
  id           String     @id @default(cuid())
  tenantId     String
  unitId       String
  saleId       String
  sale         PosSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type         PosPayType
  amountSatang Int
  refSaleId    String? // DEPOSIT/ROOM_CHARGE อ้างบิลเดิม
  note         String?

  @@index([saleId])
}

// เลขใบเสร็จรันต่อ unit ต่อเดือน
model PosReceiptCounter {
  id       String @id @default(cuid())
  tenantId String
  unitId   String
  period   String // YYYYMM
  seq      Int    @default(0)

  @@unique([unitId, period])
}

// ═══════════════════ P1.1a — แคตตาล็อกเดียว (PosProduct) · ตารางใหม่ล้วน ═══════════════════
// ขอบเขต (มติ R1): tenantId + systemId (AppSystem type POS) · unitId null = ขายทุกสาขาของระบบนี้
//   · invItemId null = ไม่ผูกคลัง (เมนู/สินค้าเว็บล้วน) · ไม่ซ้ำต่อ (systemId, invItemId) เมื่อมีค่า
// ผู้เขียนเดียว = src/lib/modules/pos/catalog.ts (fitness F15.1) · P1.1a ยังไม่มี dual-write (P1.1b)
// 🔴 ฟิลด์เมนู (stationId · stockQty · dailyStockQty · isOutOfStock) และช่วงเวลาขายของหมวด = **สำเนาอย่างเดียว**
//    ต้นฉบับที่ระบบใช้จริงยังเป็น MenuItem/MenuCategory จนถึง P1.1b/P2.4 — ห้ามอ่านค่าพวกนี้ไปตัดสินการขาย

enum PosProductKind {
  PRODUCT
  SERVICE
  MENU
  BUNDLE
}

model PosCategory {
  id            String    @id @default(cuid())
  tenantId      String
  systemId      String // AppSystem.id (type POS)
  unitId        String? // null = ทุกสาขาของระบบ POS นี้ · มีค่า = หมวดของสาขานั้น (หมวดเมนูเป็นของสาขา)
  name          String
  nameEn        String?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true) // สำเนาจาก MenuCategory.isVisible
  availableFrom String? // สำเนาจาก MenuCategory (ช่วงเวลาขาย "06:00") — ต้นฉบับยังอยู่ที่ MenuCategory
  availableTo   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products PosProduct[]

  @@unique([systemId, unitId, name])
  /// 🔴 M5: หมวด "ทุกสาขา" (unitId null) ห้ามชื่อซ้ำในระบบเดียว — unique ข้างบนกันไม่ได้ (NULL ไม่เท่ากัน)
  ///    บังคับด้วย **partial unique index** ใน migration 20261120000000_pos_v2_a:
  ///      CREATE UNIQUE INDEX "PosCategory_systemId_name_all_branches_key" ON "PosCategory"("systemId","name") WHERE "unitId" IS NULL;
  ///    (แบบเดียวกับ AccountProduct_systemId_code_active_key) · `prisma migrate diff` มองไม่เห็น → ห้ามลบออกจาก migration
  @@index([tenantId])
}

model PosProduct {
  id                 String         @id @default(cuid())
  tenantId           String
  systemId           String // AppSystem.id (type POS) — ระบบที่ขายแถวนี้
  unitId             String? // null = ทุกสาขาของระบบ POS นี้
  invItemId          String? // InvItem.id (ต้นฉบับ "ของ" · สต็อก/ต้นทุน/บาร์โค้ด/SKU) · null = ไม่ผูกคลัง
  parentId           String? // R3: แม่ของตัวแปร (ขนาด/สี) — P1.2 เป็นเจ้าของ · P1.1a ว่างไว้
  parent             PosProduct?    @relation("PosProductVariants", fields: [parentId], references: [id], onDelete: SetNull)
  children           PosProduct[]   @relation("PosProductVariants")
  kind               PosProductKind @default(PRODUCT)
  name               String
  nameEn             String?
  categoryId         String?
  category           PosCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePriceSatang    Int? // สตางค์ · null = ยังไม่ตั้งราคา (ไม่ใช้ต้นทุนแทน) · 0 = ตั้งใจให้ฟรี
  vatRateBp          Int? // สำเนาจาก AccountProduct.vatRateBp · null = ไม่มีบัญชีผูก
  barcode            String? // บาร์โค้ดของแถวนี้เอง (แถวที่ผูกคลังใช้ InvItem.barcode — ไม่คัดลอก)
  images             Json           @default("[]") // ["url", …] index 0 = ปก
  sortOrder          Int            @default(0)
  trackStock         Boolean? // C2 tri-state: null = AUTO (คิดตอนอ่าน: ผูก InvItem + PRODUCT + มี movement หรือ onHand ≠ 0) · true/false = ร้านตั้งเอง
  unavailableUnitIds String[]       @default([]) // สาขาที่ปิดขายชั่วคราว (availability[unit] = false)
  // ── สำเนาจาก MenuItem (copy-only ถึง P1.1b/P2.4) ──
  stationId          String? // KdsStation.id
  stockQty           Int?
  dailyStockQty      Int?
  isOutOfStock       Boolean        @default(false)
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  optionGroups PosProductOptionGroup[]
  recipeLines  RecipeLine[]

  @@unique([systemId, invItemId])
  @@index([tenantId])
  @@index([systemId, archivedAt, name, id]) // M4: ลำดับของ listForUnit (keyset ชื่อ+id)
  @@index([systemId, barcode])
  @@index([parentId])
}

// ผูกสินค้า ↔ กลุ่มตัวเลือกเดิมของร้านอาหาร (MenuOptionGroup ใช้ต่อ ไม่สร้างใหม่ · ต่อสาขาเหมือนเดิม)
model PosProductOptionGroup {
  id        String     @id @default(cuid())
  tenantId  String
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String // MenuOptionGroup.id (คนละไฟล์ schema — id หลวมแบบเดียวกับ MenuItem.invItemId)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([productId, groupId])
  @@index([tenantId])
  @@index([groupId])
}

// สูตร/BOM: ขาย 1 หน่วยของ productId ใช้ InvItem เท่าไร (P2.3 เป็นเจ้าของ) · P1.1a: เมนูที่มี MenuItem.invItemId → 1 แถว qty 1
model RecipeLine {
  id        String     @id @default(cuid())
  tenantId  String
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  invItemId String // InvItem.id (หน่วยเดียวกับ InvMovement — จำนวนเต็ม)
  qty       Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([productId, invItemId])
  @@index([tenantId])
  @@index([invItemId])
}

// ═══════════════════ P1.5 — พักบิล / เรียกคืน (PosHeldCart) · ตารางใหม่ล้วน (มติ H1) ═══════════════════
// ขอบเขต: ต่อสาขา (tenantId + systemId POS + unitId) · ทุกผู้ใช้หน้าขายของสาขาเห็น · id หลวม (ไม่มี FK) แบบ PosProduct
// ผู้เขียนเดียว = src/lib/modules/pos/held-cart.ts · cartJson = { cart: RegisterQuoteInput ที่ผ่านการตรวจแล้ว, heldUnitPrices }
//   🔴 ราคาใน cartJson ไม่ถูกเชื่อ — เรียกคืนแล้วคิดราคาใหม่ผ่าน quoteRegisterCart เสมอ (H3) · heldUnitPrices ใช้แค่บอก "ราคาเปลี่ยน"
// เรียกคืน = UPDATE … WHERE id AND status='HELD' (ผู้ชนะคนเดียว · H2) · หมดอายุแบบขี้เกียจตอน list (H4 · ไม่มี cron)

enum PosHeldCartStatus {
  HELD
  RECALLED
  DISCARDED
}

model PosHeldCart {
  id                String            @id @default(cuid())
  tenantId          String
  unitId            String // BusinessUnit.id — สาขาที่พัก (เห็น/เรียกคืนได้เฉพาะสาขานี้)
  systemId          String // AppSystem.id (type POS)
  label             String? // ≤ 60 ตัวอักษร (ตรวจใน held-cart.ts) · null = ไม่ตั้งป้าย
  cartJson          Json
  lineCount         Int
  approxTotalSatang Int // ยอด quote ของเซิร์ฟเวอร์ ณ ตอนพัก (ไว้แสดงในลิ้นชักเท่านั้น)
  heldByUserId      String
  recalledAt        DateTime?
  recalledByUserId  String?
  status            PosHeldCartStatus @default(HELD)
  createdAt         DateTime          @default(now())
  version           Int               @default(1)

  @@index([unitId, status, createdAt])
}
