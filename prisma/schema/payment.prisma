// การเงินแพลตฟอร์ม+ร้าน (WO-0023)
// PaymentProfile = ช่องรับเงินของร้าน (PromptPay v1 — gateway Beam ต่อเมื่อมี creds ชื่อ shark)
// PlatformInvoice = บิลที่แพลตฟอร์มเรียกเก็บจากร้าน (เช่น custom domain 1,500฿/ปี) — backoffice จัดการ ร้านเห็นของตัวเอง

model PaymentProfile {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  promptpayId String? // เบอร์มือถือ 10 หลัก (0x…) หรือเลขบัตรประชาชน 13 หลัก
  displayName String? // ชื่อที่โชว์ใต้ QR (เช่น ชื่อร้าน/เจ้าของบัญชี)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  VOID
}

model PlatformInvoice {
  id           String                @id @default(cuid())
  tenantId     String
  title        String // "ค่าบริการ custom domain ปี 2026"
  amountSatang Int
  status       PlatformInvoiceStatus @default(PENDING)
  dueAt        DateTime?
  paidAt       DateTime?
  note         String?
  createdAt    DateTime              @default(now())

  @@index([tenantId, status, createdAt])
  @@index([status, createdAt])
}

// SVC R0.1 ▸ สลิปโอนกลาง (CC §3.2 · เจ้าของโค้ด R0.6) — refId/partyId/fileId/verifierIntegrationId = ข้อความ ไม่มี FK
// 🔴 unique บางส่วน (SQL มือใน migration svc_r0 — Prisma เขียนเองไม่ได้ · Prisma 7.8 ไม่สร้าง DROP ให้ของพวกนี้ (ตรวจ 27 ต.ค.) — ใบถัดไปให้รัน migrate diff ตรวจซ้ำ):
//    "PaymentSlip_tenantId_imageHash_active_key" ON (tenantId, imageHash) WHERE status <> 'REJECTED'
//    "PaymentSlip_tenantId_transRef_active_key"  ON (tenantId, transRef) WHERE transRef IS NOT NULL AND status <> 'REJECTED'
model PaymentSlip {
  id                    String    @id @default(cuid())
  tenantId              String
  unitId                String
  domain                String // "BOOKING" | "DORM" | "HOTEL"
  refType               String // "APPT_DEPOSIT" | "DORM_BILL" | "HOTEL_DEPOSIT"
  refId                 String
  partyId               String?
  fileId                String
  imageHash             String
  transRef              String?
  expectedSatang        Int
  amountSatang          Int?
  payerName             String?
  bankCode              String?
  transferredAt         DateTime?
  checks                Json // ผลตรวจในระบบรายข้อ
  verifierIntegrationId String?
  verifierResult        Json?
  status                String // "PENDING" | "AUTO_APPROVED" | "NEEDS_REVIEW" | "APPROVED" | "REJECTED"
  reviewReason          String?
  decidedById           String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([tenantId, unitId, status, createdAt])
  @@index([refType, refId])
  // SVC D.0 ▸ SQL มือ (svc_d · ดัชนีนิพจน์ Prisma ประกาศไม่ได้):
  //    UNIQUE "PaymentSlip_tenantId_idempotencyKey_key" ON ("tenantId", ("checks"->>'idempotencyKey'))
  //    — slip-verify findByKey ค้นด้วย $queryRaw รูปเดียวกับนิพจน์นี้ (ห้ามกลับไปใช้ JSON path)
}
// ◂ SVC R0.1
