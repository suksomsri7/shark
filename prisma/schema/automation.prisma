// Automation v1 (WO-0026) — Trigger(outbox event) → Condition → Action ตามวิสัยทัศน์ Blank_6
// v1: เงื่อนไขยอดขั้นต่ำ · action = แจ้งเตือนในแอป (AppNotification) หรือยิง webhook
enum AutomationActionType {
  NOTIFY
  WEBHOOK
}

enum AutomationRunStatus {
  OK
  FAILED
}

model AutomationRule {
  id              String               @id @default(cuid())
  tenantId        String
  name            String
  event           String // "pos.sale.paid" | "pos.sale.voided" | ... · "" = กฎที่ไม่ผูก event (SCHEDULED/DUE_DATE/ปุ่ม)
  enabled         Boolean              @default(true)
  minAmountSatang Int? // เงื่อนไข v1: ยอด ≥ (เฉพาะ event ที่มี amountSatang ใน payload)
  actionType      AutomationActionType
  actionConfig    Json                 @default("{}") // NOTIFY: {title?} · WEBHOOK: {url}
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // ── K2.9 (บอร์ดงาน · พิมพ์เขียว 13-kanban-v2 §4.5) — เพิ่มคอลัมน์ล้วน ──
  // 🔴 `minAmountSatang` / `actionType` / `actionConfig` ข้างบน **ห้ามลบ**: กฎเดิมของ POS/คลัง
  //    ยังอ่านช่องเหล่านั้นอยู่ · กฎของบอร์ดตั้ง actionType = NOTIFY, actionConfig = {} เป็น placeholder
  //    แล้วเอนจินใหม่อ่าน `actions` แทน (เอนจินเดิมถูกจำกัดให้เห็นเฉพาะแถวที่ boardId = null)
  systemId      String? // ระบบไหน (null = กฎเดิมระดับร้าน — พฤติกรรมเดิมไม่เปลี่ยน)
  boardId       String? // null = กฎระดับร้าน · มีค่า = กฎของบอร์ดนั้น
  kind          String    @default("RULE") // RULE | CARD_BUTTON | BOARD_BUTTON | SCHEDULED | DUE_DATE
  conditions    Json      @default("[]") // [{field, op, value}] — AND ทั้งชุด
  actions       Json      @default("[]") // [{type, params}] — สูงสุด KANBAN_LIMITS.actionsPerRule (20)
  scheduleCron  String? // เฉพาะ kind = SCHEDULED — subset "นาที ชั่วโมง * * วัน" (เวลาไทย)
  dueOffsetDays Int? // เฉพาะ kind = DUE_DATE — ลบ = ก่อนครบกำหนด (-30..30)
  lastRunAt     DateTime? // กันรันซ้ำในชั่วโมงไทยเดียวกัน (SCHEDULED)

  @@index([tenantId, event, enabled])
  // เส้นอ่านของเอนจินบอร์ดงาน: กฎที่เปิดอยู่ของบอร์ดใบเดียว (runForKanbanEvent/sweep/หน้าตั้งกฎ)
  @@index([tenantId, boardId, enabled])
}

model AutomationRun {
  id        String              @id @default(cuid())
  tenantId  String
  ruleId    String
  status    AutomationRunStatus
  detail    String?
  createdAt DateTime            @default(now())

  // ── K2.9 — บันทึกการทำงานของกฎบอร์ดงาน (null ทั้งคู่ = กฎระดับร้านแบบเดิม) ──
  boardId String?
  cardId  String? // การ์ดที่ถูกกระทำ (SCHEDULED/ปุ่มบนบอร์ด = null)

  @@index([tenantId, createdAt])
  // หน้า "บันทึกการทำงาน" + ตัวกันวน 60 วิ + โควตารายเดือน อ่านตามกฎแล้วเรียงเวลา
  @@index([tenantId, ruleId, createdAt])
}

// ศูนย์แจ้งเตือนในแอป (v1 — ปลายทางของ action NOTIFY)
model AppNotification {
  id       String @id @default(cuid())
  tenantId String
  // ── ผู้รับ (ปิดหนี้ G11 · PDPA 31 ส.ค. 2026) ──
  // 🔴 ทำไมต้องมีช่องนี้: ของเดิมเป็น **ประกาศทั้งร้าน** ⇒ ใครที่เข้าแอปของร้านได้
  //    เปิด /app/notifications แล้วอ่าน "ตัวอย่างข้อความลูกค้า" ได้หมด แม้ไม่มีสิทธิ์แชทสักข้อ
  //    (ช่องโหว่ตัวเดียวกับ G9 ฝั่ง push ที่ปิดไปแล้วด้วย selectChatNotifyRecipients)
  //    ⇒ แจ้งเตือนที่มีเนื้อความอ่อนไหวต้องเขียน **รายผู้รับที่ผ่านด่านสิทธิ์จริง**
  // 🔴 ทำไม nullable ไม่ใช่ NOT NULL: `null` = ประกาศทั้งร้านแบบเดิม ซึ่งยังต้องใช้ได้
  //    (automation/inventory/forms/shop ฯลฯ สร้างแจ้งเตือนระดับร้านอยู่ 10 กว่าจุด)
  //    ⇒ migration เป็น additive ล้วน แถวเก่าทุกแถวคงพฤติกรรมเดิมเป๊ะ ไม่ต้อง backfill
  recipientUserId String? // User.id — null = ทั้งร้านเห็น · มีค่า = คนนี้คนเดียวเห็น
  title           String
  body            String
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, readAt, createdAt])
  // ขาอ่านกรอง "ของทั้งร้าน + ของฉัน" แล้วเรียงใหม่สุดก่อน — index นี้คือเส้นที่ query นั้นเดิน
  @@index([tenantId, recipientUserId, readAt, createdAt])
}
