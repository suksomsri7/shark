    const c3 = { rendered: !po.html.startsWith("THROW"), total: po.html.includes(money((await runRow(runPaid)).totalNetSatang)), names: Object.values(E).filter((e) => !/Left$/.test(e.key)).every((e) => po.html.includes(e.name)), noNote: !po.html.includes("ไม่รวมพนักงานที่คุณไม่มีสิทธิ์ดูค่าจ้าง") };
    chk("C3", all(c3), "owner full page", fails(c3));
    const c4: string[] = [];
