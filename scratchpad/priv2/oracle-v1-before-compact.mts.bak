    payU1m: await mk("payu1m", "MANAGER", [U1], { ...PAY, "hr.leave.read": true, "hr.leave.decide": true, "hr.payadjust.approve": true }),
    hrAdmin: await mk("hradmin", "STAFF", ["*"], { "hr.employee.create": true }), mgrU1: await mk("mgru1", "MANAGER", [U1], {}), emp: await mk("emp", "STAFF", [], {}),
  };
  const defs: [string, string | null, "MONTHLY" | "HOURLY", Record<string, Any>][] = [
