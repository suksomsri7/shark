    for (const p of prof0) await P.hrSalaryProfile.update({ where: { id: p.id }, data: { baseSalarySatang: p.baseSalarySatang * 2, ...(p.hourlyRateSatang ? { hourlyRateSatang: p.hourlyRateSatang * 2 } : {}) } });
    const s2 = await snap();
    for (const p of prof0) await P.hrSalaryProfile.update({ where: { id: p.id }, data: { baseSalarySatang: p.baseSalarySatang, hourlyRateSatang: p.hourlyRateSatang } });
