      for (const [tool, args] of [["hr_who_is_on_today", { day: DM1 }], ["hr_late_report", { period: MONTH }], ["hr_labor_percent", { day: D0 }], ["hr_labor_percent", { periodKey: PERIOD }], ["hr_leave_balance", { year: Number(D0.slice(0, 4)) }]] as [string, Any][])
        cov.push(["D5", `${vn}.ai.${tool}.${Object.keys(args)[0]}`, () => call(M.tools, "runTool", { tenantId: X.TA, actor }, tool, args)]);
    }
    cov.push(["D3", "payU1m.page", async () => { const p = await renderPage(W.payU1m); return p.html + "\u0002" + p.props; }]);
    const key = async (l: string, scopes: string[]) => { mute(); try { return (await M.AK.createApiKey({ tenantId: X.TA }, `QCP2 ${l} ${tag}`, { scopes, systemId: X.HRS, createdById: W.owner.id })).rawKey as string; } catch (e) { return `∅${errText(e)}`; } finally { unmute(); } };
    const READ = ["hr.employee.read", "hr.roster.read", "hr.leave.read"];
    const KR: string[] = [], KP: string[] = []; // the REST limiter counts per key ⇒ a fresh key pair per snapshot round
    for (let i = 0; i < 3; i++) { KR.push(await key(`read${i}`, READ)); KP.push(await key(`pay${i}`, [...READ, "hr.payroll.read"])); }
    let ROUND = 0;
    const api = async (raw: string, path: string) => {
      if (typeof M.RT?.GET !== "function") return { __missing: "route" };
      mute();
      try { const res: Response = await M.RT.GET(new Request(`http://x/api/v1/hr${path}`, { headers: { authorization: `Bearer ${raw}` } }), { params: Promise.resolve({ path: path.split("?")[0]!.split("/").filter(Boolean) }) }); return `${res.status} ${await res.text()}`; } catch (e) { return `THROW ${errText(e)}`; } finally { unmute(); }
    };
    for (const p of ["/units", "/employees?pageSize=50", "/shifts", `/roster?from=${DM1}&to=${D0}`, `/attendance/day?day=${DM1}`, "/leave-policies", "/leaves?status=PENDING", `/leave-balances?year=${D0.slice(0, 4)}`,
      ...[E.a1!, E.bNow!, E.c1!].flatMap((e) => [`/employees/${e.id}`, `/employees/${e.id}/payslips?taxYear=${PY}`, `/payslips/${runPaid}/${e.id}`]), ...IDS.map((r) => `/reports/${r}?period=${periodOf(r)}`)])
      cov.push(["D5", `api.read${p.slice(0, 40)}`, () => api(KR[ROUND]!, p)]);
    for (const vn of ["hrAdmin", "mgrU1", "emp"]) {
      const v = vOf((W as Any)[vn]);
      for (const e of Object.values(E)) cov.push(["D5", `${vn}.profile.${e.key}`, () => call(M.priv, "loadEmployeeProfileForViewer", ctx, v, e.id)]);
      cov.push(["D5", `${vn}.time`, () => call(M.rep, "loadReport", ctx, v, { report: "time", period: MONTH })]);
    }
    const pos: Cov[] = [
