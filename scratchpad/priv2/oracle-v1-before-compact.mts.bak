      if (!okR(ib)) { c5.push(`${vn}:${short(ib, 30)}`); continue; }
      const out = adjItems(ib).filter((x) => !IN_KEYS.includes(keyOfId.get(x.employeeId) ?? ""));
      if (out.length || textOfAny(ib).includes(String(AMT.bonusB))) c5.push(`${vn}:${out.map((x) => keyOfId.get(x.employeeId)).join("/") || "amount"}`);
      if (vn === "payU1m" && !textOfAny(ib).includes(String(AMT.bonusA))) c5.push("a1 missing");
    }
    if (adjItems(await call(M.inbox, "listInbox", ctx, vOf(W.mgrU1), {})).length) c5.push("mgrU1 premise");
    chk("C5", !c5.length, "no out-of-scope adjustment", c5.join(" | ") || "ok");
  }

  // ── N: R6 OT list + stock charges ──
  {
    const otl = (v: Any) => call(M.ot, "otRequestList", ctx, v, {});
    const itemOf = (r: Any, id: string) => ((r?.items ?? []) as Any[]).find((x) => x.id === id);
    const otRows = (await P.hrOtRequest.findMany({ where: { tenantId: X.TA, employeeId: { in: [E.bNow!.id, E.bSpan!.id] }, status: "APPROVED", date: { gte: dbDate(addDay(D0, -5)) } }, select: { id: true } })) as Any[];
    const lm = await otl(LIM.payU1m), mg = await otl(vOf(W.mgrU1));
