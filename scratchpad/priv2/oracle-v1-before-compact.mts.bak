    chk("N3", !ch.length, "3 payloads identical", ch.length ? `changed: ${ch.join(",")}` : "identical");
  }

  // ── E1: R3 reads ──
  {
    const e1: string[] = [];
    const has = (r: Any, w: string) => (textOfAny(r).includes(E.bNow!.id) || textOfAny(r).includes(E.bNow!.name) ? "" : w);
