    ["bNow", U2, "HOURLY", {}], ["bSpan", U2, "MONTHLY", {}], ["bEnded", U2, "MONTHLY", {}], ["bLeft", U2, "MONTHLY", { status: "ENDED", active: false, endDate: DM1 }],
    ["c1", U2, "MONTHLY", {}], ["c2", U3, "HOURLY", {}], ["cNo", null, "MONTHLY", {}],
  ];
  const E: Record<string, Emp> = {};
  let k = 0;
