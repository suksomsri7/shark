    const ownOt = itemOf(await otl(vOf(W.owner)), X.otBNow);
    const ownFlags = spanItem ? await call(M.stock, "stockPeriodCapFlags", ctx, vOf(W.owner), [spanItem]) : null;
    const n4 = { ownerOt: ownOt?.amountSatang === AMT.otB, ownerStock: spanItem?.amountSatang === AMT.stockSpan && spanItem?.overCap === true, ownerFlag: ownFlags instanceof Set && ownFlags.has(X.stockSpan), limOtA1: !!otA1, limStockA1: ((lim?.items ?? []) as Any[]).some((i) => i.employeeId === E.a1!.id && i.amountSatang === AMT.stockA1) };
    chk("N4", all(n4), "owner money · in-scope money", fails(n4));
