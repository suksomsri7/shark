    const spanItem = ((own?.items ?? []) as Any[]).find((i) => i.id === X.stockSpan);
    const flags = spanItem ? await call(M.stock, "stockPeriodCapFlags", ctx, LIM.payU1m, [spanItem]) : null;
    const n2 = { listed: !((lim?.items ?? []) as Any[]).some((i) => i.employeeId === E.bSpan!.id), flags: !!spanItem && !(flags instanceof Set && flags.has(X.stockSpan)) };
    chk("N2", all(n2) && okR(lim), "no bSpan row · no bSpan flag", `${fails(n2)} list=${okR(lim)}`);
