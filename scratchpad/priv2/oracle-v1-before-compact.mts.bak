    const det = await call(M.leave, "leaveDetail", ctx, v, X.leaveB), lv = await call(M.leave, "decideLeaveAs", ctx, v, X.leaveB, "REJECTED"), ot = await call(M.ot, "decideOtRequest", ctx, v, X.otB, "REJECTED", { now: new Date() });
    const st = { leave: (await P.hrLeave.findUnique({ where: { id: X.leaveB } }))?.status, ot: (await P.hrOtRequest.findUnique({ where: { id: X.otB } }))?.status };
