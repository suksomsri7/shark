      for (const it of (await P.hrPayrollItem.findMany({ where: { employeeId: e.id } })) as Any[]) {
        const sj = it.snapshotJson && typeof it.snapshotJson === "object" && typeof it.snapshotJson.baseSalarySatang === "number" ? { ...it.snapshotJson, baseSalarySatang: it.snapshotJson.baseSalarySatang * 2 } : it.snapshotJson;
        await P.hrPayrollItem.update({ where: { id: it.id }, data: Object.fromEntries([...["grossSatang", "netSatang", "ssoBaseSatang", "ssoEmployeeSatang", "ssoEmployerSatang", "whtSatang", "addSatang", "deductSatang"].map((f) => [f, it[f] * 2]), ["snapshotJson", sj]]) });
      }
