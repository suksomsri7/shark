  // ── G1: R4 ──
  {
    const act = async (fn: () => Promise<unknown>) => { try { return textOfAny(await inScope(W.payU1m.cookie, pagePath, async () => { mute(); try { return await fn(); } finally { unmute(); } })); } catch (e) { return e instanceof Error ? e.message : String(e); } };
    const A = M.acts, S0 = { systemId: X.HRS };
    const state = async () => canon({ runs: await P.hrPayrollRun.count({ where: { systemId: X.HRS } }), p: (await runRow(runPaid)).status, d: (await runRow(runDraft)).status });
    const before = await state();
    const n = String(await P.hrPayrollItem.count({ where: { runId: runDraft } })), net = String((await runRow(runDraft)).totalNetSatang);
    const nextP = addDay(`${MONTH}-28`, 10).slice(0, 7);
    const out: Record<string, string> = {
      approve: await act(() => A.approvePayrollRunAction(fd({ ...S0, runId: runDraft, expectNet: net, expectItems: n }))), markPaid: await act(() => A.markPaidAction(fd({ ...S0, runId: runDraft }))),
      reverse: await act(() => A.reverseRunAction(fd({ ...S0, runId: runPaid, reason: "ข้อสอบ" }))), del: await act(() => A.deleteDraftRunAction(fd({ ...S0, runId: runDraft }))),
      recompute: await act(() => A.recomputeDraftRunAction(fd({ ...S0, runId: runDraft }))), create: await act(() => A.createPayrollRunAction(null, fd({ ...S0, periodKey: nextP, payDate: `${nextP}-28` }))),
      createV2: await act(() => A.createPayrollRunV2Action(fd({ ...S0, periodKey: nextP, payDate: `${nextP}-28` }))), approveV2: await act(() => A.approveRunV2Action(fd({ ...S0, runId: runDraft, net, items: n }))),
      payV2: await act(() => A.payRunV2Action(fd({ ...S0, runId: runDraft }))), reverseV2: await act(() => A.reverseRunV2Action(fd({ ...S0, runId: runPaid }))), recomputeV2: await act(() => A.recomputeRunV2Action(fd({ ...S0, runId: runDraft }))),
    };
    const nf = Object.entries(out).filter(([, t]) => !t.includes(T_RUN_ALL)).map(([k, t]) => `${k}="${short(t, 40)}"`);
    const after = await state();
    chk("G1", !nf.length && before === after, "11 × fixed · unchanged", `${nf.join(" ") || "all fixed"} ${before === after ? "unchanged" : `CHANGED ${after}`}`);
