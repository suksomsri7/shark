        ["laborDay", () => call(M.labor, "laborDay", ctx, v, { day: D0, unitId: U1 }, { now: FIXED_NOW })], ["laborDayAll", () => call(M.labor, "laborDay", ctx, v, { day: DM1 }, { now: FIXED_NOW })],
        ["laborMonth", () => call(M.labor, "laborMonth", ctx, v, { periodKey: PERIOD, unitId: U1 }, { now: FIXED_NOW })], ["ap", () => call(M.ap, "attendanceDeductionPreview", ctx, v, { periodKey: MONTH })],
