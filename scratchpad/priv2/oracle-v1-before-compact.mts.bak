        has(await call(M.judge, "loadAttendanceBoard", ctx, v, { day: DM1, unit: U1 }), "attendance"), has(await call(M.rep, "loadReport", ctx, v, { report: "time", period: DM1.slice(0, 7) }), "time"),
        (await call(M.priv, "loadEmployeeProfileForViewer", ctx, v, E.bNow!.id))?.profile ? "" : "profile"].filter(Boolean);
