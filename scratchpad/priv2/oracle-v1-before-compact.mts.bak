    const snap = async () => { const m = new Map<string, string>(); for (const [, n, f] of allC) { const v = await f(); m.set(n, digest(v)); if (process.env.QC_PRIV2_DUMP) TXT.set(n, [...(TXT.get(n) ?? []), stableText(v).slice(0, 4000)]); } return m; };
    const dump = (names: string[]) => { if (process.env.QC_PRIV2_DUMP) writeFileSync(join(ROOT, "scratchpad/priv2/dump.json"), JSON.stringify(Object.fromEntries(names.map((n) => [n, TXT.get(n)])), null, 1)); };
    const s1 = await snap();
