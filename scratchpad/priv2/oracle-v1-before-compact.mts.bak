  // ── R2: doubling test ──
  {
    type Cov = [string, string, () => Promise<unknown>];
    const cov: Cov[] = [];
    for (const [vn, v] of Object.entries(LIM)) {
      for (const rep of IDS) { cov.push(["D1", `${vn}.${rep}.page`, () => call(M.rep, "loadReport", ctx, v, { report: rep, period: periodOf(rep) })]); for (const format of ["CSV", "XLSX"]) cov.push(["D1", `${vn}.${rep}.${format}`, () => call(M.rep, "exportReport", ctx, v, { report: rep, period: periodOf(rep), format })]); }
      for (const e of Object.values(E)) {
        cov.push(["D2", `${vn}.profile.${e.key}`, () => call(M.priv, "loadEmployeeProfileForViewer", ctx, v, e.id)], ["D2", `${vn}.lps.${e.key}`, () => call(M.priv, "loadPayslipForViewer", ctx, v, runPaid, e.id)],
          ["D2", `${vn}.slip.${e.key}`, () => call(M.slip, "slipForViewer", ctx, v, { runId: runPaid, employeeId: e.id })], ["D2", `${vn}.hist.${e.key}`, () => call(M.slip, "slipHistory", ctx, v, { employeeId: e.id, taxYear: PY })]);
      }
