    await P.hrEmployee.update({ where: { id }, data: { nationalId: nid, ssoNumber: `${z}SSO`, houseRegAddress: `${z}HOUSE`, bankName: "KBank", bankAccountNo: `${7700000000 + k * 1013}`, bankAccountName: `${z}BANKNAME`, phone: `${z}PHONE`, birthDate: new Date(`198${k % 10}-0${(k % 9) + 1}-1${k % 9}T00:00:00Z`) } });
    await P.hrEmployeeDoc.create({ data: { ...sc, employeeId: id, kind: "ID_CARD", title: "บัตร", url: `https://files.invalid/${z}DOC` } });
    const base = 3_000_000 + k * 13_337 + 17, rate = 17_000 + k * 113 + 7;
    await P.hrSalaryProfile.create({ data: { ...sc, employeeId: id, payType: pay, baseSalarySatang: pay === "MONTHLY" ? base : 0, hourlyRateSatang: pay === "HOURLY" ? rate : null, ssoEligible: true } });
    const gross = 4_000_000 + k * 21_211 + 919;
    E[key] = { key, id, home, k, name, nid, z, base, rate, gross, net: gross - 75_000 - (10_000 + k * 7), pay };
  }
  const borrow = (e: string, from: string, to: string | null) => P.hrEmployeeUnit.create({ data: { ...sc, employeeId: E[e]!.id, unitId: U1, fromDate: dbDate(from), toDate: to ? dbDate(to) : null } });
  await borrow("bNow", addDay(D0, -3), null);
  await borrow("bSpan", addDay(`${PERIOD}-01`, -40), null);
  await borrow("bEnded", `${PERIOD}-05`, `${PERIOD}-20`);
  await borrow("bLeft", `${PERIOD}-01`, null);
  const SH1 = (await P.hrShift.create({ data: { ...sc, unitId: U1, name: `เช้า1 ${tag}`, startMin: 480, endMin: 1020, breakMin: 60 } })).id;
  for (const day of [D0, DM1]) for (const e of ["a1", "bNow"]) await P.hrRosterEntry.create({ data: { ...sc, employeeId: E[e]!.id, date: dbDate(day), shiftId: SH1, unitId: U1, startMin: 480, endMin: 1020, breakMin: 60, crossesMidnight: false, published: true, publishedAt: new Date() } });
  for (const e of ["a1", "bNow"]) for (const [kind, min] of [["IN", 485], ["OUT", 1022]] as const) await P.hrAttendance.create({ data: { ...sc, employeeId: E[e]!.id, kind, at: bkk(DM1, min), source: "MOBILE" } });
  for (const e of ["a1", "bNow"]) await P.hrAttendanceDay.create({ data: { ...sc, employeeId: E[e]!.id, date: dbDate(DM1), slotKey: `qc-${e}`, unitId: U1, startMin: 480, endMin: 1020, status: "ON_TIME", workedMin: 480, judgedAt: new Date() } });
  const pol = (await P.hrLeavePolicy.create({ data: { ...sc, category: "PERSONAL", name: `กิจ ${tag}`, quotaDays: 30, allowHalfDay: false, allowHours: false } })).id;
  const leaveB = (await P.hrLeave.create({ data: { ...sc, employeeId: E.bNow!.id, policyId: pol, type: "PERSONAL", fromDate: dbDate(addDay(D0, 20)), toDate: dbDate(addDay(D0, 20)), status: "PENDING", reason: "ธุระ", days: 1 } })).id as string;
  const ot = (e: string, day: string, status: string, amt: number | null) => P.hrOtRequest.create({ data: { ...sc, employeeId: E[e]!.id, date: dbDate(day), startAt: bkk(day, 1022), endAt: bkk(day, 1082), minutes: 60, timing: "AFTER", reason: "ปิดร้าน", status, ...(amt ? { amountSatang: amt, settledAt: bkk(day, 1200) } : {}) } }).then((r: Any) => r.id as string);
  const otB = await ot("bNow", DM1, "PENDING", null);
  await ot("a1", `${PERIOD}-12`, "APPROVED", AMT.otA1old);
  await ot("bSpan", `${PERIOD}-12`, "APPROVED", AMT.otSpan);
  const otBNow = await ot("bNow", addDay(D0, -2), "APPROVED", AMT.otB); // R6 N1: borrowed day, settled with money
  await ot("a1", addDay(D0, -2), "APPROVED", AMT.otA1);
  await ot("bSpan", addDay(D0, -2), "APPROVED", AMT.otSpan2);
  const mkRun = async (periodKey: string, status: string, keys: string[]) => {
    const run = await P.hrPayrollRun.create({ data: { ...sc, periodKey, payDate: new Date(`${periodKey}-28T12:00:00+07:00`), status, engineVersion: 1, totalGrossSatang: 0, totalSsoEmployeeSatang: 0, totalSsoEmployerSatang: 0, totalWhtSatang: 0, totalNetSatang: 0, totalAddSatang: 0 } });
    for (const key of keys) { const e = E[key]!; await P.hrPayrollItem.create({ data: { ...sc, runId: run.id, employeeId: e.id, ...v1Item(e.gross, [], { add: 0, deduct: 0, gross: e.gross, ssoBase: 1_500_000, ee: 75_000, wht: 10_000 + e.k * 7 }) } }); }
    await retotal(run.id);
    return run.id as string;
  };
  const runPaid = await mkRun(PERIOD, "PAID", Object.keys(E));
  const runDraft = await mkRun(MONTH, "DRAFT", Object.keys(E).filter((x) => x !== "aLeft" && x !== "bLeft"));
  const adj = (e: string, kind: string, amt: number) => P.hrPayAdjustment.create({ data: { ...sc, employeeId: E[e]!.id, periodKey: MONTH, kind, amountSatang: amt, status: "PENDING", note: "QC" } }).then((r: Any) => r.id as string);
  await adj("a1", "BONUS", AMT.bonusA);
  await adj("bNow", "BONUS", AMT.bonusB);
  // R6 N2: stock charges (bSpan borrowed MONTHLY: overCap + cap flag reveal its salary · a1 control)
  await adj("bSpan", "DEDUCTION", AMT.dedSpan);
  const stock = async (e: string, amt: number) => P.hrStockCharge.create({ data: { ...sc, employeeId: E[e]!.id, kind: "DAMAGE", requestKey: `qc-${e}-${tag}`, adjustmentId: await adj(e, "DEDUCTION", amt), description: "แก้วแตก", amountSatang: amt, consentRef: `C-${e}`, consentAt: dbDate(DM1), consentRecordedById: W.owner.id, requestedById: W.owner.id } }).then((r: Any) => r.id as string);
  const stockSpan = await stock("bSpan", AMT.stockSpan);
  await stock("a1", AMT.stockA1);
  return { TA, U1, HRS, ctx: sc, W, E, runPaid, runDraft, leaveB, otB, otBNow, stockSpan };
}

// ═════════════ main ═════════════
let crashed = "";
const vOf = (w: Any) => ({ role: w.role, unitAccess: w.unitAccess, permissions: w.permissions, userId: w.id });
try {
  {
    const S = M.scope;
    let r: Record<string, boolean> = { has: typeof S?.inPayScope === "function" && typeof S?.payScopeWhere === "function" };
    if (r.has) {
      const sc = (role: string, ua: string[]) => S.hrScopeOf({ role, unitAccess: ua });
      const u1 = sc("MANAGER", ["U1"]);
      const w1 = canon(S.payScopeWhere(u1));
      r = { ...r, all: [sc("OWNER", []), sc("STAFF", ["*"]), sc("STAFF", [])].every((s: Any) => ["U1", "U2", null].every((h) => S.inPayScope(s, h) === true)),
        u1: S.inPayScope(u1, "U1") && [S.inPayScope(u1, "U2"), S.inPayScope(u1, "U3"), S.inPayScope(u1, null), S.inPayScope(u1, undefined)].every((x) => x === false),
        where: !/"units"/.test(w1) && /U1/.test(w1) && canon(S.payScopeWhere(sc("OWNER", []))) === "{}" && /"in":\[\]/.test(canon(S.payScopeWhere({ unitIds: [] }))) };
    }
    chk("P1", all(r), "truth table · shapes", fails(r));
  }
  const X = await buildFixture();
  const { ctx, W, E, U1, runPaid, runDraft } = X;
  const keyOfId = new Map(Object.values(E).map((e) => [e.id, e.key]));
  const LIM = { payU1s: vOf(W.payU1s), payU1m: vOf(W.payU1m) };
  const money = (sat: number) => (typeof M.money?.formatBaht === "function" ? String(M.money.formatBaht(sat)) : `∅${sat}`);
  const bahtForms = (sat: number) => [String(sat), (sat / 100).toFixed(2), (sat / 100).toLocaleString("en-US", { minimumFractionDigits: 2 })];
  const sensOf = (e: Emp) => [e.nid, `${e.z}SSO`, `${e.z}HOUSE`, `${e.z}BANKNAME`, `${e.z}DOC`];
  const payOf = (e: Emp) => [...bahtForms(e.gross), ...bahtForms(e.net), ...bahtForms(e.pay === "HOURLY" ? e.rate : e.base)].filter((s) => s.length >= 5);
  const num = (v: unknown) => Number(String(v ?? "").replace(/[^\d.-]/g, "")) || 0;
  console.log(`fixture ok: PERIOD=${PERIOD} MONTH=${MONTH}`);

  // ── A: profile + slips ──
  {
    const prof = (v: Any, e: string) => call(M.priv, "loadEmployeeProfileForViewer", ctx, v, E[e]?.id ?? e);
    const lps = (v: Any, e: string) => call(M.priv, "loadPayslipForViewer", ctx, v, runPaid, E[e]?.id ?? e);
    const SENS = ["nationalId", "ssoNumber", "houseRegAddress", "bankName", "bankAccountNo", "bankAccountName", "payType"];
    const a1: string[] = [], a2: string[] = [], c: string[] = [];
    for (const [vn, v] of Object.entries(LIM)) for (const e of BORROWED) {
      const r = await prof(v, e);
      const keys = SENS.filter((k) => r?.profile && k in r.profile), sent = sensOf(E[e]!).filter((s) => textOfAny(r).includes(s));
      if (!r?.profile || keys.length || sent.length || r.docs?.length || r.canSeeSensitive !== false) a1.push(`${vn}.${e}:${keys.join("/")}|${sent.length}|${r?.docs?.length}`);
      if (vn === "payU1m" && canon(r) !== canon(await prof(vOf(W.mgrU1), e))) a2.push(e);
    }
    chk("A1", !a1.length, "no sensitive data", a1.slice(0, 6).join(" ") || "clean");
    chk("A2", !a2.length, "= mgrU1 DTO", a2.join(",") || "same");
    for (const e of IN_KEYS) { const t = textOfAny(await prof(LIM.payU1s, e)); if (!sensOf(E[e]!).every((s) => t.includes(s))) c.push(`payU1s.${e}`); }
    for (const w of ["owner", "payAll"]) { const t = textOfAny(await prof(vOf((W as Any)[w]), "bNow")); if (!sensOf(E.bNow!).every((s) => t.includes(s))) c.push(`${w}.bNow`); }
    chk("A3", !c.length, "visible where allowed", c.join(" ") || "ok");
    const s = { bNow: await lps(LIM.payU1s, "bNow"), bSpan: await lps(LIM.payU1s, "bSpan"), a1: await lps(LIM.payU1s, "a1") };
    const rt = await P.hrPayrollRun.findUnique({ where: { id: runPaid } });
    const t1 = textOfAny(s.a1);
    const whole = Object.entries({ gross: rt.totalGrossSatang, net: rt.totalNetSatang, sso: rt.totalSsoEmployeeSatang, wht: rt.totalWhtSatang }).filter(([, v]) => t1.includes(String(v))).map(([k]) => k);
    chk("A4", s.bNow === null && s.bSpan === null && !!s.a1?.item && !whole.length, "null · null · slip w/o totals", `bNow=${s.bNow === null ? "null" : "SLIP"} bSpan=${s.bSpan === null ? "null" : "SLIP"} a1=${s.a1?.item ? "slip" : short(s.a1, 30)} whole=${whole.join("/") || "none"}`);
    const unk = "c" + Math.random().toString(36).slice(2, 12) + "zz9q";
    const par = [await prof(LIM.payU1s, "c2"), await prof(LIM.payU1s, "cNo"), await prof(LIM.payU1s, unk), await lps(LIM.payU1s, "c2"), await lps(LIM.payU1s, unk)];
    chk("A5", par.every((x) => x === null), "5 × null", par.map((x) => (x === null ? "null" : short(x, 20))).join(","));
    // A7 (R8): own slip
    const own = await lps(vOf(W.emp), "a1");
    const db = (await P.hrPayrollItem.findFirst({ where: { runId: runPaid, employeeId: E.a1!.id } })) as Any;
    const FIG = ["grossSatang", "netSatang", "ssoBaseSatang", "ssoEmployeeSatang", "ssoEmployerSatang", "whtSatang", "addSatang", "deductSatang"];
    const diff = FIG.filter((k) => k in (own?.item ?? {}) && own.item[k] !== db?.[k]);
    const totals = Object.keys(own?.run ?? {}).filter((k) => /^total/i.test(k));
    const r7 = { slip: !!own?.item, gross: own?.item?.grossSatang === db?.grossSatang, net: own?.item?.netSatang === db?.netSatang, figures: !diff.length, noTotals: !totals.length };
    chk("A7", all(r7), "own figures = DB · no total*", `${fails(r7)} diff=${diff.join("/")} totals=${totals.join("/")}`);
  }

  // ── B: reports ──
  const IDS: string[] = (M.RR.REPORT_IDS as string[]) ?? [];
  const periodOf = (r: string) => { const k = M.RR.REPORT_CATALOG?.[r]?.period; return k === "year" ? String(PY) : k === "day" ? D0 : PERIOD; };
  const MONEY6 = ["payroll-month", "payroll-year", "tax-month", "tax-year", "wages", "register"];
  const rowsOf = (r: Any) => (Array.isArray(r?.rows) ? r.rows.map((x: Any) => keyOfId.get(x.employeeId) ?? "?") : null);
  {
    const b1: string[] = [], b2: string[] = [], b5: string[] = [];
    for (const [vn, v] of Object.entries(LIM)) for (const rep of MONEY6) {
      const page = await call(M.rep, "loadReport", ctx, v, { report: rep, period: periodOf(rep) });
      const rows = rowsOf(page);
      const out = (rows ?? ["∅"]).filter((k: string) => !IN_KEYS.includes(k));
      if (out.length) b1.push(`${vn}.${rep}:${out.join("/")}`);
      if (vn === "payU1s" && page?.totals) for (const [col, tot] of Object.entries(page.totals as Record<string, string>))
        if (tot && /\d/.test(String(tot)) && Math.abs((page.rows as Any[]).reduce((x, rw) => x + num(rw.values?.[col]), 0) - num(tot)) > 0.001) b5.push(`${rep}.${col}`);
      for (const format of ["CSV", "XLSX"]) {
        const x = await call(M.rep, "exportReport", ctx, v, { report: rep, period: periodOf(rep), format });
        const t = x?.ok ? textOfAny(x.bytes) : "";
        const hits = BORROWED.filter((e) => [E[e]!.name, E[e]!.nid, ...payOf(E[e]!)].some((s) => t.includes(s)));
        if (!x?.ok || hits.length) b2.push(`${vn}.${rep}.${format}:${x?.ok ? hits.join("/") : "refused"}`);
      }
    }
    chk("B1", !b1.length, "rows ⊆ {a1,a2,aLeft}", b1.slice(0, 6).join(" | ") || "clean");
    chk("B2", !b2.length, "clean exports", b2.slice(0, 6).join(" | ") || "clean");
    const b3: string[] = [];
    {
      const MK: string[] = ((M.RR.REPORT_CATALOG?.ot?.columns ?? []) as Any[]).filter((c) => c.cls === "$").map((c) => c.key);
      const page = await call(M.rep, "loadReport", ctx, LIM.payU1m, { report: "ot", period: PERIOD });
      const mgr = await call(M.rep, "loadReport", ctx, vOf(W.mgrU1), { report: "ot", period: PERIOD });
      const rowOf = (r: Any) => ((r?.rows ?? []) as Any[]).find((x) => x.employeeId === E.bSpan!.id);
      const bp = rowOf(page), bm = rowOf(mgr);
      if (!page?.ok || !bp || !bm) b3.push(`rows page=${!!bp} mgr=${!!bm}`);
      else {
        const leak = MK.filter((k) => bp.values?.[k] !== undefined && bp.values?.[k] !== null && bp.values?.[k] !== "");
        if (leak.length) b3.push(`money ${leak.join("/")}`);
        const d = Object.keys(bm.values ?? {}).filter((k) => !MK.includes(k) && String(bp.values?.[k] ?? "") !== String(bm.values[k] ?? ""));
        if (d.length) b3.push(`op≠mgr ${d.join("/")}`);
        const inRows = ((page.rows ?? []) as Any[]).filter((x) => IN_KEYS.includes(keyOfId.get(x.employeeId) ?? ""));
        const badT = MK.filter((k) => page.totals?.[k] !== undefined && Math.abs(num(page.totals[k]) - inRows.reduce((a: number, x: Any) => a + num(x.values?.[k]), 0)) > 0.001);
        if (badT.length) b3.push(`totals ${badT.join("/")}`);
        if (page.excludedHeadcount !== 1) b3.push(`excluded=${page.excludedHeadcount}`);
        if (!((page.notes ?? []) as string[]).includes(PAY_SCOPE_EXCLUDED_TEXT.replace("{n}", "1"))) b3.push("note");
      }
      for (const format of ["CSV", "XLSX"]) {
        const x = await call(M.rep, "exportReport", ctx, LIM.payU1m, { report: "ot", period: PERIOD, format });
        const t = x?.ok ? textOfAny(x.bytes) : "";
        if (!x?.ok || !t.includes(E.bSpan!.name) || bahtForms(AMT.otSpan).some((f) => t.includes(f))) b3.push(`${format}:${x?.ok ? "row/amount" : "refused"}`);
      }
    }
    chk("B3", !b3.length, "row kept · money withheld · note", b3.join(" | ") || "ok");
    const b4: string[] = [];
    for (const w of ["owner", "payAll"]) for (const rep of ["payroll-month", "tax-month", "register"]) { const rows = rowsOf(await call(M.rep, "loadReport", ctx, vOf((W as Any)[w]), { report: rep, period: periodOf(rep) })) ?? []; const miss = BORROWED.filter((e) => !rows.includes(e)); if (miss.length) b4.push(`${w}.${rep}:${miss.join("/")}`); }
    { const rows = rowsOf(await call(M.rep, "loadReport", ctx, LIM.payU1s, { report: "payroll-month", period: PERIOD })) ?? []; if (!rows.includes("aLeft") || rows.includes("bEnded")) b4.push("payU1s aLeft/bEnded"); }
    chk("B4", !b4.length, "controls", b4.join(" | ") || "ok");
    const docs = async (v: Any) => ({ open: await call(M.open, "listOpeningYtd", ctx, v, { taxYear: PY }), certs: await call(M.slip, "listSalaryCertEmployees", ctx, v), fil: await call(M.fil, "listFilingEmployees", ctx, v), bank: await call(M.bank, "previewBankFile", ctx, v, { runId: runPaid, bank: "KBANK", format: "CSV" }) });
    for (const [vn, v] of Object.entries(LIM)) { const o = Object.entries(await docs(v)).filter(([, r]) => okR(r)).map(([k]) => k); if (o.length) b5.push(`${vn} opens ${o.join("/")}`); }
    { const d = await docs(vOf(W.payAll)); if (!(textOfAny(d.certs) + textOfAny(d.fil)).includes(E.bNow!.name)) b5.push("payAll lacks bNow"); }
    chk("B5", !b5.length, "Σ rows · previews all-branch", b5.join(" | ") || "ok");
  }

  // ── C: payroll page · run preview · inbox ──
  const pagePath = `/app/sys/${X.HRS}/hr/payroll`;
  const renderPage = async (w: Any): Promise<{ html: string; props: string }> => {
    try { return await inScope(w.cookie, pagePath, async () => { mute(); try { const n = await M.ui.PayrollSection({ systemId: X.HRS }); return { html: await renderHtml(n), props: propsText(n) }; } finally { unmute(); } }); } catch (e) { return { html: `THROW ${errText(e)}`, props: "" }; }
  };
  const runRow = async (id: string) => (await P.hrPayrollRun.findUnique({ where: { id } })) as Any;
  {
    const pg = await renderPage(W.payU1m);
    const both = pg.html + "\u0001" + pg.props;
    const c1: string[] = pg.html.startsWith("THROW") || pg.html.length < 200 ? [`render ${pg.html.slice(0, 80)}`] : [];
    for (const e of OUT_KEYS) { const x = E[e]!; const v = x.pay === "HOURLY" ? x.rate : x.base; if ([x.name, money(x.gross), money(x.net), money(v), String(x.gross), String(v)].some((s) => both.includes(s))) c1.push(e); }
    if (both.includes(money(AMT.bonusB)) || both.includes(String(AMT.bonusB))) c1.push("bNow bonus");
    chk("C1", !c1.length, "no out-of-scope data", c1.join(" | ") || "clean");
    const c2: string[] = [];
    for (const [rid, label] of [[runPaid, "PAID"], [runDraft, "DRAFT"]] as [string, string][]) {
      const t = await runRow(rid);
      const its = (await P.hrPayrollItem.findMany({ where: { runId: rid } })) as Any[];
      const shown = its.filter((i) => IN_KEYS.includes(keyOfId.get(i.employeeId) ?? ""));
      for (const [k, v] of Object.entries({ gross: t.totalGrossSatang, net: t.totalNetSatang, sso: t.totalSsoEmployeeSatang, wht: t.totalWhtSatang })) if (both.includes(money(Number(v))) || both.includes(String(v))) c2.push(`${label}.${k}`);
      if (new RegExp(`(^|[^\\d])${its.length} คน`).test(pg.html)) c2.push(`${label}.count`);
      if (!pg.html.includes(PAY_SCOPE_EXCLUDED_TEXT.replace("{n}", String(its.length - shown.length)))) c2.push(`${label}.note`);
      if (label === "PAID" && !pg.html.includes(money(shown.reduce((x, i) => x + i.netSatang, 0)))) c2.push("PAID.Σnet");
    }
