      await P.hrOtRequest.updateMany({ where: { employeeId: e.id, amountSatang: { not: null } }, data: { amountSatang: { multiply: 2 } } });
      await P.hrStockCharge.updateMany({ where: { employeeId: e.id }, data: { amountSatang: { multiply: 2 } } });
    }
    await retotal(runPaid);
    await retotal(runDraft);
    ROUND = 2;
    const s3 = await snap();
    for (const g of ["D1", "D2", "D3", "D4", "D5"]) { const list = cov.filter(([gg]) => gg === g); const c = list.filter(([, n]) => s1.get(n) !== s3.get(n)).map(([, n]) => n); chk(g, !c.length, `${list.length} identical`, c.length ? `${c.length}/${list.length}: ${c.slice(0, 8).join(",")}` : `${list.length} identical`); }
    if (!unstable.length) dump(cov.filter(([, n]) => s1.get(n) !== s3.get(n)).map(([, n]) => n));
    const same = pos.filter(([, n]) => s1.get(n) === s3.get(n)).map(([, n]) => n);
    chk("D6", !same.length, "4 changed", same.join(",") || "all changed");
  }

  // ── E2: R3 actions ──
  {
