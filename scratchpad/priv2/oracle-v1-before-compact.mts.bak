      if (!pv?.ok) { c4.push(`${hidden}:${short(pv, 30)}`); continue; }
      const out = (pv.rows as Any[]).map((r) => keyOfId.get(r.employeeId) ?? "?").filter((k) => !IN_KEYS.includes(k));
      if (out.length) c4.push(`rows ${out.join("/")}`);
      if (pv.run?.totals?.netSatang !== (pv.rows as Any[]).reduce((x, r) => x + r.netSatang, 0)) c4.push("Σ");
      if (pv.run?.excludedHeadcount !== hidden) c4.push(`excluded=${pv.run?.excludedHeadcount}≠${hidden}`);
      const ow = await call(M.payroll, "previewPayrollRunV2", ctx, vOf(W.owner), { runId: rid });
      if (ow?.run?.excludedHeadcount !== 0 || ow?.run?.totals?.netSatang !== (await runRow(rid)).totalNetSatang) c4.push(`owner excluded=${ow?.run?.excludedHeadcount}`);
    }
    chk("C4", !c4.length, "scope · Σ · excludedHeadcount", c4.join(" | ") || "ok");
    const adjItems = (r: Any): Any[] => { const out: Any[] = [], seen = new WeakSet(); const walk = (x: Any) => { if (!x || typeof x !== "object" || seen.has(x)) return; seen.add(x); if (typeof x.employeeId === "string" && x.detail && typeof x.detail === "object" && "amountSatang" in x.detail) out.push(x); for (const v of Object.values(x)) walk(v); }; walk(r); return out; };
    const c5: string[] = [];
    for (const [vn, v] of Object.entries(LIM)) {
