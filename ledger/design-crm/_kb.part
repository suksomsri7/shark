<style>
/* ══ ส่วนขยายสำหรับโมดูลบอร์ดงาน (Kanban) — ต่อยอดจากจานสีเดิม ห้ามเพิ่มสีนอกโทเคน ══ */
body{font-family:'IBM Plex Sans Thai','Noto Sans Thai','Sarabun',system-ui,sans-serif}

/* สีป้ายกำกับ 6 สี = โทเคน --color-tag-* ใน globals.css (ไม่คิดใหม่) */
:root{--wall:#f3f4f7;--out:#e9eefc;--note:#fffaed;--note-line:#ecd9a4;--note-ink:#8a6414;--t-slate:#737373;--t-blue:#1d4ed8;--t-green:#15803d;--t-amber:#b45309;--t-red:#b91c1c;--t-purple:#6d28d9}

/* ── เวทีบอร์ด ─────────────────────────────────────────────────────────── */
.kbar{display:flex;align-items:center;gap:9px;padding:10px 20px;border-bottom:1px solid var(--line);flex:none;background:var(--sf)}
.kbar .sp{flex:1}
.kbar h1{font-size:17px;font-weight:700;letter-spacing:-.02em}
.star{color:var(--t-amber)}
.vsw{display:flex;gap:2px;border:1px solid var(--line);border-radius:8px;padding:2px;background:var(--sf)}
.vsw .v{display:flex;align-items:center;gap:5px;height:26px;padding:0 9px;border-radius:6px;font-size:12.5px;color:var(--mut)}
.vsw .v.on{background:var(--ink);color:var(--sf);font-weight:700}
.avs{display:flex}
.avs .av{width:26px;height:26px;border-radius:50%;margin-left:-6px;box-shadow:0 0 0 2px var(--sf);font-size:11px}
.avs .av:first-child{margin-left:0}
.av.acc{background:var(--acc-bg);border-color:var(--acc);color:var(--acc)}
.av.add{background:var(--sf);border-style:dashed;color:var(--mut2)}

.stage{background:var(--stage);flex:1;min-height:0;display:flex;flex-direction:column}
.fbar{display:flex;align-items:center;gap:7px;padding:9px 20px;font-size:12px;color:var(--mut);flex:none}
.fchip{display:inline-flex;align-items:center;gap:5px;height:26px;padding:0 9px;border-radius:7px;
  border:1px solid var(--acc);background:var(--acc-bg);color:var(--acc);font-size:12px;font-weight:600}
.fchip .x{opacity:.6}

.kb{display:flex;gap:12px;padding:4px 20px 18px;align-items:flex-start;overflow:hidden;flex:1;min-height:0}
.kl{width:240px;flex:none;background:#eceef1;border-radius:12px;padding:8px;display:flex;flex-direction:column;gap:7px;max-height:100%}
.kl.ghost{background:rgba(236,238,241,.55);border:1.5px dashed var(--line2)}
.klh{display:flex;align-items:center;gap:7px;padding:2px 4px 0}
.klh .nm{font-size:13px;font-weight:700}
.klh .n{font-size:11.5px;color:var(--mut);font-variant-numeric:tabular-nums}
.klh .sp{flex:1}
.klh .i{color:var(--mut)}
.wip{font-size:10.5px;border:1px solid var(--line2);border-radius:5px;padding:0 5px;color:var(--mut);background:var(--sf)}
.wip.full{border-color:var(--dg);color:var(--dg);font-weight:700}
.kcs{display:flex;flex-direction:column;gap:7px;min-height:0}
.kc{background:var(--sf);border:1px solid var(--line);border-radius:10px;padding:8px 9px 7px;
  display:flex;flex-direction:column;gap:6px;box-shadow:0 1px 1px rgba(10,10,10,.05)}
.kc.sel{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc-bg)}
.kc.drag{transform:rotate(2.4deg);box-shadow:0 10px 24px rgba(10,10,10,.18);border-color:var(--line2)}
.kc .ti{font-size:12.8px;line-height:1.4;font-weight:500}
.kc .cover{height:64px;border-radius:7px;background:var(--sf2);border:1px solid var(--line);
  display:grid;place-items:center;color:var(--mut2);margin:-2px 0 1px}
.lbs{display:flex;flex-wrap:wrap;gap:4px}
.lb{display:inline-flex;align-items:center;height:18px;padding:0 6px;border-radius:5px;font-size:10.5px;
  font-weight:600;border:1px solid currentColor;background:var(--sf)}
.lb.slate{color:var(--t-slate)} .lb.blue{color:var(--t-blue)} .lb.green{color:var(--t-green)}
.lb.amber{color:var(--t-amber)} .lb.red{color:var(--t-red)} .lb.purple{color:var(--t-purple)}
.kf{display:flex;align-items:center;gap:9px;font-size:11px;color:var(--mut)}
.kf .sp{flex:1}
.kf .b{display:inline-flex;align-items:center;gap:3px;font-variant-numeric:tabular-nums}
.due{white-space:nowrap;display:inline-flex;align-items:center;gap:4px;height:19px;padding:0 6px;border-radius:5px;
  font-size:10.5px;font-weight:600;border:1px solid var(--line2);color:var(--mut);background:var(--sf)}
.due.soon{border-color:var(--t-amber);color:var(--t-amber);background:#fdf6ec}
.due.late{border-color:var(--dg);color:var(--dg);background:#fdeeee}
.due.done{border-color:var(--t-green);color:var(--t-green);background:#eef7f0}
.kadd{display:flex;align-items:center;gap:7px;height:32px;padding:0 6px;border-radius:8px;
  font-size:12.5px;color:var(--mut)}
.src{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;color:var(--acc);
  background:var(--acc-bg);border-radius:5px;padding:1px 6px;align-self:flex-start}

/* ── หลังการ์ด (card back) ─────────────────────────────────────────────── */
.modal{position:absolute;left:50%;top:26px;transform:translateX(-50%);width:872px;background:var(--sf);
  border:1px solid var(--line);border-radius:14px;box-shadow:0 22px 60px rgba(10,10,10,.26);z-index:45;
  display:flex;flex-direction:column;overflow:hidden}
.mh{display:flex;align-items:flex-start;gap:10px;padding:15px 18px 12px;border-bottom:1px solid var(--line)}
.mb{display:flex;min-height:0}
.mmain{flex:1;min-width:0;padding:15px 18px 18px;display:flex;flex-direction:column;gap:15px}
.mside{width:228px;flex:none;border-left:1px solid var(--line);background:var(--sf2);padding:14px 13px;
  display:flex;flex-direction:column;gap:13px}
.sh{font-size:11px;font-weight:700;color:var(--mut);letter-spacing:.02em;margin-bottom:6px}
.sbtn{display:flex;align-items:center;gap:8px;height:32px;padding:0 10px;border:1px solid var(--line);
  border-radius:8px;background:var(--sf);font-size:12.5px;color:var(--ink2)}
.blk{display:flex;flex-direction:column;gap:7px}
.bh{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700}
.bh .i{color:var(--mut)}
.bh .sp{flex:1}
.prose{font-size:13px;line-height:1.6;color:var(--ink2)}
.prose ul{margin:4px 0 0 18px}
.pbar{height:7px;border-radius:4px;background:var(--sf2);overflow:hidden;border:1px solid var(--line)}
.pbar i{display:block;height:100%;background:var(--t-green)}
.cki{display:flex;align-items:flex-start;gap:9px;padding:5px 0;font-size:12.8px}
.cki.done{color:var(--mut2);text-decoration:line-through}
.cmt{display:flex;gap:9px;padding:9px 0;border-top:1px solid var(--line)}
.cmt .bd{flex:1;min-width:0}
.cmt .who{font-size:12.5px;font-weight:700}
.cmt .who span{font-weight:400;color:var(--mut);font-size:11.5px;margin-left:6px}
.cmt .tx{font-size:12.8px;color:var(--ink2);margin-top:3px;line-height:1.55}
.men{color:var(--acc);font-weight:600}
.att{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--line);font-size:12.5px}
.linkrow{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:9px;
  padding:8px 10px;font-size:12.5px;background:var(--sf)}
.linkrow .i{color:var(--acc)}
.linkrow .sp{flex:1}

/* ── ปฏิทิน (ใหญ่กว่าของบัญชี) ─────────────────────────────────────────── */
.cal2{width:100%;border-collapse:collapse;font-size:11.5px;background:var(--sf)}
.cal2 th{font-size:11.5px;color:var(--mut);font-weight:700;padding:7px 0;text-align:center;border:1px solid var(--line);background:var(--sf2)}
.cal2 td{border:1px solid var(--line);height:130px;vertical-align:top;padding:5px;width:14.28%}
.cal2 td.off{background:var(--sf2)}
.cal2 .dn{font-size:11px;color:var(--mut);font-weight:600;margin-bottom:4px}
.cal2 .dn.now{background:var(--acc);color:var(--sf);border-radius:50%;width:19px;height:19px;
  display:grid;place-items:center}
.evt{display:flex;align-items:center;gap:4px;font-size:10.5px;padding:2px 5px;border-radius:5px;
  background:var(--sf2);border:1px solid var(--line);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.evt i{width:6px;height:6px;border-radius:50%;flex:none;background:var(--mut2)}
.evt.red i{background:var(--t-red)} .evt.blue i{background:var(--t-blue)}
.evt.green i{background:var(--t-green)} .evt.amber i{background:var(--t-amber)}
.evt.purple i{background:var(--t-purple)}

/* ── ตัวสร้างกฎอัตโนมัติ ───────────────────────────────────────────────── */
.rule{border:1px solid var(--line);border-radius:11px;background:var(--sf);overflow:hidden}
.rrow{display:flex;align-items:center;gap:9px;padding:11px 13px;border-top:1px solid var(--line);font-size:13px}
.rrow:first-child{border-top:0}
.rtag{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 8px;border-radius:6px;
  font-size:11.5px;font-weight:700;flex:none}
.rtag.when{background:var(--ink);color:var(--sf)}
.rtag.then{background:var(--acc-bg);color:var(--acc);border:1px solid var(--acc)}
.rtag.and{background:var(--sf2);color:var(--mut);border:1px solid var(--line)}
.slot{display:inline-flex;align-items:center;gap:6px;height:29px;padding:0 9px;border-radius:7px;
  border:1px solid var(--line2);background:var(--sf2);font-size:12.5px;font-weight:600;color:var(--ink)}
.slot.acc{border-color:var(--acc);color:var(--acc);background:var(--acc-bg)}

/* ── การ์ดบอร์ดในหน้ารวม ───────────────────────────────────────────────── */
.bcard{border:1px solid var(--line);border-radius:12px;background:var(--sf);padding:0;overflow:hidden;
  display:flex;flex-direction:column}
.bcard .hd{height:52px;background:var(--sf2);border-bottom:1px solid var(--line);display:flex;
  align-items:flex-end;padding:8px 11px;gap:7px;position:relative}
.bcard .hd::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--mut2)}
.bcard .hd.blue::before{background:var(--t-blue)} .bcard .hd.green::before{background:var(--t-green)}
.bcard .hd.amber::before{background:var(--t-amber)} .bcard .hd.purple::before{background:var(--t-purple)}
.bcard .hd.red::before{background:var(--t-red)}
.bcard .bd{padding:10px 12px 11px;display:flex;flex-direction:column;gap:8px}
.bcard .nm{font-size:13.5px;font-weight:700}
.bcard .meta{font-size:11.5px;color:var(--mut)}
.newb{border:1.5px dashed var(--line2);border-radius:12px;background:var(--sf2);display:flex;
  flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--mut);font-size:12.5px;min-height:132px}
.g5{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}

/* ── รางไอคอน (ย่อ drawer เมื่ออยู่ในบอร์ด) ─────────────────────────────── */
.rail{width:56px;flex:none;border-right:1px solid var(--line);background:var(--sf2);
  padding:10px 0;display:flex;flex-direction:column;align-items:center;gap:5px;color:var(--mut2)}
.rail .ri{width:36px;height:36px;border-radius:9px;display:grid;place-items:center}
.rail .ri.on{background:var(--sf);border:1px solid var(--line);color:var(--ink)}

/* ── มือถือ ────────────────────────────────────────────────────────────── */
.frame.m .kb{padding:8px 12px 12px;gap:9px}
.frame.m .kl{width:270px;max-height:none}
.mkbar{display:flex;align-items:center;gap:8px;padding:9px 13px;border-bottom:1px solid var(--line);flex:none}
.mkbar .sp{flex:1}
.mkbar h1{font-size:15px;font-weight:700}
.pgd{display:flex;gap:5px;justify-content:center;padding:8px 0 2px}
.pgd i{width:5px;height:5px;border-radius:50%;background:var(--line2)}
.pgd i.on{background:var(--ink);width:16px;border-radius:3px}
.kbdlg{font-size:11px;color:var(--mut);text-align:center;padding:2px 0 6px}
</style>
<svg style="display:none" aria-hidden="true">
 <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3.6 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8Z"/></symbol>
 <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5.5h16v11H9.5L5.5 20v-3.5H4Z"/></symbol>
 <symbol id="i-clip" viewBox="0 0 24 24"><path d="M17.5 8.5 10 16a3 3 0 0 1-4.2-4.2l7.8-7.8a4.6 4.6 0 0 1 6.5 6.5l-7.7 7.7a6.2 6.2 0 0 1-8.8-8.8l6.6-6.6"/></symbol>
 <symbol id="i-cklist" viewBox="0 0 24 24"><path d="m3.5 7 2 2 3-3.5M3.5 15l2 2 3-3.5M11.5 7.5h9M11.5 16h9"/></symbol>
 <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13.5 3 5 13.5h6L10.5 21 19 10.5h-6Z"/></symbol>
 <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 15.5V10a6 6 0 1 0-12 0v5.5L4 18h16Z"/><path d="M10 21h4"/></symbol>
 <symbol id="i-line" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="4"/><path d="M9.5 17 8 20.5 12.5 17"/><path d="M7.5 8v5M7.5 8h2.5M7.5 10.5h2M7.5 13h2.5M13 13V8l3 5V8"/></symbol>
</svg>
