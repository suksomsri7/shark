<style>
/* ══ โทเคนสี — จานเดียวทั้งไฟล์ (WO §1) ═══════════════════════════════════
   ขาว #fff · พื้นรอง #fafafa · พื้นเวที #f4f5f7
   ตัวอักษร #0a0a0a / #404040 / #737373 / #a3a3a3
   เส้น #e5e5e5 · เส้นอ่อน/แท่งกราฟจาง #d4d4d4
   accent #1d4ed8 (+พื้นจาง #e9eefc) · danger #b91c1c
   ห้ามเพิ่มสีอื่น                                                        */
:root{
  --ink:#0a0a0a; --ink2:#404040; --mut:#737373; --mut2:#a3a3a3;
  --line:#e5e5e5; --line2:#d4d4d4; --sf:#fff; --sf2:#fafafa; --stage:#f4f5f7;
  --acc:#1d4ed8; --acc-bg:#e9eefc; --dg:#b91c1c;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased}
body{font-family:'Noto Sans Thai','Sarabun',system-ui,sans-serif;color:var(--ink);
  background:var(--stage);font-size:14px;line-height:1.45}
.wrap{padding:26px;display:flex;flex-direction:column;gap:30px;align-items:flex-start}
.cap{font-size:12.5px;font-weight:700;color:var(--ink2);margin:0 0 9px 3px}
.cap span{font-weight:400;color:var(--mut)}

/* ── กรอบจอ ───────────────────────────────────────────────────────────── */
.frame{width:1440px;background:var(--sf);border:1px solid var(--line);border-radius:14px;
  overflow:hidden;display:flex;flex-direction:column;position:relative}
.frame.m{width:390px}

/* ── ไอคอน ────────────────────────────────────────────────────────────── */
svg.i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;
  stroke-linecap:round;stroke-linejoin:round;flex:none}
svg.i.sm{width:14px;height:14px;stroke-width:1.9}
svg.i.xs{width:12px;height:12px;stroke-width:2}
svg.i.lg{width:22px;height:22px}

/* ── โครงแอปเดิม (topbar + drawer) — จงใจให้จาง ────────────────────────── */
.top{height:56px;display:flex;align-items:center;gap:11px;padding:0 18px;
  border-bottom:1px solid var(--line);color:var(--mut);flex:none}
.top .brand{font-size:14.5px;font-weight:700;color:var(--ink2)}
.top .sp{flex:1}
.appbody{display:flex;align-items:stretch;min-height:0}
.drawer{width:288px;flex:none;border-right:1px solid var(--line);background:var(--sf2);
  padding:14px 12px;color:var(--mut2);font-size:13px}
.dsec{font-size:11px;font-weight:700;color:var(--mut2);padding:10px 8px 5px;letter-spacing:.02em}
.ditem{display:flex;align-items:center;gap:9px;height:34px;padding:0 9px;border-radius:8px;color:var(--mut2)}
.ditem.on{background:var(--sf);color:var(--ink);font-weight:700;border:1px solid var(--line)}
.mod{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--sf)}

/* ── แถบเมนูบัญชี 9 หมวด ──────────────────────────────────────────────── */
.amenu{display:flex;gap:0;padding:0 18px;border-bottom:1px solid var(--line);position:relative;flex:none}
.am{position:relative;display:flex;align-items:center;gap:7px;padding:13px 13px 11px;font-size:13.5px;
  color:var(--ink2);border-bottom:2px solid transparent;white-space:nowrap}
.am.on{color:var(--ink);font-weight:700;border-bottom-color:var(--acc)}
.am.opened{background:var(--sf2);border-radius:8px 8px 0 0}
.am .cv{width:11px;height:11px;stroke-width:2.2;opacity:.55}

/* ── dropdown เมนูย่อย ────────────────────────────────────────────────── */
.dd{position:absolute;top:calc(100% - 1px);left:0;width:264px;background:var(--sf);
  border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(10,10,10,.12);
  padding:6px;z-index:30}
.dd.w2{width:520px;display:flex;gap:6px}
.dd.w2 .col{flex:1;min-width:0}
.ddh{font-size:11px;font-weight:700;color:var(--mut);padding:7px 10px 4px}
.ddi{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border-radius:8px;
  font-size:13.5px;color:var(--ink)}
.ddi .i{color:var(--mut)}
.ddi.on{background:var(--sf2);font-weight:700}
.ddi.soon{color:var(--mut2)}
.ddi.soon .i{color:var(--mut2)}
.ddi .ar{margin-left:auto;color:var(--mut2)}
.tagsoon{margin-left:auto;font-size:10.5px;color:var(--mut2);border:1px solid var(--line);
  border-radius:5px;padding:1px 6px}
.ddsep{height:1px;background:var(--line);margin:5px 9px}

/* ── หัวหน้า ──────────────────────────────────────────────────────────── */
.crumb{padding:13px 24px 0;font-size:12px;color:var(--mut);display:flex;align-items:center;gap:6px}
.ph{display:flex;align-items:center;gap:10px;padding:9px 24px 15px}
.ph h1{font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1.25}
.ph .sp{flex:1}
.pg{padding:0 24px 24px;display:flex;flex-direction:column;gap:15px}

/* ── ปุ่ม ─────────────────────────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;
  padding:0 14px;border-radius:8px;font-size:13.5px;font-weight:500;border:1px solid transparent;
  white-space:nowrap;background:var(--sf);color:var(--ink)}
.btn.pri{background:var(--ink);color:var(--sf)}
.btn.gh{border-color:var(--line)}
.btn.sm{height:31px;padding:0 10px;font-size:12.5px;border-radius:7px}
.btn.blk{width:100%}
.btn[disabled],.btn.off{color:var(--mut2);border-color:var(--line)}

/* ── การ์ด ────────────────────────────────────────────────────────────── */
.card{border:1px solid var(--line);border-radius:12px;background:var(--sf);padding:16px;min-width:0}
.card.p0{padding:0}
.ch{display:flex;align-items:center;gap:9px;margin-bottom:12px}
.ch h2{font-size:13.5px;font-weight:700}
.ch .sp{flex:1}
.sub{font-size:11.5px;color:var(--mut)}
.row{display:flex;gap:15px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}

/* ── KPI ──────────────────────────────────────────────────────────────── */
.kpi .lbl{font-size:12px;color:var(--mut);display:flex;align-items:center;gap:6px}
.kpi .val{font-size:23px;font-weight:700;letter-spacing:-.025em;margin-top:7px;
  font-variant-numeric:tabular-nums}
.kpi .val.dg{color:var(--dg)}
.kpi .fo{font-size:11.5px;color:var(--mut);margin-top:5px}

/* ── chip สถานะ (3 โทนตาม StatusChip) ─────────────────────────────────── */
.chip{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 8px;
  border-radius:6px;border:1px solid var(--line);font-size:11.5px;color:var(--mut);
  background:var(--sf);white-space:nowrap}
.chip.ink{border-color:var(--ink);color:var(--ink);font-weight:700}
.chip.dg{border-color:var(--dg);color:var(--dg);font-weight:700}
.chip.acc{border-color:var(--acc);color:var(--acc);font-weight:700;background:var(--acc-bg)}

/* ── แท็บ ─────────────────────────────────────────────────────────────── */
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);overflow:hidden}
.tab{display:flex;align-items:center;gap:6px;padding:9px 12px;font-size:13px;color:var(--mut);
  border-bottom:2px solid transparent;white-space:nowrap}
.tab.on{color:var(--ink);font-weight:700;border-bottom-color:var(--acc)}
.tab .n{font-size:12px;color:var(--mut2);font-variant-numeric:tabular-nums}
.tab.on .n{color:var(--ink2)}
.tab.dg,.tab.dg .n{color:var(--dg)}
.tab .bdg{min-width:18px;height:18px;border-radius:6px;background:var(--ink);color:var(--sf);
  font-size:10.5px;font-weight:700;display:grid;place-items:center;padding:0 5px}

/* ── ตาราง ────────────────────────────────────────────────────────────── */
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;font-size:11.5px;font-weight:700;color:var(--mut);padding:9px 10px;
  border-bottom:1px solid var(--line);white-space:nowrap;background:var(--sf2)}
.tbl td{padding:10px;border-bottom:1px solid var(--line);vertical-align:middle}
.tbl td.nw{white-space:nowrap}
.tbl tr:last-child td{border-bottom:0}
.tbl tr.hov td{background:var(--sf2)}
.tbl .num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.tbl .rt{text-align:right}
.lnk{color:var(--acc);font-weight:700}
.dgt{color:var(--dg);font-weight:700}
.mu{color:var(--mut)}
.cbx{width:14px;height:14px;border:1.5px solid var(--line2);border-radius:4px;display:inline-block;
  vertical-align:-2px}
.cbx.on{background:var(--ink);border-color:var(--ink);position:relative}
.cbx.on::after{content:"";position:absolute;left:3.5px;top:.5px;width:4px;height:8px;
  border:solid var(--sf);border-width:0 1.7px 1.7px 0;transform:rotate(42deg)}

/* ── ช่องกรอก / ตัวกรอง ───────────────────────────────────────────────── */
.inp{height:34px;border:1px solid var(--line);border-radius:8px;display:inline-flex;
  align-items:center;gap:7px;padding:0 10px;font-size:12.5px;color:var(--mut);background:var(--sf)}
.inp b{color:var(--ink);font-weight:600}
.inp .cv{margin-left:auto;color:var(--mut2)}
.inp.gro{flex:1}
.sw{width:34px;height:19px;border-radius:10px;background:var(--ink);position:relative;flex:none}
.sw::after{content:"";position:absolute;right:2.5px;top:2.5px;width:14px;height:14px;
  border-radius:50%;background:var(--sf)}
.sw.off{background:var(--line2)}
.sw.off::after{left:2.5px;right:auto}

/* ── แถบ bulk ─────────────────────────────────────────────────────────── */
.bulk{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--acc-bg);
  border:1px solid var(--acc);border-radius:9px;font-size:12.5px;color:var(--acc);font-weight:600}
.bulk .sp{flex:1}

/* ── เมนู "ทำรายการ" ในแถว ────────────────────────────────────────────── */
.rowmenu{position:absolute;right:0;top:calc(100% + 4px);width:210px;background:var(--sf);
  border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(10,10,10,.13);
  padding:5px;z-index:25;text-align:left}
.rowmenu .ddi{height:34px;font-size:13px}
.anch{position:relative;display:inline-block}

/* ── กราฟ ─────────────────────────────────────────────────────────────── */
.lgd{display:flex;align-items:center;gap:14px;font-size:11.5px;color:var(--ink2)}
.lgd i{width:9px;height:9px;border-radius:2px;display:inline-block;margin-right:6px;
  vertical-align:0px}
.lgd .ln{width:14px;height:2px;border-radius:2px;vertical-align:3px}
.sw-acc{background:var(--acc)} .sw-ink{background:var(--ink)}
.sw-m2{background:var(--mut2)} .sw-l2{background:var(--line2)} .sw-dg{background:var(--dg)}
.sw-mu{background:var(--mut)}
.stat{display:flex;gap:26px;flex-wrap:wrap}
.stat .b .k{font-size:11.5px;color:var(--mut)}
.stat .b .v{font-size:19px;font-weight:700;letter-spacing:-.02em;margin-top:3px;
  font-variant-numeric:tabular-nums}
.stat .b .v.dg{color:var(--dg)}
.stat .b .d{font-size:11px;color:var(--mut);margin-top:2px}

/* ── แถบสัดส่วน / อายุหนี้ ────────────────────────────────────────────── */
.mtr{height:8px;border-radius:4px;background:var(--sf2);overflow:hidden;display:flex;gap:2px}
.mtr i{display:block;height:100%}
.agerow{display:flex;align-items:center;gap:10px;font-size:12px}
.agerow .nm{width:98px;color:var(--mut);flex:none}
.agerow .bar{flex:1;height:9px;background:var(--sf2);border-radius:5px;overflow:hidden}
.agerow .bar i{display:block;height:100%;border-radius:3px;min-width:5px}
.agerow .amt{width:88px;text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
.agerow.dgv .amt{color:var(--dg)}

/* ── รายการงาน / ลิสต์ ────────────────────────────────────────────────── */
.lst .li{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--line);
  font-size:13px}
.lst .li:first-child{border-top:0}
.lst .li .sp{flex:1;min-width:0}
.lst .li .n{font-variant-numeric:tabular-nums;font-weight:700}
.pill{min-width:20px;height:20px;border-radius:6px;background:var(--ink);color:var(--sf);
  font-size:11px;font-weight:700;display:grid;place-items:center;padding:0 6px}
.pill.dg{background:var(--dg)}
.pill.gh{background:var(--sf2);color:var(--ink2);border:1px solid var(--line)}

/* ── footer ตาราง ─────────────────────────────────────────────────────── */
.tfoot{display:flex;align-items:center;gap:12px;padding:11px 12px;font-size:12.5px;color:var(--mut);
  border-top:1px solid var(--line)}
.tfoot .sp{flex:1}
.pgr{display:flex;align-items:center;gap:4px}
.pgr .pb{width:28px;height:28px;border:1px solid var(--line);border-radius:7px;display:grid;
  place-items:center;color:var(--ink2)}

/* ── โหมดถ่ายรูป "ไม่มีเมนู" — render.mjs เติม/ถอดคลาสนี้ที่ .frame ก่อน screenshot
   เพื่อให้ได้ 2 ใบต่อเฟรม: ใบเปล่าไว้ดูเนื้อหา + ใบมีเมนูไว้ดูโครงเมนู
   🔴 ห้ามก๊อป markup เฟรมซ้ำ — เฟรมเดียวถ่าย 2 สถานะ */
.frame.no-menu .dd,
.frame.no-menu .rowmenu,
.frame.no-menu .bulk,
.frame.no-menu .scrim,
.frame.no-menu .over,
.frame.no-menu .menu-space{display:none}
.frame.no-menu .am.opened{background:transparent}
.frame.no-menu .cbx.on{background:var(--sf);border-color:var(--line2)}
.frame.no-menu .cbx.on::after{display:none}

/* ── slide-over ───────────────────────────────────────────────────────── */
.scrim{position:absolute;inset:0;background:rgba(10,10,10,.28);z-index:40}
.over{position:absolute;top:0;right:0;bottom:0;width:400px;background:var(--sf);z-index:41;
  border-left:1px solid var(--line);box-shadow:-10px 0 34px rgba(10,10,10,.13);
  display:flex;flex-direction:column}

/* ── มือถือ ───────────────────────────────────────────────────────────── */
.frame.m .top{height:52px;padding:0 14px}
.mnav{display:flex;gap:2px;padding:0 12px;border-bottom:1px solid var(--line);overflow:hidden;flex:none}
.mn{display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 9px 7px;
  font-size:11px;color:var(--mut);border-bottom:2px solid transparent;white-space:nowrap}
.mn.on{color:var(--ink);font-weight:700;border-bottom-color:var(--acc)}
.mpg{padding:13px 14px 22px;display:flex;flex-direction:column;gap:13px}
.mcard{border:1px solid var(--line);border-radius:12px;padding:13px}
.mrow{display:flex;align-items:center;gap:9px;padding:11px 0;border-top:1px solid var(--line)}
.mrow:first-child{border-top:0}
.sheet{position:absolute;left:0;right:0;bottom:0;background:var(--sf);border-radius:16px 16px 0 0;
  box-shadow:0 -8px 30px rgba(10,10,10,.2);z-index:41;padding:8px 0 14px}
.grab{width:38px;height:4px;border-radius:2px;background:var(--line2);margin:2px auto 10px}
.sh-i{display:flex;align-items:center;gap:12px;height:48px;padding:0 16px;font-size:14px}
.sh-i .ar{margin-left:auto;color:var(--mut2)}
.fab{position:absolute;right:14px;width:52px;height:52px;border-radius:50%;background:var(--ink);
  color:var(--sf);display:grid;place-items:center;box-shadow:0 6px 18px rgba(10,10,10,.24);z-index:20}
.orb{position:absolute;right:14px;bottom:14px;width:52px;height:52px;border-radius:50%;
  border:2px solid var(--acc);background:var(--sf);color:var(--acc);display:grid;place-items:center;z-index:20}
.mtabs{display:flex;gap:6px;overflow:hidden;padding:1px}
.mtab{display:flex;align-items:center;gap:5px;height:30px;padding:0 11px;border-radius:8px;
  border:1px solid var(--line);font-size:12.5px;color:var(--mut);white-space:nowrap;background:var(--sf)}
.mtab.on{background:var(--ink);color:var(--sf);border-color:var(--ink);font-weight:700}
.mtab.dg{border-color:var(--dg);color:var(--dg)}

/* ── เบ็ดเตล็ด ────────────────────────────────────────────────────────── */
.hr{height:1px;background:var(--line)}
.av{width:24px;height:24px;border-radius:7px;background:var(--sf2);border:1px solid var(--line);
  display:grid;place-items:center;font-size:11px;font-weight:700;color:var(--ink2);flex:none}
.thumb{width:44px;height:44px;border-radius:8px;border:1px solid var(--line);background:var(--sf2);
  display:grid;place-items:center;color:var(--mut);flex:none;overflow:hidden}
.aitag{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:var(--acc);
  background:var(--acc-bg);border-radius:6px;padding:2px 7px;margin-top:3px}
.dashed{border:1.5px dashed var(--line2);border-radius:11px;padding:14px;display:flex;
  align-items:center;gap:11px;color:var(--mut);font-size:12.5px;background:var(--sf2)}
.tree{font-size:13px}
.tr-i{display:flex;align-items:center;gap:7px;height:31px;padding:0 8px;border-radius:7px;color:var(--ink2)}
.tr-i.on{background:var(--sf2);color:var(--ink);font-weight:700}
.tr-i .tg{width:13px;height:13px;border:1px solid var(--line2);border-radius:3px;display:grid;
  place-items:center;font-size:11px;line-height:1;color:var(--mut);flex:none;background:var(--sf)}
.kv{display:flex;gap:12px;padding:7px 0;font-size:13px;border-top:1px solid var(--line)}
.kv:first-child{border-top:0}
.kv .k{width:180px;color:var(--mut);flex:none}
.kv .v{flex:1;min-width:0}
.acc-i{display:flex;align-items:center;gap:8px;height:38px;padding:0 11px;font-size:13px;color:var(--ink2)}
.acc-i.on{background:var(--sf2);font-weight:700;color:var(--ink);border-left:2px solid var(--acc)}
.acc-h{display:flex;align-items:center;gap:8px;height:42px;padding:0 11px;font-size:13.5px;
  font-weight:700;border-top:1px solid var(--line)}
.cal{width:100%;border-collapse:collapse;font-size:11px}
.cal th{font-size:11px;color:var(--mut);font-weight:600;padding:5px 0;text-align:center;
  border-bottom:1px solid var(--line);background:var(--sf)}
.cal td{border:1px solid var(--line);height:60px;vertical-align:top;padding:4px 5px;width:14.28%}
.cal .d{font-size:11px;color:var(--mut)}
.cal .d.now{background:var(--acc);color:var(--sf);border-radius:50%;width:18px;height:18px;
  display:grid;place-items:center;font-weight:700}
.cal .in{font-size:10.5px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.cal .out{font-size:10.5px;color:var(--mut);font-variant-numeric:tabular-nums}
.cal td.off{background:var(--sf2)}
.tl{display:flex;align-items:center;gap:0;font-size:11.5px}
.tl .n{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1;text-align:center}
.tl .dot{width:22px;height:22px;border-radius:50%;border:1.5px solid var(--line2);display:grid;
  place-items:center;color:var(--mut2);background:var(--sf)}
.tl .n.done .dot{border-color:var(--ink);color:var(--ink)}
.tl .n.cur .dot{background:var(--acc);border-color:var(--acc);color:var(--sf)}
.tl .n.cur{font-weight:700;color:var(--acc)}
.tl .bar{height:1.5px;background:var(--line);flex:0 0 26px;margin-bottom:16px}
</style></head>
<body>
<svg style="display:none" aria-hidden="true">
 <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
 <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></symbol>
 <symbol id="i-cv" viewBox="0 0 24 24"><path d="m6 9.5 6 6 6-6"/></symbol>
 <symbol id="i-ar" viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7"/></symbol>
 <symbol id="i-back" viewBox="0 0 24 24"><path d="m15 5-7 7 7 7"/></symbol>
 <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
