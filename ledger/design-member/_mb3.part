<style>
/* ══ CSS เฉพาะภาพ 10–14 (agent คู่ขนาน · ต่อจาก _mb2.part) — ห้ามเพิ่มสีนอกจาน ══ */

/* ── พื้นหลังเบลอหลังโมดัล ────────────────────────────────────────────── */
.mb3-blurbg{filter:blur(2.5px);opacity:.92}

/* ── 10 สมัครสมาชิกใหม่: โมดัลฟอร์ม ───────────────────────────────────── */
.mb3-modalfoot{display:flex;align-items:center;gap:12px;padding:12px 18px;border-top:1px solid var(--line);
  background:var(--sf2)}
.mb3-consent{display:flex;align-items:center;gap:7px;font-size:12.3px;color:var(--ink2)}
.mb3-g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* ── 11 ตัวซ้ำ/รวมคน: แผงเปรียบเทียบ ──────────────────────────────────── */
.mb3-duprow{display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:12.5px}
.mb3-duprow:first-child{border-top:0}
.mb3-duprow .nm{flex:1;min-width:0}
.mb3-duprow .nm b{font-weight:700;font-size:13px}
.mb3-duprow .nm .mu2{font-size:11.5px;color:var(--mut);margin-top:2px}
.mb3-cmphead{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.mb3-cmpname{font-size:13.5px;font-weight:700}
.mb3-cmpmeta{font-size:11px;color:var(--mut);margin-top:4px;line-height:1.55}
.mb3-cmprow{display:grid;grid-template-columns:82px 1fr 1fr;gap:8px;align-items:center;padding:7px 0;
  border-top:1px solid var(--line);font-size:12px}
.mb3-cmprow:first-child{border-top:0}
.mb3-cmprow .k{color:var(--mut)}
.mb3-cmpval{display:flex;align-items:center;gap:6px;min-width:0}
.mb3-cmpval b{font-weight:600;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mb3-radio{width:15px;height:15px;border-radius:50%;border:1.5px solid var(--line2);display:inline-block;
  flex:none;position:relative}
.mb3-radio.on{border-color:var(--ink)}
.mb3-radio.on::after{content:"";position:absolute;left:3px;top:3px;width:7px;height:7px;border-radius:50%;
  background:var(--ink)}
.mb3-sumbox{border:1px solid var(--acc);background:var(--acc-bg);border-radius:10px;padding:11px 13px;
  font-size:12.3px;color:var(--ink2);display:flex;flex-direction:column;gap:5px}
.mb3-sumbox b{color:var(--ink)}

/* ── 12 นำเข้า CSV: จับคู่คอลัมน์ ─────────────────────────────────────── */
.mb3-steps{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mut)}
.mb3-steps b{color:var(--ink)}
.mb3-maprow{display:flex;align-items:center;gap:9px;padding:8px 0;border-top:1px solid var(--line)}
.mb3-maprow:first-child{border-top:0}
.mb3-maprow .col{width:96px;flex:none;font-size:11.8px;font-weight:600;color:var(--ink2);
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.mb3-maprow .ar{color:var(--mut2);flex:none}
.mb3-maprow .fld{flex:1;min-width:0}
.mb3-samptbl{width:100%;border-collapse:collapse;font-size:10.8px}
.mb3-samptbl th{text-align:left;font-weight:700;color:var(--mut);padding:5px 7px;border-bottom:1px solid var(--line);
  white-space:nowrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.mb3-samptbl td{padding:5px 7px;border-bottom:1px solid var(--line);color:var(--ink2);white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;max-width:90px}

/* ── 13 ช่องทางที่มา: กราฟแท่งแนวนอน ──────────────────────────────────── */
.mb3-chrow{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--line)}
.mb3-chrow:first-child{border-top:0}
.mb3-chrow .nm{width:118px;flex:none;font-size:12.3px;font-weight:600}
.mb3-chrow .bar{flex:1;height:16px;background:var(--sf2);border-radius:4px;overflow:hidden}
.mb3-chrow .bar i{display:block;height:100%;background:var(--ink);border-radius:4px 0 0 4px}
.mb3-chrow .m{width:64px;flex:none;text-align:right;font-size:10.8px;color:var(--mut);
  font-variant-numeric:tabular-nums}
.mb3-chrow .cnt{width:46px;flex:none;text-align:right;font-size:12.5px;font-weight:700;
  font-variant-numeric:tabular-nums}

/* ── 14 PDPA: เมทริกซ์สิทธิ์เห็นข้อมูลอ่อนไหว ─────────────────────────── */
.mb3-mtbl{width:100%;border-collapse:collapse;font-size:12px}
.mb3-mtbl th{text-align:center;font-weight:700;color:var(--mut);padding:7px 6px;border-bottom:1px solid var(--line);
  font-size:11px}
.mb3-mtbl th:first-child{text-align:left}
.mb3-mtbl td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:center}
.mb3-mtbl td:first-child{text-align:left;font-weight:600;color:var(--ink2)}
</style>
