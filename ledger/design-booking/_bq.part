.qrbox.sm{width:96px;height:96px;border-radius:10px}
.qrbox.lg{width:220px;height:220px;border-radius:18px}
/* ── หน้าตั้งค่า (08 10 11 12 13 14) ── */
.slay{display:grid;grid-template-columns:230px 1fr;gap:28px;align-items:start}
.snav{display:flex;flex-direction:column;gap:4px;position:sticky;top:0}
.snav div{height:44px;display:flex;align-items:center;padding:0 14px;border-radius:12px;font-size:14.5px;color:var(--ink2)}
.snav div.on{background:var(--ink);color:var(--sf);font-weight:700}
.scol2{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.scol{display:flex;flex-direction:column;gap:24px}
.sgc2{border:1px solid var(--line);border-radius:18px;background:var(--sf);padding:22px 24px;display:flex;flex-direction:column}
.sgc2 h3{font-size:16px;font-weight:700;display:flex;align-items:center;gap:9px;margin-bottom:6px}
.sgc2 h3 .n{width:26px;height:26px;border-radius:8px;background:var(--ink);color:var(--sf);display:grid;place-items:center;font-size:13px;flex:none}
.sgc2 h3 .sp{flex:1}
.sgc2 h3 small{font-size:12.5px;color:var(--mut);font-weight:400}
.sr{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--line);font-size:14.5px}
.sr:first-of-type{border-top:0}
.sr .l{flex:1;min-width:0}
.sr .l small{display:block;color:var(--mut);font-size:12.5px;line-height:1.45}
.sr .val{height:38px;min-width:92px;border:1px solid var(--line);border-radius:11px;display:flex;align-items:center;justify-content:center;gap:6px;font-weight:700;font-variant-numeric:tabular-nums;padding:0 12px;white-space:nowrap;font-size:14px}
.sr .val.sel::after{content:"";width:7px;height:7px;border-right:1.6px solid var(--mut);border-bottom:1.6px solid var(--mut);transform:rotate(45deg);margin:-3px 0 0 4px}
.sr .ch{font-size:11.5px;font-weight:700;color:var(--acc);background:var(--acc-bg);border-radius:6px;padding:2px 7px;white-space:nowrap}
.sr .lk{font-size:13px;color:var(--acc);font-weight:700;white-space:nowrap}
.sr.chg .l>b,.sr.chg .l>span{position:relative}
.rad{display:flex;flex-direction:column;gap:8px;padding:6px 0 10px}
.rad>div{display:flex;gap:12px;align-items:flex-start;border:1px solid var(--line);border-radius:14px;padding:11px 14px;font-size:14px}
.rad>div>i{width:18px;height:18px;border-radius:50%;border:2px solid var(--line2);flex:none;margin-top:2px}
.rad>div.on{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.rad>div.on>i{border:5px solid var(--ink)}
.rad>div>div{flex:1;min-width:0}
.rad small{display:block;color:var(--mut);font-size:12.5px;line-height:1.45}
.rad>div>.tg{margin-left:auto}
.tpl{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.tpl>div{border:1px solid var(--line);border-radius:18px;padding:16px 18px;display:flex;flex-direction:column;gap:6px}
.tpl>div.on{border:2px solid var(--ink)}
.tpl b{font-size:16px}
.tpl small{font-size:12.5px;color:var(--mut);line-height:1.5}
.tpl ul{list-style:none;font-size:13px;color:var(--ink2);line-height:1.7;margin-top:2px}
.bnr{display:flex;align-items:center;gap:14px;border-radius:16px;background:var(--acc-bg);color:var(--acc);padding:14px 18px;font-size:14px}
.bnr b{color:var(--acc)}
.bnr .sp{flex:1}
.mx{width:100%;border-collapse:collapse;font-size:14px}
.mx th{font-size:12.5px;color:var(--mut);font-weight:700;text-align:center;padding:10px 8px;border-bottom:1px solid var(--line);background:var(--sf2)}
.mx th:first-child{text-align:left}
.mx td{padding:11px 8px;border-bottom:1px solid var(--line);text-align:center}
.mx td:first-child{text-align:left}
.mx tr:last-child td{border-bottom:0}
.ck2{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:7px;background:var(--ink);color:var(--sf)}
.ck0{display:inline-block;width:22px;height:22px;border-radius:7px;border:1.5px solid var(--line2)}
</style>
