<style>
/* ══ CSS ร่วมของ "จองคิว + บัตรคิว V2" (ใช้ทุกจอ) — ห้ามเพิ่มสีนอกโทเคน ══ */
.rail{width:56px;flex:none;border-right:1px solid var(--line);background:var(--sf2);
  padding:10px 0;display:flex;flex-direction:column;align-items:center;gap:5px;color:var(--mut2)}
.rail .ri{width:36px;height:36px;border-radius:9px;display:grid;place-items:center}
.rail .ri.on{background:var(--sf);border:1px solid var(--line);color:var(--ink)}
.top .biz{display:inline-flex;align-items:center;gap:12px;height:32px;padding:0 10px;border:1px solid var(--line);
  border-radius:8px;font-size:13px;color:var(--ink2)}
.top .dot{width:8px;height:8px;border-radius:50%;background:var(--ink);display:inline-block}
.top .st{display:inline-flex;align-items:center;gap:13px;font-size:12.5px;color:var(--mut)}
.top .who{display:inline-flex;align-items:center;gap:13px;font-size:12.5px;color:var(--ink2)}
.amenu .am .pill{height:18px;min-width:18px;font-size:10.5px}
.ph .d{font-size:13px;color:var(--mut);margin-top:4px}
.split{display:flex;flex:1;min-height:0}
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.side{width:400px;flex:none;border-left:1px solid var(--line);background:var(--sf2);padding:24px;display:flex;flex-direction:column;gap:22px}
.side .card{padding:20px!important}
h3.h{font-size:15.5px;font-weight:700;display:flex;align-items:center;gap:8px;line-height:1.35}
h3.h .sp{flex:1}
.s2{font-size:13px;color:var(--mut);margin-top:4px;line-height:1.5}
.num{font-variant-numeric:tabular-nums}
/* ป้ายชนิดงาน: นัด = กรอบดำ · walk-in = พื้นเทา · กำลังทำ = ดำทึบ */
.tg{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:7px;font-size:12.5px;font-weight:700;white-space:nowrap}
.tg.p{border:1.5px solid var(--ink);color:var(--ink);background:var(--sf)}
.tg.a{background:var(--line2);color:var(--ink)}
.tg.now{background:var(--ink);color:var(--sf)}
.tg.acc{background:var(--acc-bg);color:var(--acc)}
.tg.dg{border:1.5px solid var(--dg);color:var(--dg);background:var(--sf)}
.tg.gh{border:1px solid var(--line);color:var(--mut);font-weight:600}
/* ── timeline แนวนอน (แถว = ช่าง) ── */
.tln{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--sf)}
.tln .hd,.tln .ln{display:grid;grid-template-columns:170px 1fr}
.tln .hd>div{background:var(--sf2);border-bottom:1px solid var(--line);font-size:12.5px;color:var(--mut);font-weight:700;padding:10px 14px}
.tln .hd .ax{position:relative;height:40px;padding:0}
.tln .hd .ax span{position:absolute;top:12px;transform:translateX(-50%);font-variant-numeric:tabular-nums}
.tln .ln{border-bottom:1px solid var(--line);min-height:92px}
.tln .ln:last-child{border-bottom:0}
.tln .who{padding:14px;display:flex;gap:10px;align-items:center;border-right:1px solid var(--line)}
.tln .who b{display:block;font-size:15px;line-height:1.25}
.tln .who small{display:block;color:var(--mut);font-size:12.5px;line-height:1.35}
.tln .tr{position:relative;background-image:linear-gradient(to right,var(--line) 1px,transparent 1px);background-size:20% 100%}
.tln .tr .off{position:absolute;top:0;bottom:0;background:repeating-linear-gradient(135deg,var(--sf2) 0 6px,var(--stage) 6px 12px)}
.jb{position:absolute;top:12px;bottom:12px;border-radius:12px;padding:7px 10px;font-size:12.5px;line-height:1.35;overflow:hidden;white-space:nowrap}
.jb b{display:block;font-size:13.5px}
.jb.p{border:1.5px solid var(--ink);background:var(--sf)}
.jb.pw{border:1.5px dashed var(--ink);background:var(--sf);color:var(--ink2)}
.jb.a{background:var(--line2)}
.jb.now{background:var(--ink);color:var(--sf)}
.jb.now small{color:var(--line2)}
.jb.ns{border:1.5px dashed var(--dg);color:var(--dg);background:var(--sf)}
.jb.plan{outline:2px solid var(--acc);outline-offset:1px}
.jb small{display:block;color:var(--mut);font-size:12px}
.nowl{position:absolute;top:0;bottom:0;width:2px;background:var(--acc);z-index:1}
.jb{z-index:2}
.nowl::before{content:attr(data-t);position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--acc);color:var(--sf);font-size:11.5px;font-weight:700;padding:1px 6px;border-radius:6px;white-space:nowrap}
/* ── แถวเดียว (รายการรอ) ── */
.q1{display:flex;flex-direction:column}
.q1 .it{display:grid;grid-template-columns:62px 1fr auto;gap:12px;align-items:center;padding:13px 0;border-top:1px solid var(--line)}
.q1 .it:first-child{border-top:0}
.q1 .t{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.2}
.q1 .t small{display:block;font-size:12px;font-weight:400;color:var(--mut)}
.q1 .m b{font-size:14.5px}
.q1 .m small{display:block;font-size:12.5px;color:var(--mut);line-height:1.45}
.q1 .it.ghost{opacity:.62}
.q1 .it.hl{background:var(--acc-bg);margin:0 -12px;padding:13px 12px;border-radius:12px;border-top-color:transparent}
.why{display:flex;gap:10px;padding:12px 14px;border-radius:14px;background:var(--acc-bg);color:var(--acc);font-size:13.5px;line-height:1.55}
.why svg{margin-top:3px}
.why.gh{background:var(--sf);border:1px solid var(--line);color:var(--ink2)}
.why.dg{background:var(--sf);border:1.5px solid var(--dg);color:var(--dg)}
.kv2{display:flex;flex-direction:column}
.kv2 .r{display:flex;align-items:baseline;gap:10px;padding:9px 0;border-top:1px solid var(--line);font-size:14px}
.kv2 .r:first-child{border-top:0}
.kv2 .r .sp{flex:1}
.kv2 .r .v{font-weight:700;font-variant-numeric:tabular-nums}
.kv2 .r .v.dg{color:var(--dg)}
.kv2 .r small{color:var(--mut);font-size:12.5px}
/* ── มือถือ ── */
.mrowx{display:flex;gap:44px;align-items:flex-start}
.mob .sb .ic{display:flex;gap:12px;align-items:center;font-size:12px}
.mob .sb .bat{width:22px;height:11px;border:1.5px solid var(--ink);border-radius:3px;position:relative}
.mob .sb .bat::after{content:"";position:absolute;inset:1.5px;right:5px;background:var(--ink);border-radius:1px}
.mob .mh .sp{flex:1}
.mob .mb{display:flex;flex-direction:column;gap:14px;padding-bottom:16px!important;flex:1 0 auto!important;overflow:visible!important}
.mob .ib{width:40px;height:40px;border:1px solid var(--line);border-radius:12px;display:grid;place-items:center;color:var(--ink2)}
.steps{display:flex;gap:6px}
.steps i{flex:1;height:4px;border-radius:2px;background:var(--line)}
.steps i.on{background:var(--ink)}
.fl{font-size:13.5px;font-weight:700;color:var(--ink2);margin-bottom:8px}
.opt{border:1px solid var(--line);border-radius:16px;padding:13px 15px;display:flex;align-items:center;gap:12px}
.opt b{display:block;font-size:15px}
.opt small{display:block;color:var(--mut);font-size:12.5px;line-height:1.45}
.opt .pr{margin-left:auto;text-align:right;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.opt .pr small{font-weight:400}
.opt.on{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips span{height:40px;padding:0 13px;border-radius:12px;border:1px solid var(--line);display:inline-flex;align-items:center;gap:6px;font-size:14px;color:var(--ink2)}
.chips span.on{background:var(--ink);border-color:var(--ink);color:var(--sf);font-weight:700}
.chips span.x{color:var(--mut2);text-decoration:line-through;background:var(--sf2)}
.slots{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.slots span{height:44px;border-radius:12px;border:1px solid var(--line);display:grid;place-items:center;font-size:14.5px;font-weight:600;font-variant-numeric:tabular-nums}
.slots span.on{background:var(--ink);color:var(--sf);border-color:var(--ink)}
.slots span.x{color:var(--mut2);background:var(--sf2);font-weight:400;text-decoration:line-through}
.cta{height:56px;border-radius:16px;background:var(--ink);color:var(--sf);display:flex;align-items:center;justify-content:center;gap:10px;font-size:17px;font-weight:700}
.cta.gh{background:var(--sf);color:var(--ink);border:1px solid var(--line)}
.sum{border:1px solid var(--line);border-radius:18px;padding:16px 18px}
.bubble{max-width:290px;border-radius:18px;padding:12px 14px;font-size:14px;line-height:1.55;background:var(--sf);border:1px solid var(--line)}
.bubble small{display:block;color:var(--mut);font-size:12px;margin-top:4px}
.bubble .bt{margin-top:10px;height:40px;border-radius:11px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--acc);font-size:14px}
.chat{background:var(--stage);flex:1;padding:16px;display:flex;flex-direction:column;gap:12px}
.chat .tm{font-size:11.5px;color:var(--mut);text-align:center}
.oa{display:flex;gap:8px;align-items:flex-end}
.oa .lg{width:32px;height:32px;border-radius:50%;background:var(--ink);color:var(--sf);display:grid;place-items:center;font-size:12px;font-weight:700;flex:none}
.qrbox{width:150px;height:150px;border-radius:14px;border:1px solid var(--line);background:#fff url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%22-2%20-2%2029%2029%22%20shape-rendering%3D%22crispEdges%22%3E%3Crect%20x%3D%22-2%22%20y%3D%22-2%22%20width%3D%2229%22%20height%3D%2229%22%20fill%3D%22%23fff%22/%3E%3Cg%20fill%3D%22%230a0a0a%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%224%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%225%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%226%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%228%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%229%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2210%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2211%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2212%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2214%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2215%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2218%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2219%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2221%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2222%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2223%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%2224%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x