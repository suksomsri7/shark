<style>
/* ══ รอบ 3 — "โปร่งขึ้นอีก + user friendly" (เจ้าของสั่ง 30 ก.ย. ค่ำ) ══
   หลัก: ตัวอักษรใหญ่ขึ้น 1 ขั้น · ปุ่ม/ช่องกด ≥44px · มุมมน 16px · ตัวเลขเงินเด่น · ช่องว่างเพิ่มอีก 20% · ไม่มีตัวอักษร < 12.5px */
body{font-size:15px!important}
.frame{border-radius:22px!important}
.wrap{gap:60px!important;padding:36px!important}
.pg{gap:34px!important;padding:0 36px 40px!important}
.ph{padding:18px 36px 24px!important}.ph h1{font-size:26px!important}
.row{gap:32px!important}
.card{padding:28px!important;border-radius:18px!important}
.card.p0{padding:0!important}
.pitem,.tbl-card,.ticket,.sysc,.oc,.mem,.pop{border-radius:18px!important}
.btn{height:46px!important;padding:0 20px!important;font-size:15px!important;border-radius:13px!important;gap:9px!important}
.btn.sm{height:40px!important;padding:0 14px!important;font-size:14px!important;border-radius:11px!important}
.inp{height:48px!important;font-size:15px!important;border-radius:13px!important;padding:0 16px!important}
.chip{height:28px!important;font-size:13px!important;padding:0 11px!important;border-radius:8px!important}
.top{height:66px!important}.top .brand{font-size:16px!important}
.amenu .am{font-size:15px!important;padding:18px 22px 16px!important;gap:9px!important}
.tabs{gap:8px!important}.tab{font-size:14.5px!important;padding:12px 18px!important}
.ddi{font-size:15px!important;height:48px!important}
.drawer{width:300px!important}
.crumb{font-size:13px!important}
.frame small,.frame .mu,.frame .fo,.frame .st,.frame .m,.frame .lbl{font-size:12.5px!important}
/* หน้าขาย */
.cats{gap:12px!important;padding:22px 30px 0!important}
.cats .c{height:44px!important;padding:0 20px!important;font-size:15px!important;border-radius:13px!important}
.pgrid{gap:22px!important;padding:24px 30px!important}
.pitem{padding:16px!important;min-height:170px!important}
.pitem .nm{font-size:16px!important}.pitem .pr{font-size:16px!important;margin-top:6px!important}
.cart{width:480px!important}
.cline{padding:18px 24px!important;gap:16px!important}
.cline .q{width:34px!important;height:34px!important;font-size:15px!important;border-radius:10px!important}
.cline .t b{font-size:16px!important}.cline .t span{font-size:13.5px!important;margin-top:4px!important}
.cline .a{font-size:16px!important}
.tot{padding:20px 24px!important;font-size:15px!important}.tot .r{padding:6px 0!important}.tot .r.g{font-size:26px!important;padding-top:12px!important}
.paybtn{height:72px!important;font-size:19px!important;border-radius:18px!important;margin:16px 24px 24px!important;padding:0 24px!important}
.mem{padding:14px 16px!important}
/* ชำระเงิน */
.big{font-size:56px!important}
.numpad{gap:14px!important}.numpad div{height:64px!important;font-size:21px!important;border-radius:14px!important}
.paym{gap:16px!important}.paym div{height:78px!important;font-size:15px!important;border-radius:16px!important;gap:6px!important}
.paym div small{font-size:12.5px!important}
.qr{width:170px!important;height:170px!important}
/* โต๊ะ / ครัว */
.tbl-card{padding:16px!important;min-height:132px!important}
.tbl-card .n{font-size:18px!important}.tbl-card .m{font-size:13px!important}
.ticket .h{font-size:14px!important;padding:14px 16px!important}
.ticket .l{font-size:15px!important;padding:14px 16px!important;gap:10px!important}
.ticket .l small{font-size:12.5px!important}
/* ตาราง / รายงาน / ตั้งค่า */
.tbl{font-size:14.5px!important}.tbl th{font-size:12.5px!important;padding:14px 16px!important}.tbl td{padding:18px 16px!important}
.kpi .lbl{font-size:13.5px!important}.kpi .val{font-size:30px!important;margin-top:12px!important}.kpi .fo{margin-top:10px!important}
.stat{gap:40px!important}.stat .b .k{font-size:13px!important}.stat .b .v{font-size:23px!important}
.sysc{padding:24px!important;gap:14px!important}
.sysc .h{font-size:16px!important}.sysc p,.sysc ul{font-size:13.5px!important;line-height:2!important}
.sw{width:42px!important;height:24px!important}.sw::after{width:18px!important;height:18px!important;top:3px!important;right:3px!important}.sw.off::after{left:3px!important}
.note{font-size:12.5px!important;padding:8px 12px!important;border-radius:10px!important}
.bar{height:150px!important;gap:8px!important}
/* มือถือ */
.mob{border-radius:34px!important}
.mob .sb{height:50px!important;font-size:14px!important}
.mob .mh h1{font-size:20px!important}
.mob .mb{padding:0 22px!important}
.mob .pgrid{gap:14px!important;padding:16px 0!important}
.mob .pitem{min-height:120px!important;padding:12px!important}
.mob .bb{padding:18px 22px 32px!important}
/* ใบเสร็จ */
.rcpt{font-size:13px!important;line-height:1.8!important;padding:26px 28px!important}
</style>
<style>
/* แก้จุดเฉพาะจอหลังขยาย (รอบ 3) */
.modal{height:auto!important;min-height:0!important;bottom:auto!important;top:56px!important}
.qrow{grid-template-columns:repeat(2,1fr)!important;gap:14px!important}
.pdr{width:430px!important}
.pdr .tabs{flex-wrap:wrap!important}.pdr .tab{padding:11px 12px!important;font-size:14px!important}
.chn{font-size:12.5px!important;height:24px!important;padding:0 8px!important;border-radius:7px!important;margin:2px 3px 2px 0!important}
.tbl td{padding:16px 12px!important}
.tbl td b{white-space:nowrap}
.pgrid{grid-template-columns:repeat(4,1fr)!important}
.pitem .nm{font-size:16px!important;line-height:1.35!important}
</style>
<style>
.frame:has(.modal){min-height:1040px!important}
.modal{top:40px!important}
.tbl td:has(.chn){min-width:150px!important;white-space:normal!important}
.tbl td:has(.chn) .chn{display:inline-flex!important}
.pdr .tabs{padding:0 6px!important;flex-wrap:nowrap!important}
.pdr .tab{padding:11px 8px!important;font-size:13.5px!important}
.pdr .tab .n{display:none}
</style>
<style>
.tbl td:has(.chn){min-width:118px!important}
.card.p0 .tbl td{padding:16px 9px!important}
.card.p0 .tbl{font-size:14px!important}
</style>
